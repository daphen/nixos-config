#!/usr/bin/env bash
# Deploy committed main to the Steam Deck: system closure and ~/nixos checkout from the same commit.
# Usage: machines/steamdeck/deploy [--adopt]   (--adopt: first deploy onto a Deck without a recorded revision)
set -euo pipefail

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
ssh_config=${DECK_SSH_CONFIG:-$HOME/.cache/steamdeck-install/ssh-config}
host=${DECK_HOST:-deck}
adopt=0
[[ ${1:-} == --adopt ]] && adopt=1

die() { printf 'deploy: %s\n' "$*" >&2; exit 1; }
# The ssh alias names one network; pick whichever known Deck address answers (office, home).
addr=${DECK_ADDR:-}
if [[ -z $addr ]]; then
    for candidate in 10.0.3.163 192.168.50.214; do
        ssh -F "$ssh_config" -oHostName="$candidate" -oConnectTimeout=4 -oControlMaster=no -oControlPath=none "$host" true 2>/dev/null && { addr=$candidate; break; }
    done
    [[ -n $addr ]] || die "Deck is not reachable at any known address"
fi
ssh_opts="-F $ssh_config -oHostName=$addr"
deck() { ssh $ssh_opts "$host" "$@"; }

cd "$repo"
[[ $(git branch --show-current) == main ]] || die "deploy only from main (on $(git branch --show-current))"
[[ -z $(git status --porcelain --untracked-files=no) ]] || die "commit tracked changes first: $(git status --porcelain --untracked-files=no | wc -l) files"
rev=$(git rev-parse HEAD)

deployed=$(deck 'nixos-version --json 2>/dev/null | jq -r ".configurationRevision // empty"' || true)
if [[ -z $deployed || $deployed == unknown ]]; then
    (( adopt )) || die "Deck has no recorded revision; rerun with --adopt for the first deploy"
elif [[ $deployed == *-dirty ]]; then
    (( adopt )) || die "Deck runs a dirty build ($deployed); rerun with --adopt to replace it"
else
    git cat-file -e "$deployed^{commit}" 2>/dev/null || die "Deck revision $deployed is not in this repo; fetch it first"
    git merge-base --is-ancestor "$deployed" "$rev" || die "Deck runs $deployed, which $rev does not contain; merge it into main first"
fi

printf 'deploy: building %s\n' "$rev"
system=$(nix build --no-link --print-out-paths "git+file://$repo?rev=$rev#nixosConfigurations.steamdeck.config.system.build.toplevel")
[[ $("$system/sw/bin/nixos-version" --json | jq -r .configurationRevision) == "$rev" ]] || die "built system does not record $rev"

printf 'deploy: copying %s\n' "$system"
NIX_SSHOPTS="$ssh_opts -oControlMaster=no -oControlPath=none -oCompression=yes" nix copy --no-check-sigs --to "ssh-ng://$host?remote-program=sudo%20-n%20nix-daemon" "$system"

printf 'deploy: checking out %s on the Deck\n' "$rev"
GIT_SSH_COMMAND="ssh $ssh_opts" git push --force "$host:nixos" "$rev:refs/deploy/current"
deck bash -s <<EOF
set -euo pipefail
cd ~/nixos
backup=\$HOME/.cache/steamdeck-update/pre-deploy-\$(date +%Y%m%d-%H%M%S)
mkdir -p "\$backup"
git diff --binary HEAD > "\$backup/tracked.patch"
git status --porcelain > "\$backup/status.txt"
git ls-files --others --exclude-standard -z | tar --null -T - -czf "\$backup/untracked.tar.gz"
git checkout --force --detach $rev
printf 'deploy: Deck checkout at %s, previous changes saved in %s\\n' "\$(git rev-parse --short HEAD)" "\$backup"
EOF

deck "bash ~/nixos/machines/steamdeck/activate $system"
[[ $(deck 'nixos-version --json | jq -r .configurationRevision') == "$rev" ]] || die "Deck did not switch to $rev"
printf 'deploy: Deck now runs %s\n' "$rev"
