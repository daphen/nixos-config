 const BUFFER_SIZE: usize = 16384;
 
+#[derive(Debug, Default)]
+struct TouchpadScrollState {
+    physical_contact: Option<u8>,
+    scrolling: bool,
+    scroll_position: Option<(u8, f64, f64)>,
+    remainder: (f64, f64),
+    haptic_position: Option<(u8, f64, f64)>,
+    haptic_pressed: bool,
+    haptic_active: bool,
+    last_haptic: Option<Instant>,
+}
+
+impl TouchpadScrollState {
+    fn clear_scroll(&mut self) {
+        self.scroll_position = None;
+        self.remainder = (0.0, 0.0);
+    }
+
+    fn reset(&mut self) {
+        *self = Self::default();
+    }
+
+    fn route_to_scroll(&mut self, value: &InputValue, modifier_active: bool) -> bool {
+        let InputValue::Touch {
+            index, is_touching, ..
+        } = value
+        else {
+            self.reset();
+            return false;
+        };
+        if *is_touching && self.physical_contact != Some(*index) {
+            self.scrolling = modifier_active;
+            self.clear_scroll();
+        }
+        let route_to_scroll = self.scrolling;
+        self.physical_contact = is_touching.then_some(*index);
+        if !is_touching {
+            self.scrolling = false;
+        }
+        route_to_scroll
+    }
+
+    fn desktop_haptic(&mut self, event: &NativeEvent) -> Option<CommandType> {
+        match (event.as_capability(), event.get_value()) {
+            (
+                Capability::Touchpad(Touchpad::RightPad(Touch::Motion)),
+                InputValue::Touch {
+                    index,
+                    is_touching,
+                    x,
+                    y,
+                    ..
+                },
+            ) => {
+                if !is_touching {
+                    self.haptic_position = None;
+                    self.last_haptic = None;
+                    return self.haptic_active.then(|| {
+                        self.haptic_active = false;
+                        CommandType::Off
+                    });
+                }
+                let (Some(x), Some(y)) = (x, y) else {
+                    return None;
+                };
+                let now = Instant::now();
+                let Some((previous_index, previous_x, previous_y)) = self.haptic_position else {
+                    self.haptic_position = Some((index, x, y));
+                    self.last_haptic = Some(now);
+                    return None;
+                };
+                self.haptic_position = Some((index, x, y));
+                if index != previous_index || (x == previous_x && y == previous_y) {
+                    return None;
+                }
+                if self
+                    .last_haptic
+                    .is_some_and(|last| now.duration_since(last) < Duration::from_millis(50))
+                {
+                    return None;
+                }
+                self.last_haptic = Some(now);
+                self.haptic_active = true;
+                Some(CommandType::Tick)
+            }
+            (
+                Capability::Touchpad(Touchpad::RightPad(Touch::Button(TouchButton::Press))),
+                InputValue::Bool(pressed),
+            ) => {
+                let changed = pressed != self.haptic_pressed;
+                self.haptic_pressed = pressed;
+                if !changed {
+                    return None;
+                }
+                self.haptic_active = pressed;
+                Some(if pressed {
+                    CommandType::Click
+                } else {
+                    CommandType::Off
+                })
+            }
+            _ => None,
+        }
+    }
+
+    fn translate(&mut self, value: InputValue, speed: f64) -> InputValue {
+        let InputValue::Touch {
+            index,
+            is_touching,
+            x: Some(x),
+            y: Some(y),
+            ..
+        } = value
+        else {
+            self.clear_scroll();
+            return InputValue::None;
+        };
+        if !is_touching {
+            self.clear_scroll();
+            return InputValue::None;
+        }
+        let Some((previous_index, previous_x, previous_y)) = self.scroll_position else {
+            self.scroll_position = Some((index, x, y));
+            return InputValue::None;
+        };
+        self.scroll_position = Some((index, x, y));
+        if index != previous_index {
+            self.remainder = (0.0, 0.0);
+            return InputValue::None;
+        }
+
+        let horizontal = (x - previous_x) * speed + self.remainder.0;
+        let vertical = (previous_y - y) * speed + self.remainder.1;
+        let x_steps = horizontal.trunc();
+        let y_steps = vertical.trunc();
+        self.remainder = (horizontal - x_steps, vertical - y_steps);
+        InputValue::Vector2 {
+            x: (x_steps != 0.0).then_some(x_steps),
+            y: (y_steps != 0.0).then_some(y_steps),
+        }
+    }
+}
+
+fn translate_desktop_pads(
+    event: &NativeEvent,
+    mappings: &HashMap<Capability, Vec<ProfileMapping>>,
+    active_inputs: &[Capability],
+    state: &mut TouchpadScrollState,
+) -> Option<Vec<NativeEvent>> {
+    let right_motion = Capability::Touchpad(Touchpad::RightPad(Touch::Motion));
+    let scroll_mapping = mappings.get(&right_motion)?.iter().find(|mapping| {
+        mapping
+            .target_events
+            .iter()
+            .any(|target| Capability::from(target.clone()) == Capability::Mouse(Mouse::Wheel))
+    })?;
+    let source_cap = event.as_capability();
+    let center = |touch| Capability::Touchpad(Touchpad::CenterPad(touch));
+
+    if source_cap == right_motion {
+        let value = event.get_value();
+        let scroll_active = active_inputs.contains(&Capability::Keyboard(Keyboard::KeyLeftMeta));
+        if !state.route_to_scroll(&value, scroll_active) {
+            return Some(vec![NativeEvent::new_translated(
+                source_cap,
+                center(Touch::Motion),
+                value,
+            )]);
+        }
+        if !scroll_active {
+            state.clear_scroll();
+            return Some(Vec::new());
+        }
+
+        let speed = scroll_mapping
+            .source_event
+            .touchpad
+            .as_ref()
+            .and_then(|touchpad| touchpad.touch.motion.as_ref())
+            .and_then(|motion| motion.speed_pps)
+            .unwrap_or(24) as f64;
+        let value = state.translate(value, speed);
+        if matches!(value, InputValue::None) {
+            return Some(Vec::new());
+        }
+        return Some(vec![NativeEvent::new_translated(
+            source_cap,
+            Capability::Mouse(Mouse::Wheel),
+            value,
+        )]);
+    }
+
+    match source_cap {
+        Capability::Touchpad(Touchpad::LeftPad(Touch::Button(TouchButton::Press)))
+        | Capability::Touchpad(Touchpad::RightPad(Touch::Button(TouchButton::Press))) => {
+            Some(vec![NativeEvent::new_translated(
+                source_cap,
+                center(Touch::Button(TouchButton::Press)),
+                event.get_value(),
+            )])
+        }
+        Capability::Touchpad(Touchpad::LeftPad(Touch::Button(TouchButton::Touch)))
+        | Capability::Touchpad(Touchpad::RightPad(Touch::Button(TouchButton::Touch)))
+        | Capability::Gamepad(Gamepad::Trigger(GamepadTrigger::LeftTouchpadForce))
+        | Capability::Gamepad(Gamepad::Trigger(GamepadTrigger::RightTouchpadForce)) => {
+            Some(Vec::new())
+        }
+        _ => None,
+    }
+}
