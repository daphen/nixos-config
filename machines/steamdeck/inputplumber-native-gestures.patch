+    fn translate_touch_motion_to_button(
+        &self,
+        source_config: &CapabilityConfig,
+    ) -> Result<InputValue, TranslationError> {
+        let motion = source_config
+            .touchpad
+            .as_ref()
+            .and_then(|touchpad| touchpad.touch.motion.as_ref())
+            .ok_or_else(|| {
+                TranslationError::InvalidSourceConfig(
+                    "No touchpad motion config to translate touch motion".to_string(),
+                )
+            })?;
+        let region = motion.region.as_ref().ok_or_else(|| {
+            TranslationError::InvalidSourceConfig(
+                "No region defined to translate touch motion".to_string(),
+            )
+        })?;
+        let InputValue::Touch {
+            is_touching, x, y, ..
+        } = self
+        else {
+            return Err(TranslationError::ImpossibleTranslation(
+                "Only touch values can be translated from touch motion".to_string(),
+            ));
+        };
+        if !is_touching {
+            return Ok(InputValue::Bool(false));
+        }
+        let (Some(x), Some(y)) = (x, y) else {
+            return Ok(InputValue::Bool(false));
+        };
+        let pressed = match region.as_str() {
+            "left" => *x <= 0.35,
+            "right" => *x >= 0.65,
+            "top" => *y <= 0.35,
+            "bottom" => *y >= 0.65,
+            _ => {
+                return Err(TranslationError::InvalidSourceConfig(format!(
+                    "Invalid touchpad region: {region}"
+                )))
+            }
+        };
+        Ok(InputValue::Bool(pressed))
+    }
