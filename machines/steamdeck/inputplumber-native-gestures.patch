+    async fn flush_events(
+        client: &CompositeDeviceClient,
+        native: &mut mpsc::Receiver<NativeEvent>,
+        steam: &mut mpsc::Receiver<NativeEvent>,
+    ) -> (Vec<NativeEvent>, Vec<NativeEvent>) {
+        let marker = Capability::Gamepad(Gamepad::Button(GamepadButton::Guide));
+        client
+            .write_event(NativeEvent::new(marker.clone(), InputValue::Bool(true)))
+            .await
+            .unwrap();
+        let mut steam_received = Vec::new();
+        loop {
+            let event = tokio::time::timeout(Duration::from_secs(2), steam.recv())
+                .await
+                .unwrap()
+                .unwrap();
+            if event.as_capability() == marker {
+                break;
+            }
+            steam_received.push(event);
+        }
+        client.get_target_capabilities().await.unwrap();
+        let mut native_received = Vec::new();
+        while let Ok(event) = native.try_recv() {
+            native_received.push(event);
+        }
+        (native_received, steam_received)
+    }
+
+    fn drain_haptics(source: &mut mpsc::Receiver<SourceCommand>) -> Vec<CommandType> {
+        let mut commands = Vec::new();
+        while let Ok(command) = source.try_recv() {
+            if let SourceCommand::WriteEvent(OutputEvent::SteamDeckHaptics(report)) = command {
+                assert_eq!(report.side, PadSide::Right);
+                commands.push(report.cmd_type);
+            }
+        }
+        commands
+    }
