+    #[test]
+    fn left_pad_regions_press_change_release_and_contact_end() {
+        let profile = profile(
+            r#"
+version: 1
+kind: DeviceProfile
+name: test
+mapping:
+  - name: left
+    source_event: { touchpad: { name: LeftPad, touch: { motion: { region: left } } } }
+    target_events: [ { keyboard: KeyF17 } ]
+  - name: bottom
+    source_event: { touchpad: { name: LeftPad, touch: { motion: { region: bottom } } } }
+    target_events: [ { keyboard: KeyF18 } ]
+  - name: top
+    source_event: { touchpad: { name: LeftPad, touch: { motion: { region: top } } } }
+    target_events: [ { keyboard: KeyF19 } ]
+  - name: right
+    source_event: { touchpad: { name: LeftPad, touch: { motion: { region: right } } } }
+    target_events: [ { keyboard: KeyF20 } ]
+"#,
+        );
+        let source = Capability::Touchpad(Touchpad::LeftPad(Touch::Motion));
+        let states = |value: InputValue| {
+            profile
+                .mapping
+                .iter()
+                .map(|mapping| {
+                    let target = Capability::from(mapping.target_events[0].clone());
+                    let translated = value
+                        .translate(
+                            &source,
+                            &mapping.source_event,
+                            &target,
+                            &mapping.target_events[0],
+                        )
+                        .unwrap();
+                    (target, translated.pressed())
+                })
+                .collect::<HashMap<_, _>>()
+        };
+
+        let left = states(touch(0.1, 0.5, true));
+        assert_eq!(left[&Capability::Keyboard(Keyboard::KeyF17)], true);
+        assert_eq!(left[&Capability::Keyboard(Keyboard::KeyF19)], false);
+        let top = states(touch(0.5, 0.1, true));
+        assert_eq!(top[&Capability::Keyboard(Keyboard::KeyF17)], false);
+        assert_eq!(top[&Capability::Keyboard(Keyboard::KeyF19)], true);
+        assert!(states(touch(0.5, 0.5, true))
+            .values()
+            .all(|pressed| !pressed));
+        assert!(states(touch(0.5, 0.5, false))
+            .values()
+            .all(|pressed| !pressed));
+    }
