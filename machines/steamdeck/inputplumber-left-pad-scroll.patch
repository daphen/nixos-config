+            NativeEvent::new(
+                Capability::Touchpad(Touchpad::LeftPad(Touch::Motion)),
+                touch(x, y, touching),
+            )
+        };
+        for event in [left(0.5, 0.5, true), left(0.625, 0.5, true), left(0.625, 0.375, true), left(0.375, 0.375, true)] {
