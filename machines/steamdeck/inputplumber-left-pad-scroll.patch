+    #[tokio::test]
+    async fn left_pad_scrolls_both_axes_when_mapped_to_the_wheel() {
+        let (client, mut native_events, mut steam_events, _source_events, _run) =
+            composite_fixture(true, true).await;
+        let profile = r#"
+version: 1
+kind: DeviceProfile
+name: canvas
+mapping:
+  - name: Left pad scroll
+    source_event: { touchpad: { name: LeftPad, touch: { motion: { speed_pps: 40 } } } }
+    target_events: [ { mouse: { wheel: {} } } ]
+"#;
+        client.load_profile_from_yaml(profile.to_string()).await.unwrap();
+        let left = |x, y, touching| {
+            NativeEvent::new(
+                Capability::Touchpad(Touchpad::LeftPad(Touch::Motion)),
+                touch(x, y, touching),
+            )
+        };
+        for event in [left(0.5, 0.5, true), left(0.625, 0.5, true), left(0.625, 0.375, true), left(0.375, 0.375, true)] {
+            client.handle_event(event).await.unwrap();
+        }
+        let (native, steam) = flush_events(&client, &mut native_events, &mut steam_events).await;
+        assert!(steam.is_empty());
+        let wheel: Vec<_> = native
+            .iter()
+            .map(|event| format!("{:?} {:?}", event.as_capability(), event.get_value()))
+            .collect();
+        let expected = |x: Option<f64>, y: Option<f64>| {
+            format!("{:?} {:?}", Capability::Mouse(Mouse::Wheel), InputValue::Vector2 { x, y })
+        };
+        assert_eq!(
