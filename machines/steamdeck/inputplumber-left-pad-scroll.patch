+version: 1
+kind: DeviceProfile
+name: canvas
+mapping:
+  - name: Left pad scroll
+    source_event: { touchpad: { name: LeftPad, touch: { motion: { speed_pps: 40 } } } }
+    target_events: [ { mouse: { wheel: {} } } ]
+"#;
