+fn wheel_speed(mappings: &HashMap<Capability, Vec<ProfileMapping>>, pad: &Capability) -> Option<f64> {
+    let mapping = mappings.get(pad)?.iter().find(|mapping| {
+        mapping
+            .target_events
+            .iter()
+            .any(|target| Capability::from(target.clone()) == Capability::Mouse(Mouse::Wheel))
+    })?;
+    Some(
+        mapping
+            .source_event
+            .touchpad
+            .as_ref()
+            .and_then(|touchpad| touchpad.touch.motion.as_ref())
+            .and_then(|motion| motion.speed_pps)
+            .unwrap_or(24) as f64,
+    )
+}
+
+fn wheel_event(source_cap: Capability, value: InputValue) -> Vec<NativeEvent> {
+    if matches!(value, InputValue::None | InputValue::Vector2 { x: None, y: None }) {
+        return Vec::new();
+    }
+    vec![NativeEvent::new_translated(
+        source_cap,
+        Capability::Mouse(Mouse::Wheel),
+        value,
+    )]
+}
