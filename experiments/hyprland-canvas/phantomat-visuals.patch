+static float canvasReveal(PHLMONITORREF monitor) {
+    const float amount = std::clamp((1.F - canvasZoom(monitor)) / 0.25F, 0.F, 1.F);
+    return amount * amount * (3.F - 2.F * amount);
+}
+
+class CCanvasChromeElement : public IPassElement {
+  public:
+    CCanvasChromeElement(PHLMONITOR monitor, bool foreground) : m_monitor(monitor), m_foreground(foreground) {}
+    bool needsLiveBlur() override {
+        return false;
+    }
+    bool needsPrecomputeBlur() override {
+        return false;
+    }
+    const char* passName() override {
+        return "CCanvasChromeElement";
+    }
+    ePassElementType type() override {
+        return EK_CUSTOM;
+    }
