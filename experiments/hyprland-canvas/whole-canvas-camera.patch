+struct SCanvasBackdropFrame {
+    SP<IFramebuffer> destination;
+    bool             refresh;
+    Time::steady_tp  time;
+};
+
+static bool prepareCanvasBackdrop(PHLMONITOR monitor) {
+    auto& resources = *monitor->resources();
+    const auto destination = g_pHyprRenderer->m_renderData.currentFB;
+    for (auto* cache : {&resources.m_canvasBackdropSharp, &resources.m_canvasBackdropBlur}) {
+        if (!*cache)
+            *cache = g_pHyprRenderer->createFB("Canvas backdrop");
+        if (!(*cache)->isAllocated() || (*cache)->m_size != destination->m_size || (*cache)->m_drmFormat != destination->m_drmFormat) {
+            if (!(*cache)->alloc(destination->m_size.x, destination->m_size.y, destination->m_drmFormat))
+                return false;
+            resources.m_canvasBackdropDirty = true;
+        }
+        (*cache)->setImageDescription(destination->imageDescription());
+    }
+    static uint64_t config = 0;
+    static auto onConfig = Event::bus()->m_events.config.props_refreshed.listen([](const bool) { ++config; });
+    std::vector<std::tuple<const void*, CBox, float>> state = {
+        {monitor->m_background.get(), {}, monitor->m_backgroundOpacity->value()}, {monitor->m_splash.get(), {}, 1.F}};
+    for (const auto& layer : monitor->m_layerSurfaceLayers[ZWLR_LAYER_SHELL_V1_LAYER_BACKGROUND]) {
+        if (layer)
+            state.emplace_back(layer.get(), layer->geometricBox(IGeometric::GEOMETRIC_CURRENT), layer->mapped() ? layer->alpha()[LS_ALPHA_FADE]->value() : 0.F);
+    }
+    for (const auto& fadeout : Desktop::fadingOutState()->fadeouts()) {
+        if (fadeout && fadeout->monitor() == monitor && fadeout->plane() == Desktop::FADEOUT_PLANE_LAYER_BACKGROUND)
+            state.emplace_back(fadeout.get(), fadeout->renderBox(), fadeout->alpha());
+    }
+    if (state != resources.m_canvasBackdropState || config != resources.m_canvasBackdropConfig || sc<int>(monitor->m_transform) != resources.m_canvasBackdropTransform) {
+        resources.m_canvasBackdropDirty = true;
+        resources.m_canvasBackdropState = std::move(state);
+        resources.m_canvasBackdropConfig = config;
+        resources.m_canvasBackdropTransform = sc<int>(monitor->m_transform);
+    }
+    return true;
+}
+
+class CCanvasBackdropElement : public IPassElement {
+  public:
+    CCanvasBackdropElement(PHLMONITOR monitor, SP<SCanvasBackdropFrame> frame, bool begin) : m_monitor(monitor), m_frame(frame), m_begin(begin) {}
+    bool needsLiveBlur() override { return false; }
+    bool needsPrecomputeBlur() override { return false; }
+    bool disableSimplification() override { return true; }
+    bool requiresFullDamage() override { return true; }
+    const char* passName() override { return "CCanvasBackdropElement"; }
+    ePassElementType type() override { return EK_CUSTOM; }
+
+    std::vector<UP<IPassElement>> draw() override {
+        const auto monitor = m_monitor.lock();
+        auto& renderer = g_pHyprRenderer;
+        auto& resources = *monitor->resources();
+        const CBox screen{{}, monitor->m_transformedSize};
+        const CRegion fullDamage{screen};
+        if (m_begin) {
+            m_frame->destination = renderer->m_renderData.currentFB;
+            if (m_frame->refresh) {
+                renderer->bindFB(resources.m_canvasBackdropSharp);
+                renderer->draw(CClearPassElement::SClearData{CHyprColor{0.F, 0.F, 0.F, 1.F}}, fullDamage);
+            }
+            return {};
+        }
+        renderer->bindFB(m_frame->destination);
+        static auto blurStrength = CConfigValue<Config::FLOAT>("experimental:canvas_backdrop_blur");
+        static auto backgroundColor = CConfigValue<Config::INTEGER>("misc:background_color");
+        static auto blurVariant = CConfigValue<Config::INTEGER>("decoration:blur:variant");
+        const bool precompose = (sc<uint32_t>(*backgroundColor) >> 24) == 0xff && *blurVariant == 0;
+        const auto progress = canvasReveal(monitor);
+        if (m_frame->refresh)
+            resources.m_canvasBackdropBlurStrength = -1.F;
+        if (*blurStrength > 0.F && progress > 0.F && (resources.m_canvasBackdropBlurStrength != *blurStrength || renderer->blurProviderIsAnimated())) {
+            auto restoreFramebuffer = renderer->bindTempFB(m_frame->destination);
+            auto source = resources.m_canvasBackdropSharp;
+            const int iterations = 1 + sc<int>(std::round(*blurStrength * 3.F));
+            for (int i = 0; i < iterations; ++i) {
+                const auto blurred = renderer->blurFramebuffer(source, 1.F, fullDamage);
+                if (!blurred || !blurred->getTexture())
+                    return {};
+                auto bindBackdrop = renderer->bindTempFB(resources.m_canvasBackdropBlur);
+                renderer->draw(CClearPassElement::SClearData{CHyprColor{0.F, 0.F, 0.F, 0.F}}, fullDamage);
+                renderer->draw(CTexPassElement::SRenderData{.tex = blurred->getTexture(), .box = screen, .damage = fullDamage}, fullDamage);
+                source = resources.m_canvasBackdropBlur;
+            }
+            resources.m_canvasBackdropBlurStrength = *blurStrength;
+            if (renderer->blurProviderIsAnimated())
+                renderer->scheduleFrameForAnimatedBlur(fullDamage, false);
+        }
+        resources.m_canvasBackdropDirty = false;
+        static auto strength = CConfigValue<Config::FLOAT>("experimental:canvas_parallax_strength");
+        static auto depth = CConfigValue<Config::FLOAT>("experimental:canvas_parallax_depth");
+        const auto zoom = canvasZoom(monitor);
+        const auto offset = (monitor->canvasOffset() - monitor->m_size * (1.0 - zoom) / 2.0) * monitor->m_scale * (*strength * progress);
+        const auto scale = std::max(0.3, 1.0 + (std::pow(zoom, *depth) - 1.0) * progress);
+        const auto tile = screen.size() * scale;
+        const auto origin = (screen.size() - tile) / 2.0 + offset;
+        const int i0 = sc<int>(std::floor(-origin.x / tile.x)), i1 = sc<int>(std::ceil((screen.w - origin.x) / tile.x)) - 1;
+        const int j0 = sc<int>(std::floor(-origin.y / tile.y)), j1 = sc<int>(std::ceil((screen.h - origin.y) / tile.y)) - 1;
+        auto& data = renderer->m_renderData;
+        const auto  sharpTexture = resources.m_canvasBackdropSharp->getTexture();
+        const auto  blurTexture  = resources.m_canvasBackdropBlur->getTexture();
+        const auto  description  = m_frame->destination->imageDescription();
+        const bool  composite    = precompose && *blurStrength > 0.F && progress > 0.F;
+        const bool  fuse         = *blurStrength > 0.F && progress > 0.F && (!composite || progress < 1.F) && (sc<uint32_t>(*backgroundColor) >> 24) == 0xff && *blurVariant == 0 &&
+            !data.currentWindow && data.clipBox.empty() && (!data.renderModif.enabled || data.renderModif.modifs.empty()) && sharpTexture->m_size == screen.size() &&
+            blurTexture->m_size == screen.size() && sharpTexture->m_transform == HYPRUTILS_TRANSFORM_NORMAL && blurTexture->m_transform == HYPRUTILS_TRANSFORM_NORMAL &&
+            description && sharpTexture->m_imageDescription && blurTexture->m_imageDescription && !sharpTexture->m_imageDescription->needsCM(description) &&
+            !blurTexture->m_imageDescription->needsCM(description);
+        std::vector<SMeshRenderVertex> backdropMesh;
+        if (fuse)
+            backdropMesh.reserve(384);
+        const auto oldTL = data.primarySurfaceUVTopLeft, oldBR = data.primarySurfaceUVBottomRight;
+        CScopeGuard restoreUV([&] { data.primarySurfaceUVTopLeft = oldTL; data.primarySurfaceUVBottomRight = oldBR; });
+        for (int j = j0; j <= j1 && j - j0 < 8; ++j) {
+            for (int i = i0; i <= i1 && i - i0 < 8; ++i) {
+                const double x0 = std::round(origin.x + i * tile.x), x1 = std::round(origin.x + (i + 1) * tile.x);
+                const double y0 = std::round(origin.y + j * tile.y), y1 = std::round(origin.y + (j + 1) * tile.y);
+                const bool flipX = (i % 2 + 2) % 2 == 1, flipY = (j % 2 + 2) % 2 == 1;
+                data.primarySurfaceUVTopLeft = {flipX ? 1.0 : 0.0, flipY ? 1.0 : 0.0};
+                data.primarySurfaceUVBottomRight = {flipX ? 0.0 : 1.0, flipY ? 0.0 : 1.0};
+                const CBox box{x0, y0, x1 - x0, y1 - y0};
+                if (fuse) {
+                    const float left = x0 / screen.w, right = x1 / screen.w, top = y0 / screen.h, bottom = y1 / screen.h;
+                    const float u0 = data.primarySurfaceUVTopLeft.x, v0 = data.primarySurfaceUVTopLeft.y;
+                    const float u1 = data.primarySurfaceUVBottomRight.x, v1 = data.primarySurfaceUVBottomRight.y;
+                    backdropMesh.insert(backdropMesh.end(),
+                                        {
+                                            {left, top, u0, v0},
+                                            {left, bottom, u0, v1},
+                                            {right, top, u1, v0},
+                                            {right, top, u1, v0},
+                                            {left, bottom, u0, v1},
+                                            {right, bottom, u1, v1},
+                                        });
+                    continue;
+                }
+                if (!composite || progress < 1.F)
+                    renderer->draw(CTexPassElement::SRenderData{.tex = resources.m_canvasBackdropSharp->getTexture(), .box = box, .damage = fullDamage,
+                                                             .allowCustomUV = true}, fullDamage);
+                if (*blurStrength > 0.F && progress > 0.F)
+                    renderer->draw(CTexPassElement::SRenderData{.tex = resources.m_canvasBackdropBlur->getTexture(), .box = box,
+                                                             .a = composite ? progress : *blurStrength * progress, .damage = fullDamage,
+                                                             .allowCustomUV = true}, fullDamage);
+            }
+        }
+        if (fuse) {
+            auto& gl = GL::g_pHyprOpenGL;
+            gl->setActiveTexture(GL_TEXTURE0 + 1);
+            sharpTexture->bind();
+            sharpTexture->setTexParameter(GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            sharpTexture->setTexParameter(GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            sharpTexture->setTexParameter(GL_TEXTURE_MIN_FILTER, data.useNearestNeighbor ? GL_NEAREST : sharpTexture->minFilter);
+            sharpTexture->setTexParameter(GL_TEXTURE_MAG_FILTER, data.useNearestNeighbor ? GL_NEAREST : sharpTexture->magFilter);
+            gl->renderTextureMesh(blurTexture, screen, backdropMesh,
+                                  {
+                                      .blur           = true,
+                                      .forceBlurBlend = true,
+                                      .blurredBG      = sharpTexture,
+                                      .damage         = &fullDamage,
+                                      .a              = std::clamp(composite ? progress : *blurStrength * progress, 0.F, 1.F),
+                                  });
+            gl->setActiveTexture(GL_TEXTURE0 + 1);
+            sharpTexture->unbind();
+            gl->setActiveTexture(GL_TEXTURE0);
+            blurTexture->unbind();
+            gl->scissor(nullptr);
+        }
+        if (!m_frame->refresh && !renderer->m_bBlockSurfaceFeedback) {
+            for (const auto& layer : monitor->m_layerSurfaceLayers[ZWLR_LAYER_SHELL_V1_LAYER_BACKGROUND]) {
+                if (layer && layer->mapped() && layer->acceptsInput() && layer->alphaNonZero())
+                    layer->wlSurface()->resource()->breadthfirst([&](SP<CWLSurfaceResource> surface, const Vector2D&, void*) {
+                        surface->presentFeedback(m_frame->time, monitor);
+                    }, nullptr);
+            }
+        }
+        return {};
+    }
+  private:
+    PHLMONITORREF m_monitor;
+    SP<SCanvasBackdropFrame> m_frame;
+    bool m_begin;
+};
+
+class CCanvasChromeElement : public IPassElement {
+  public:
+    CCanvasChromeElement(PHLMONITOR monitor, bool foreground) : m_monitor(monitor), m_foreground(foreground) {}
+    bool needsLiveBlur() override {
+        return false;
+    }
+    bool needsPrecomputeBlur() override {
+        return false;
+    }
+    const char* passName() override {
+        return "CCanvasChromeElement";
+    }
+    ePassElementType type() override {
+        return EK_CUSTOM;
+    }
+    std::optional<CBox> boundingBox() override {
+        return CBox{{}, m_monitor->m_size};
+    }
+    CRegion opaqueRegion() override {
+        return {};
+    }
+
+    std::vector<UP<IPassElement>> draw() override {
+        const auto monitor = m_monitor.lock();
+        if (!monitor)
+            return {};
+        static auto gridOpacity  = CConfigValue<Config::FLOAT>("experimental:canvas_grid_opacity");
+        static auto gridSpacing  = CConfigValue<Config::FLOAT>("experimental:canvas_grid_spacing");
+        static auto backdropDim  = CConfigValue<Config::FLOAT>("experimental:canvas_backdrop_dim");
+        static auto panelOpacity = CConfigValue<Config::FLOAT>("experimental:canvas_panel_opacity");
+        const float reveal       = canvasReveal(monitor);
+        if (reveal <= 0.F)
+            return {};
+        const auto size = monitor->m_size * monitor->m_scale;
+        const CBox screen{{}, size};
+        const auto damage = g_pHyprRenderer->m_renderData.damage;
+        if (!m_foreground) {
+            g_pHyprRenderer->draw(CRectPassElement::SRectData{.box = screen, .color = CHyprColor{0.015F, 0.02F, 0.035F, *backdropDim * reveal}}, damage);
+            const double cell    = *gridSpacing * canvasZoom(monitor) * monitor->m_scale;
+            const double minimum = 24.0 * monitor->m_scale;
+            const double                           t      = std::clamp((cell / minimum - 1.0) * 2.0, 0.0, 1.0);
+            const double                           fine   = std::round(t * t * (3.0 - 2.0 * t) * 32.0) / 32.0;
+            const int                              pixels = std::max(2, sc<int>(std::round(cell * 2.0)));
+            const double                           radius = std::max(1.5, 1.4 * monitor->m_scale);
+            static std::tuple<int, double, double> tileKey;
+            static SP<ITexture>                    tile;
+            const auto                             key = std::tuple{pixels, fine, radius};
+            if (!tile || key != tileKey) {
+                auto surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, pixels, pixels);
+                auto cr      = cairo_create(surface);
+                for (int row = 0; row < 2; ++row) {
+                    for (int col = 0; col < 2; ++col) {
+                        cairo_set_source_rgba(cr, 0.75, 0.8, 0.9, row == 0 && col == 0 ? 1.0 : fine);
+                        cairo_arc(cr, (col + 0.5) * pixels / 2.0, (row + 0.5) * pixels / 2.0, radius, 0, 2.0 * M_PI);
+                        cairo_fill(cr);
+                    }
+                }
+                cairo_surface_flush(surface);
+                tile    = g_pHyprRenderer->createTexture(surface);
+                tileKey = key;
+                cairo_destroy(cr);
+                cairo_surface_destroy(surface);
+            }
+            auto&       data  = g_pHyprRenderer->m_renderData;
+            const auto  oldTL = data.primarySurfaceUVTopLeft;
+            const auto  oldBR = data.primarySurfaceUVBottomRight;
+            CScopeGuard restoreUV([&] {
+                data.primarySurfaceUVTopLeft     = oldTL;
+                data.primarySurfaceUVBottomRight = oldBR;
+            });
+            const auto  origin               = monitor->canvasOffset() * monitor->m_scale;
+            data.primarySurfaceUVTopLeft     = (Vector2D{cell * 0.5, cell * 0.5} - origin) / (cell * 2.0);
+            data.primarySurfaceUVBottomRight = data.primarySurfaceUVTopLeft + size / (cell * 2.0);
+            g_pHyprRenderer->draw(CTexPassElement::SRenderData{.tex = tile, .box = screen, .a = *gridOpacity * reveal, .allowCustomUV = true, .wrapX = WRAP_REPEAT, .wrapY = WRAP_REPEAT},
+                                  damage);
+            return {};
+        }
+        const auto       selected = monitor->canvasNearest(true);
+        const double     unit     = monitor->m_scale;
+        const double     margin   = 24.0 * unit;
+        const auto                                     label    = std::format("CANVAS  /  {}", selected ? selected->metadata().title() : "");
+        const auto                                     labelKey = std::tuple{label, unit, size.x};
+        static std::tuple<std::string, double, double> previousLabel;
+        static SP<ITexture>                            labelTexture;
+        if (!labelTexture || previousLabel != labelKey) {
+            labelTexture  = g_pHyprRenderer->renderText(label, CHyprColor{0.9F, 0.92F, 0.96F, 1.F}, sc<int>(13 * unit), false, "monospace", sc<int>(size.x * 0.5), 500);
+            previousLabel = labelKey;
+        }
+        if (labelTexture) {
+            const Vector2D labelPosition{margin + 14.0 * unit, margin + 10.0 * unit - (1.0 - reveal) * 12.0 * unit};
+            g_pHyprRenderer->draw(CRectPassElement::SRectData{.box   = {labelPosition - Vector2D{14.0, 10.0} * unit, labelTexture->m_size + Vector2D{28.0, 20.0} * unit},
+                                                              .color = CHyprColor{0.025F, 0.03F, 0.045F, *panelOpacity * reveal},
+                                                              .round = sc<int>(8 * unit)},
+                                  damage);
+            g_pHyprRenderer->draw(CTexPassElement::SRenderData{.tex = labelTexture, .box = {labelPosition, labelTexture->m_size}, .a = reveal}, damage);
+        }
+        return {};
+    }
+
+  private:
+    PHLMONITORREF m_monitor;
+    bool          m_foreground;
+};
