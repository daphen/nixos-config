+static std::optional<CScopeGuard> canvasFloatingPass(PHLMONITOR monitor, bool floating) {
+    if (!floating)
+        return {};
+    g_pHyprRenderer->currentPass().add(makeUnique<CRendererHintsPassElement>(CRendererHintsPassElement::SData{SRenderModifData{}}));
+    return std::optional<CScopeGuard>{std::in_place, [monitor] {
+        SRenderModifData modifs;
+        modifs.modifs.emplace_back(SRenderModifData::RMOD_TYPE_TRANSLATE, monitor->canvasOffset() * monitor->m_scale / canvasZoom(monitor));
+        modifs.modifs.emplace_back(SRenderModifData::RMOD_TYPE_SCALE, canvasZoom(monitor));
+        g_pHyprRenderer->currentPass().add(makeUnique<CRendererHintsPassElement>(CRendererHintsPassElement::SData{modifs}));
+    }};
+}
