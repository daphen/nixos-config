+        static auto blurStart        = CConfigValue<Config::FLOAT>("experimental:canvas_edge_blur_start");
+        static auto chromatic        = CConfigValue<Config::FLOAT>("experimental:canvas_chromatic");
+        static auto vignette         = CConfigValue<Config::FLOAT>("experimental:canvas_vignette");
+        shader->setUniformFloat(SHADER_DISTORT, CanvasProjection::strength() * m_progress);
+        shader->setUniformFloat(SHADER_CONTRAST, 1.F + (CanvasProjection::edgeScale() - 1.F) * m_progress);
+        shader->setUniformFloat(SHADER_BRIGHTNESS, *feather * m_progress);
+        glUniform2f(glGetUniformLocation(shader->program(), "fullSize"), m_frame->world->m_size.x, m_frame->world->m_size.y);
+        glUniform1f(glGetUniformLocation(shader->program(), "edgeBlur"), *blur * m_progress);
+        glUniform1f(glGetUniformLocation(shader->program(), "edgeBlurStart"), *blurStart);
+        glUniform1f(glGetUniformLocation(shader->program(), "chromatic"), *chromatic * m_progress);
+        glUniform1f(glGetUniformLocation(shader->program(), "vignette"), *vignette * m_progress);
+        glBindVertexArray(shader->getUniformLocation(SHADER_SHADER_VAO));
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glBindVertexArray(0);
+        texture->unbind();
+        gl->blend(blend);
+        m_frame->world->setImageDescription(m_frame->description);
+        return {};
+    }
+
+  private:
+    SP<SCanvasLensFrame> m_frame;
+    float                m_progress;
+    bool                 m_begin;
+};
