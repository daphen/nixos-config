+bool CMonitor::canvasEnabled() const {
+    const auto space     = m_activeWorkspace ? m_activeWorkspace->space() : nullptr;
+    const auto algorithm = space ? space->algorithm() : nullptr;
+    return !m_activeSpecialWorkspace && algorithm && algorithm->tiledAlgo() &&
+        Layout::Supplementary::algoMatcher()->getNameForTiledAlgo(algorithm->tiledAlgo().get()) == "lua:canvas";
+}
+
+bool CMonitor::canvasTransformed() const {
+    return canvasEnabled() && (m_canvasOverview || m_canvasZoom->value() != 1.F || canvasOffset() != Vector2D{});
+}
+
+Vector2D CMonitor::canvasOffset() const {
+    const Vector2D offset = {m_canvasX->value(), m_canvasY->value()};
+    if (m_canvasZoom->value() != 1.F || m_canvasZoom->isBeingAnimated() || m_canvasX->isBeingAnimated() || m_canvasY->isBeingAnimated())
+        return offset;
+    return (offset * m_scale).round() / m_scale;
+}
+
+PHLWINDOW CMonitor::canvasNearest(bool target) const {
+    PHLWINDOW  nearest;
+    double     best   = std::numeric_limits<double>::max();
+    const auto zoom   = target ? m_canvasZoom->goal() : m_canvasZoom->value();
+    const auto offset = target ? Vector2D{m_canvasX->goal(), m_canvasY->goal()} : canvasOffset();
+    for (const auto& window : Desktop::windowState()->windows()) {
+        if (!validMapped(window) || window->isHidden() || window->m_workspace != m_activeWorkspace || window->isFloating() || window->backend().traits().overrideRedirect)
+            continue;
+        const auto box      = window->geometricBox(target ? IGeometric::GEOMETRIC_GOAL : IGeometric::GEOMETRIC_CURRENT);
+        const auto distance = ((box.middle() - m_position) * zoom + offset).distanceSq(m_size / 2.0);
+        if (distance < best) {
+            best    = distance;
+            nearest = window;
+        }
+    }
+    return nearest;
+}
+
+void CMonitor::canvasOverview() {
+    if (!canvasEnabled())
+        return;
+    if (m_canvasOverview) {
+        m_canvasPanning = true;
+        canvasFinish();
+        return;
+    }
+    CBox bounds;
+    bool first = true;
+    for (const auto& window : Desktop::windowState()->windows()) {
+        if (!validMapped(window) || window->isHidden() || window->m_workspace != m_activeWorkspace || window->isFloating())
+            continue;
+        const auto box    = window->geometricBox(IGeometric::GEOMETRIC_GOAL);
+        const auto left   = first ? box.x : std::min(bounds.x, box.x);
+        const auto top    = first ? box.y : std::min(bounds.y, box.y);
+        const auto right  = first ? box.x + box.w : std::max(bounds.x + bounds.w, box.x + box.w);
+        const auto bottom = first ? box.y + box.h : std::max(bounds.y + bounds.h, box.y + box.h);
+        bounds            = {left, top, right - left, bottom - top};
+        first             = false;
+    }
+    if (first)
+        return;
+    const auto  area   = m_activeWorkspace->space()->workArea();
+    const float zoom   = std::clamp(std::min(area.w / (bounds.w + 96.0), area.h / (bounds.h + 96.0)), 0.25, 1.0);
+    const auto  offset = area.middle() - m_position - (bounds.middle() - m_position) * zoom;
+    m_canvasOverview   = true;
+    m_canvasPanning    = true;
+    m_canvasCommitting = false;
+    *m_canvasZoom      = zoom;
+    *m_canvasX         = offset.x;
+    *m_canvasY         = offset.y;
+    canvasCenter(Desktop::focusState()->window());
+    g_pHyprRenderer->damageMonitor(m_self.lock());
+}
+
+void CMonitor::canvasPan(const Vector2D& delta) {
+    if (!canvasEnabled())
+        return;
+    if (m_canvasCommitting)
+        m_canvasOverview = false;
+    if (!m_canvasOverview && !m_canvasPanning)
+        canvasOverview();
+    m_canvasPanning = true;
+    Animation::mgr()->requestTick();
+    m_canvasCommitting = false;
+    *m_canvasX         = m_canvasX->goal() - delta.x * m_canvasZoom->goal();
+    *m_canvasY         = m_canvasY->goal() - delta.y * m_canvasZoom->goal();
+    if (delta != Vector2D{}) {
+        if (const auto window = canvasNearest(true)) {
+            const auto offset = (window->geometricBox(IGeometric::GEOMETRIC_GOAL).middle() - m_position) * m_canvasZoom->goal() +
+                Vector2D{m_canvasX->goal(), m_canvasY->goal()} - m_size / 2.0;
+            const auto radius = std::min(m_size.x, m_size.y) * 0.3;
+            const auto weight = std::max(0.0, 1.0 - offset.size() / radius);
+            const auto pull   = offset * std::min(0.015 * weight, delta.size() * m_canvasZoom->goal() * (m_canvasOverview ? 0.15 : 0.05) / std::max(1.0, offset.size()));
+            *m_canvasX        = m_canvasX->goal() - pull.x;
+            *m_canvasY        = m_canvasY->goal() - pull.y;
+        }
+    }
+}
+
+void CMonitor::canvasCenter(PHLWINDOW window) {
+    if (!canvasEnabled() || !validMapped(window) || window->m_workspace != m_activeWorkspace || window->isFloating())
+        return;
+    const auto area =
+        Fullscreen::controller()->getFullscreenModes(window).client == Fullscreen::FSMODE_FULLSCREEN ? CBox{m_position, m_size} : m_activeWorkspace->space()->workArea();
+    const auto offset = area.middle() - m_position - (window->geometricBox(IGeometric::GEOMETRIC_GOAL).middle() - m_position) * m_canvasZoom->goal();
+    *m_canvasX        = offset.x;
+    *m_canvasY        = offset.y;
+}
+
+static void preserveCanvasPosition(CMonitor& monitor, PHLWINDOW window, const Vector2D& position) {
+    const auto shift = window->isFloating() ? Vector2D{} : window->positionAnimation()->goal() - position;
+    for (const auto& target : Desktop::windowState()->windows()) {
+        if (validMapped(target) && target->m_workspace == monitor.m_activeWorkspace && !target->isFloating())
+            target->positionAnimation()->setValue(target->positionAnimation()->value() + shift);
+    }
+    monitor.m_canvasX->setValueAndWarp(monitor.m_canvasX->value() - shift.x * monitor.m_canvasZoom->value());
+    monitor.m_canvasY->setValueAndWarp(monitor.m_canvasY->value() - shift.y * monitor.m_canvasZoom->value());
+}
+
+void CMonitor::canvasDirection(char direction) {
+    if (!canvasEnabled())
+        return;
+    const auto source = m_canvasOverview ? canvasNearest(true) : Desktop::focusState()->window();
+    if (!source)
+        return;
+    const auto position = source->positionAnimation()->value();
+    const bool overview = m_canvasOverview;
+    if (overview)
+        canvasPan({});
+    Desktop::focusState()->rawWindowFocus(source, Desktop::FOCUS_REASON_KEYBIND);
+    m_activeWorkspace->space()->layoutMsg(std::format("focus {}", direction));
+    if (overview)
+        preserveCanvasPosition(*this, source, position);
+    canvasCenter(Desktop::focusState()->window());
+}
+
+void CMonitor::canvasFinish(bool cancel) {
+    if (!m_canvasPanning)
+        return;
+    m_canvasPanning    = false;
+    m_canvasCommitting = !cancel;
+    if (cancel) {
+        m_canvasZoom->setValueAndWarp(m_canvasZoom->value());
+        m_canvasX->setValueAndWarp(m_canvasX->value());
+        m_canvasY->setValueAndWarp(m_canvasY->value());
+    } else if (const auto window = canvasNearest(true)) {
+        const auto position = window->positionAnimation()->value();
+        const auto focused = Desktop::focusState()->window();
+        if (!focused || !focused->isFloating())
+            Desktop::focusState()->rawWindowFocus(window, Desktop::FOCUS_REASON_KEYBIND);
+        preserveCanvasPosition(*this, window, position);
+        *m_canvasZoom = 1.F;
+        canvasCenter(window);
+    } else {
+        m_canvasOverview   = false;
+        m_canvasCommitting = false;
+    }
+    g_pHyprRenderer->damageMonitor(m_self.lock());
+}
+
+void CMonitor::canvasTick(float) {
+    if (!canvasEnabled() || g_pSessionLockManager->isSessionLocked()) {
+        m_canvasOverview   = false;
+        m_canvasPanning    = false;
+        m_canvasCommitting = false;
+        m_canvasZoom->setValueAndWarp(1.F);
+        m_canvasX->setValueAndWarp(0.F);
+        m_canvasY->setValueAndWarp(0.F);
+        return;
+    }
+    if (m_canvasCommitting) {
+        canvasCenter(Desktop::focusState()->window());
+        Animation::mgr()->requestTick();
+    }
+    if (m_canvasCommitting && !m_canvasZoom->isBeingAnimated() && !m_canvasX->isBeingAnimated() && !m_canvasY->isBeingAnimated()) {
+        m_canvasCommitting = false;
+        m_canvasOverview   = false;
+        g_pHyprRenderer->damageMonitor(m_self.lock());
+    }
+}
