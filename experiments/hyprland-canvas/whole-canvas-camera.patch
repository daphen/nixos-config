+void CWindowEffectsController::prepareResize() {
+    const auto monitor = m_window.m_monitor.lock();
+    if (!monitor || !monitor->canvasEnabled() || !m_window.mapped() || m_window.backend().isX11() || m_window.isFloating() ||
+        Fullscreen::controller()->isFullscreen(m_window.m_self.lock()) ||
+        m_window.presentation().animatingIn() || !m_window.sizeAnimation()->enabled() ||
+        (g_layoutManager->dragController()->target() && g_layoutManager->dragController()->mode() == MBIND_RESIZE)) {
+        if (auto resize = m_transformers->get<Render::CResizeTransformer>())
+            resize->reset();
+        return;
+    }
+
+    m_transformers->removeInactive();
+    auto resize = m_transformers->get<Render::CResizeTransformer>();
+    if (!resize && m_window.sizeAnimation()->value() != m_window.sizeAnimation()->goal())
+        resize = m_transformers->emplace<Render::CResizeTransformer>(m_window.m_self);
+    if (resize)
+        resize->prepare();
+}
+
+void CWindowEffectsController::onResizeCommit() {
+    if (auto resize = m_transformers->get<Render::CResizeTransformer>())
+        resize->onCommit();
+}
+
+bool CWindowEffectsController::resizeActive() const {
+    const auto resize = m_transformers->get<Render::CResizeTransformer>();
+    return resize && resize->active();
+}
