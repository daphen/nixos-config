+static void canvasMotionConfig(CMonitor& monitor, const std::string& name) {
+    const auto config = Config::animationTree()->getAnimationPropertyConfig(name);
+    for (const auto animation : {monitor.m_canvasX.get(), monitor.m_canvasY.get()}) {
+        const auto previous = animation->getConfig().lock();
+        if (previous == config)
+            continue;
+        const auto goal = animation->goal();
+        if (previous->pValues.lock() != config->pValues.lock())
+            animation->setValueAndWarp(animation->value());
+        animation->setConfig(config);
+        *animation = goal;
+    }
+}
