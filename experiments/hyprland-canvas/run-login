#!/usr/bin/env bash
set -euo pipefail

readonly LAUNCHER="$(basename -- "${BASH_SOURCE[0]}")"
readonly ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
readonly REPO_ROOT="$(readlink -f -- "$ROOT/../..")"
readonly HYPR_CONFIG_ROOT="$REPO_ROOT/dotfiles/hyprland/.config/hypr"
readonly CONFIG="$HYPR_CONFIG_ROOT/hyprland.lua"
if [[ $LAUNCHER == hypr-real || ${1:-} == --real ]]; then
  readonly REAL_MODE=1
  readonly LOG=/tmp/hyprland-canvas-real.log
else
  readonly REAL_MODE=0
  readonly LOG=/tmp/hyprland-canvas-login.log
fi
readonly GPU_LINK=/dev/dri/by-path/pci-0000:65:00.0-card
readonly PACKAGE_LINK="$HOME/.cache/hyprland-canvas-package"
readonly CANVAS_BIN="$HOME/.cache/hyprland-canvas-bin"
readonly DEV_PACKAGE="${HYPRLAND_CANVAS_DEV_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/hyprland-canvas-dev}/validated"
if [[ ${1:-} == --stable ]]; then
  readonly DEV_MODE=0
else
  readonly DEV_MODE=1
fi

if [[ -n ${WAYLAND_DISPLAY:-} || ! -t 0 || $(tty) != /dev/tty* ]]; then
  printf 'Run this from a Linux TTY, not from the graphical session.\n' >&2
  exit 1
fi

if [[ -z ${XDG_SESSION_ID:-} ]] ||
   [[ $(loginctl show-session "$XDG_SESSION_ID" -p Type --value) != tty ]]; then
  printf 'An active logind TTY session is required.\n' >&2
  exit 1
fi

if ! systemctl --user is-active --quiet niri.service; then
  printf 'niri.service must be active before the handoff.\n' >&2
  exit 1
fi

if [[ ! -e $GPU_LINK ]]; then
  printf 'Expected AMD card is missing: %s\n' "$GPU_LINK" >&2
  exit 1
fi
gpu="$(readlink -f -- "$GPU_LINK")"

if (( REAL_MODE )); then
  mkdir -p "$CANVAS_BIN"
  (cd "$REPO_ROOT/pkgs/desktopctl" && go build -o "$CANVAS_BIN/desktopctl" .)
fi

runtime_path=()

if (( DEV_MODE )); then
  if [[ ! -x $DEV_PACKAGE/bin/Hyprland || ! -x $DEV_PACKAGE/bin/start-hyprland ]]; then
    printf 'No validated dev package. Run: %s/dev build\n' "$ROOT" >&2
    exit 1
  fi
  printf 'Using the explicitly selected validated dev canvas.\n'
  package="$DEV_PACKAGE"
elif [[ -x $PACKAGE_LINK/bin/start-hyprland ]]; then
  printf 'Using the prebuilt pinned canvas.\n'
  package="$(readlink -f -- "$PACKAGE_LINK")"
else
  printf 'Building the pinned canvas before stopping Niri...\n'
  package="$(cd "$REPO_ROOT" && nice -n 15 ionice -c3 nix build --cores 2 --max-jobs 1 \
    --no-write-lock-file path:./experiments/hyprland-canvas --no-link --print-out-paths | tail -n 1)"
fi

guiutils="$(cd "$REPO_ROOT" && nice -n 15 ionice -c3 nix build --cores 2 --max-jobs 1 \
  --no-write-lock-file path:./experiments/hyprland-canvas#guiutils --no-link --print-out-paths | tail -n 1)"
runtime_path+=("$guiutils/bin")

restore_niri() {
  printf '\nRestoring Niri...\n'
  systemctl --user start niri.service
}
trap restore_niri EXIT

printf 'Stopping Niri and starting the real-seat canvas. Alt+Escape exits.\n'
"$HYPR_CONFIG_ROOT/scripts/quickshell-session-stop" --any-display
systemctl --user stop niri.service
pkill -TERM -f "$HOME/.config/niri/scripts/start-session-apps" 2>/dev/null || true
unset WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE
export AQ_DRM_DEVICES="$gpu"
export PATH="$CANVAS_BIN:$package/bin${runtime_path:+:$(IFS=:; printf '%s' "${runtime_path[*]}")}:$PATH"
export HYPR_CANVAS_REAL="$REAL_MODE"
export HYPR_SCRIPTS="$HYPR_CONFIG_ROOT/scripts/"

while true; do
  status=0
  if (( DEV_MODE )); then
    "$package/bin/start-hyprland" --path "$package/bin/Hyprland" -- --config "$CONFIG" 2>&1 | tee "$LOG" || status=$?
  else
    "$package/bin/start-hyprland" -- --config "$CONFIG" 2>&1 | tee "$LOG" || status=$?
  fi

  if (( status != 0 )); then
    exit "$status"
  fi

  printf '\nRestart Hyprland? [Y/n] '
  if ! read -r answer || [[ ${answer,,} == n || ${answer,,} == no ]]; then
    break
  fi
done
