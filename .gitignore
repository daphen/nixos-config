# Nix build results
result
result-*

# Flake lock might be committed, but can be regenerated
# Uncomment if you don't want to commit it:
# flake.lock

# Dotfiles source (this is a symlink to your actual dotfiles)
dotfiles-source/

# Hardware config (machine-specific, should be generated per-machine)
# Comment this out if you want to commit your hardware-configuration.nix
# hardware-configuration.nix

# Editor files
.vscode/
.idea/
# Anchored to repo root: ignore ~/nixos/.claude (agent state for this repo)
# but NOT dotfiles/claude/.claude, whose themes ship with #dev-env.
/.claude/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Local testing
test-vm/
secrets.nix

# codex-managed system skills, dropped into the symlinked skills dir
dotfiles/ai/skills/.system/
