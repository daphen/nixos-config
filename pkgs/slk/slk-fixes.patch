+	if c.wsConn == nil {
+		return fmt.Errorf("websocket not connected")
+	}
+	msg := map[string]interface{}{
+		"type": "presence_query",
+		"ids":  userIDs,
+	}
+	return c.wsConn.WriteJSON(msg)
