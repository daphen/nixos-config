/* Generated by ~/.config/themes — do not edit by hand.
   Source: ~/.config/themes/templates/review.template

   Palette for the review-pr skill's local HTML review page. Bundles both
   palettes; the skill sets `html.theme-<mode>` from ~/.config/theme_mode so
   the page matches the desktop theme at render time. prefers-color-scheme is
   a fallback used only when no explicit class is present (so an OS dark
   preference still themes a page opened without the class). */

:root {
  --rv-bg:      {{light.background.primary}};
  --rv-surface: {{light.background.surface}};
  --rv-alt:     {{light.background.secondary}};
  --rv-fg:      {{light.foreground.primary}};
  --rv-muted:   {{light.foreground.muted}};
  --rv-hair:    {{light.background.overlay}};
  --rv-red:     {{light.accent.red}};
  --rv-orange:  {{light.accent.orange}};
  --rv-yellow:  {{light.accent.yellow}};
  --rv-green:   {{light.accent.green}};
  --rv-blue:    {{light.accent.blue}};
  --rv-purple:  {{light.accent.purple}};
  --rv-cursor:  {{light.semantic.cursor}};
  --rv-code-bg: {{light.background.secondary}};
  --rv-code-fg: {{light.foreground.primary}};
}

html.theme-dark {
  --rv-bg:      {{dark.background.primary}};
  --rv-surface: {{dark.background.surface}};
  --rv-alt:     {{dark.background.secondary}};
  --rv-fg:      {{dark.foreground.primary}};
  --rv-muted:   {{dark.foreground.muted}};
  --rv-hair:    {{dark.background.overlay}};
  --rv-red:     {{dark.accent.red}};
  --rv-orange:  {{dark.accent.orange}};
  --rv-yellow:  {{dark.accent.yellow}};
  --rv-green:   {{dark.accent.green}};
  --rv-blue:    {{dark.accent.blue}};
  --rv-purple:  {{dark.accent.purple}};
  --rv-cursor:  {{dark.semantic.cursor}};
  --rv-code-bg: {{dark.background.secondary}};
  --rv-code-fg: {{dark.foreground.primary}};
}

@media (prefers-color-scheme: dark) {
  :root:not(.theme-dark):not(.theme-light) {
    --rv-bg:      {{dark.background.primary}};
    --rv-surface: {{dark.background.surface}};
    --rv-alt:     {{dark.background.secondary}};
    --rv-fg:      {{dark.foreground.primary}};
    --rv-muted:   {{dark.foreground.muted}};
    --rv-hair:    {{dark.background.overlay}};
    --rv-red:     {{dark.accent.red}};
    --rv-orange:  {{dark.accent.orange}};
    --rv-yellow:  {{dark.accent.yellow}};
    --rv-green:   {{dark.accent.green}};
    --rv-blue:    {{dark.accent.blue}};
    --rv-purple:  {{dark.accent.purple}};
    --rv-cursor:  {{dark.semantic.cursor}};
    --rv-code-bg: {{dark.background.secondary}};
    --rv-code-fg: {{dark.foreground.primary}};
  }
}
