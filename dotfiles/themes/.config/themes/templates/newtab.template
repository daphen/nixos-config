/* AUTO-GENERATED from themes/colors.json (newtab.template) — do not edit here. */
:root {
  --bg: {{light.background.dim}};
  --card-bg: {{light.background.primary}};
  --surface: {{light.background.surface}};
  --surface0: {{light.background.surface0}};
  --muted: {{light.background.overlay}};
  --fg: {{light.foreground.primary}};
  --fg-muted: {{light.foreground.secondary}};
  --accent: {{light.semantic.cursor}};
  --accent-electric: {{light.accent.electric}};
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: {{dark.background.dim}};
    --card-bg: {{dark.background.primary}};
    --surface: {{dark.background.surface}};
    --surface0: {{dark.background.surface0}};
    --muted: {{dark.background.overlay}};
    --fg: {{dark.foreground.primary}};
    --fg-muted: {{dark.foreground.secondary}};
    --accent: {{dark.semantic.cursor}};
    --accent-electric: {{dark.accent.electric}};
  }
}
