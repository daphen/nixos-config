# imv config — managed in nixos/dotfiles, symlinked to ~/.config/imv by symlinks.nix.
# imv loads exactly one config (suppress_default_binds = true), so this carries the
# full bind set copied from imv's bundled default; the only change from upstream is
# that +/- take larger zoom steps (Up/Down/i/o stay fine-grained).

[options]
suppress_default_binds = true

[binds]
q = quit

# Image navigation
<Left> = prev
<bracketleft> = prev
<Right> = next
<bracketright> = next
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0

# Zooming — +/- jump in big steps; Up/Down/i/o keep the fine-grained step
<Shift+plus> = zoom 5
<minus> = zoom -5
<Up> = zoom 1
i = zoom 1
<Down> = zoom -1
o = zoom -1

# Rotate clockwise by 90 degrees
<Ctrl+r> = rotate by 90

# Other commands
x = close
f = fullscreen
d = overlay
p = exec echo $imv_current_file
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
r = reset

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1
