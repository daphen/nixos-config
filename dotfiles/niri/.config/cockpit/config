# shellcheck shell=bash
# Instance config for the cockpit engine (cockpit-open / -add / -switch).
#
# The engine knows nothing below this line: swap this file and the same three
# scripts drive a completely different setup.

COCKPIT_WORKSPACE=lovable
# Spawn order = column order: devenv | (browser, slotted in by post_open) |
# agent | nvim.
COCKPIT_WINDOWS=(devenv agent nvim)
COCKPIT_STATE_DIR="$HOME/.local/state/cockpit"

_repo="$HOME/work/lovable"

# Lovbox contexts: a context whose tabs live in a REMOTE sandbox (via
# lovssh) instead of a local worktree. names.json (ws-createlovbox /
# lov-name) maps claim → human label; label == context name marks it.
# A local worktree of the same name wins — remote is the fallback shape.
_lovbox_claim() {
    [ -d "$HOME/work/lovable.daphen-$1" ] && return 0
    jq -r --arg n "$1" 'to_entries[] | select(.value == $n) | .key' \
        "$HOME/.local/state/lovssh/names.json" 2>/dev/null | tail -1
}

# Lovbox-on-Lovable contexts: a lovbox context that ALSO has a lovc project
# driving the production agent. cockpit-add-lol writes "<project-id>\t<claim>"
# to $COCKPIT_STATE_DIR/lol/<name>. Agent tab runs lovc against the project;
# nvim/devenv lovssh into the same sandbox for hands-on monorepo work.
_lol_project() {
    local f="${COCKPIT_STATE_DIR:-$HOME/.local/state/cockpit}/lol/$1"
    [ -f "$f" ] || return 1
    cut -f1 "$f"
}

cockpit_context_dir() {
    local claim
    # "main" is the primary checkout, not a worktree.
    if [ "$1" = main ]; then
        printf '%s/work/lovable' "$HOME"
    elif _lol_project "$1" >/dev/null || { claim=$(_lovbox_claim "$1") && [ -n "$claim" ]; }; then
        printf '%s' "$HOME"   # tabs are remote; cwd is irrelevant
    else
        printf '%s/work/lovable.daphen-%s' "$HOME" "$1"
    fi
}

cockpit_context_create() {
    local dir
    # LoL + lovbox contexts are provisioned by their own add scripts, not wt.
    _lol_project "$1" >/dev/null && return 0
    [ -n "$(_lovbox_claim "$1")" ] && return 0
    dir=$(cockpit_context_dir "$1")
    if [ ! -d "$dir" ]; then
        # Off fresh origin/main, never the local ref — a stale main births
        # worktrees missing generated files.
        git -C "$_repo" fetch origin main
        ( cd "$_repo" && wt switch --create --base origin/main "daphen/$1" )
    fi
    zoxide add "$dir" >/dev/null 2>&1 || true
}

# The transcript with the most recent CONVERSATION, not the most recently
# touched file. mtime lies: resuming a session bumps its mtime without adding
# any content, so after a crash/restore cycle `ls -t` can rank a stale session
# above the one holding your latest turn. Rank by each transcript's last record
# timestamp instead. Still skip aborted/empty sessions (no user message).
_resume_flag() {
    local proj f id ts best_id best_ts=""
    proj="$HOME/.claude/projects/${1//[.\/]/-}"
    [ -d "$proj" ] || return 0
    for f in "$proj"/*.jsonl; do
        [ -f "$f" ] || continue
        head -c 65536 "$f" | grep -q '"type":"user"' || continue
        ts=$(grep -oE '"timestamp":"[^"]+"' "$f" 2>/dev/null | tail -1 | cut -d'"' -f4)
        [ -n "$ts" ] || continue
        if [ -z "$best_ts" ] || [[ "$ts" > "$best_ts" ]]; then
            best_ts=$ts
            best_id=$(basename "$f" .jsonl)
        fi
    done
    [ -n "${best_id:-}" ] && printf ' --resume %s' "$best_id"
    return 0
}

cockpit_window_cmd() {
    local window=$1 name=$2 dir=$3 claim
    # LoL context: windows keep their local meaning. Agent window = a coding
    # agent (here: SSH into the sandbox, run claude), nvim window = editor
    # (SSH, run nvim) — both lovssh into the SAME sandbox for hands-on
    # monorepo work. Devenv window = the build driver, which for LoL is the
    # production Lovable agent via lovc. One project, one sandbox.
    local pid
    if pid=$(_lol_project "$name"); then
        claim=$(_lovbox_claim "$name")
        case "$window" in
            agent)  printf 'fish -c "echo \\"[cockpit] after landing: claude (~/lovable)\\"; lovssh %s"; exec fish' "$claim" ;;
            nvim)   printf 'fish -c "echo \\"[cockpit] after landing: nvim (~/lovable)\\"; lovssh %s"; exec fish' "$claim" ;;
            devenv) printf 'fish -c "lovc chat %s"; exec fish' "$pid" ;;
            *)      printf 'fish -c "lovssh %s"; exec fish' "$claim" ;;
        esac
        return 0
    fi

    # Lovbox context: every tab lands in the sandbox via lovssh (a fish
    # function; it execs the remote dev-env, so claude/nvim are typed after
    # landing — lovssh can't chain a remote command). Drop to local fish on
    # disconnect so the tab survives for a reconnect.
    if claim=$(_lovbox_claim "$name") && [ -n "$claim" ]; then
        case "$window" in
            agent)  printf 'fish -c "echo \\"[cockpit] after landing: claude\\"; lovssh %s"; exec fish' "$claim" ;;
            nvim)   printf 'fish -c "echo \\"[cockpit] after landing: nvim\\"; lovssh %s"; exec fish' "$claim" ;;
            *)      printf 'fish -c "echo \\"[cockpit] remote shell\\"; lovssh %s"; exec fish' "$claim" ;;
        esac
        return 0
    fi
    case "$window" in
        # FORCE_SESSION_PERSISTENCE: launched from inside a claude session the
        # child inherits CLAUDE_CODE_CHILD_SESSION and silently stops saving
        # its transcript, so the session can't be resumed after a crash.
        agent)
            printf 'env CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 claude%s; exec fish' \
                "$(_resume_flag "$dir")" ;;
        # Session file per context so a crash/reboot restores layout+files;
        # plugin/cockpit-session.lua autosaves it while nvim runs.
        nvim)
            local sess="${COCKPIT_STATE_DIR:-$HOME/.local/state/cockpit}/nvim/${name}.vim"
            if [ -f "$sess" ]; then
                printf 'COCKPIT_NVIM_SESSION=%q direnv exec . nvim -S %q; exec fish' "$sess" "$sess"
            else
                printf 'COCKPIT_NVIM_SESSION=%q direnv exec . nvim; exec fish' "$sess"
            fi ;;
        # main runs the shared deps singleton (wt-proxy caddy, nats, …);
        # worktrees run their own wt slice on top of it. The retry loop keeps
        # a cold-boot failure VISIBLE in the tab instead of silently dropping
        # to a shell (bit us on the first cockpit-restore after a reboot).
        devenv)
            local sub="wt"
            [ "$name" = main ] && sub="deps"
            printf 'while true; do direnv exec . devenv %s; echo; echo "[cockpit] devenv %s exited ($?) — enter to restart, ctrl-c for a shell"; read -r || break; done; exec fish' \
                "$sub" "$sub" ;;
        *)      printf 'exec fish' ;;
    esac
}

# The cockpit's fourth window: a work-profile browser on the workspace.
# Nothing else respawns it after a reboot (browser-work only focuses), so
# cockpit-open's hook owns it. Spawns land on the focused workspace, which
# cockpit-open has already ensured is ours.
cockpit_post_open() {
    niri msg --json windows | jq -e \
        --argjson ws "$(niri msg --json workspaces | jq '[.[] | select(.name=="'"$COCKPIT_WORKSPACE"'")][0].id')" \
        'any(.[]; .app_id == "browser-work" and .workspace_id == $ws)' >/dev/null 2>&1 && return 0
    source "$HOME/.config/niri/scripts/browser-config.sh"
    setsid -f "$BROWSER_BIN" "${BROWSER_FLAGS[@]}" \
        --user-data-dir="$BROWSER_USER_DATA_WORK" \
        --profile-directory="$BROWSER_PROFILE" \
        --class="$BROWSER_CLASS_WORK" >/dev/null 2>&1
    # Slot the browser into column 2: devenv | browser | agent | nvim.
    local bid
    for _ in $(seq 50); do
        bid=$(niri msg --json windows 2>/dev/null \
            | jq -r '[.[] | select(.app_id == "browser-work")][0].id // empty')
        [ -n "$bid" ] && break
        sleep 0.2
    done
    if [ -n "$bid" ]; then
        niri msg action focus-window --id "$bid" >/dev/null 2>&1
        niri msg action move-column-to-index 2 >/dev/null 2>&1
    fi
}

# Agent activity per context, as `<name>\t<working|awaiting-you|idle>` lines.
# Consumed by the quickshell chrome, never by the engine — it lives here because
# every fact it needs (context dirs, where the agent keeps transcripts) is
# instance knowledge, and the newest-non-empty rule must match _resume_flag.
cockpit_context_states() {
    local sock t dir proj f newest st age last active_now tick phase steps
    sock="${XDG_RUNTIME_DIR:-/tmp}/kitty-cockpit-${COCKPIT_WINDOWS[0]}"
    [ -S "$sock" ] || return 0
    active_now=$(cat "$COCKPIT_STATE_DIR/active" 2>/dev/null || true)
    while IFS= read -r t; do
        [ -n "$t" ] || continue
        dir=$(cockpit_context_dir "$t")
        [ -d "$dir" ] || continue
        # Remote (lovbox) context: transcripts + plans live in the sandbox —
        # no local signal to read. Honest idle beats a wrong glyph.
        if [ "$dir" = "$HOME" ]; then
            printf '%s\tidle\t-\t-\n' "$t"
            continue
        fi
        proj="$HOME/.claude/projects/${dir//[.\/]/-}"
        st=idle
        phase=""
        steps=""
        tick=$(printf '%s' "$t" | grep -oE '^[A-Za-z]+-[0-9]+' | tr '[:lower:]' '[:upper:]')
        if [ -n "$tick" ] \
            && [ -f "$HOME/personal/notes/storage/plans/$tick.progress.json" ]; then
            phase=$(jq -r '.phase // empty' \
                "$HOME/personal/notes/storage/plans/$tick.progress.json" 2>/dev/null)
            # done/total ◆ steps — what the old bar pill's PlanState row showed.
            steps=$(jq -r '(.flow // []) as $f
                | if ($f | length) == 0 then ""
                  else ([$f[] | select(.status == "done")] | length | tostring)
                       + "/" + ($f | length | tostring) end' \
                "$HOME/personal/notes/storage/plans/$tick.progress.json" 2>/dev/null)
        fi
        # Agent-declared block (Notification hook): Claude said it needs input
        # to continue; cleared the moment you respond. Beats every heuristic.
        if [ -f "$COCKPIT_STATE_DIR/wants-input/$t" ] && [ "$t" != "$active_now" ]; then
            printf '%s\t%s\t%s\t%s\n' "$t" "awaiting-you" "${phase:--}" "${steps:--}"
            continue
        fi
        newest=""
        for f in $(ls -t "$proj"/*.jsonl 2>/dev/null); do
            if head -c 65536 "$f" | grep -q '"type":"user"'; then newest=$f; break; fi
        done
        if [ -n "$newest" ]; then
            age=$(( $(date +%s) - $(stat -c %Y "$newest") ))
            # Last *conversational* turn. Transcripts also carry non-message
            # records (pr-link, mode, summary) that would otherwise read as
            # "the agent stopped mid-thought", and a bare grep for "type" would
            # match the nested ones inside a record too.
            last=$(tail -n 40 "$newest" \
                | jq -r 'select(.type == "user" or .type == "assistant") | .type' 2>/dev/null \
                | tail -1)
            if [ "$age" -lt 20 ]; then
                st=working
            elif [ "$last" = assistant ] && [ "$age" -lt 21600 ] \
                && [ "$t" != "$active_now" ] \
                && { [ ! -f "$COCKPIT_STATE_DIR/seen/$t" ] \
                     || [ "$newest" -nt "$COCKPIT_STATE_DIR/seen/$t" ]; }; then
                # awaiting-you = assistant output you haven't SEEN: newer than
                # the seen-stamp cockpit-switch writes when you leave a context
                # (and never the active one — its reply is on screen).
                st=awaiting-you
            fi
        fi
        # A mid-lifecycle plan means the context is blocked on YOU
        # (review/--go), not done — even after you read the last reply.
        # Truly idle = no unfinished plan.
        if [ "$st" = idle ]; then
            case "$phase" in draft|planned|implementing) st=pending ;; esac
        fi
        printf '%s\t%s\t%s\t%s\n' "$t" "$st" "${phase:--}" "${steps:--}"
    done < <(kitty @ --to "unix:$sock" ls 2>/dev/null | jq -r '.[].tabs[].title')
}

# Activate an existing plan-view browser tab via the palette daemon (the
# raise is WANTED here — you asked to look at the plan). Exit 1 = no tab.
_plan_view_tab_activate() {
    python3 - "$1" <<'PY'
import json, os, socket, sys
needle = f"127.0.0.1:8746/plan/{sys.argv[1]}"
rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
try:
    s = socket.socket(socket.AF_UNIX); s.settimeout(1.5)
    s.connect(os.path.join(rt, "palette-ui.sock"))
except OSError:
    sys.exit(1)
f = s.makefile("rw")
state = None
for _ in range(5):
    line = f.readline()
    if not line:
        break
    try:
        m = json.loads(line)
    except ValueError:
        continue
    if m.get("type") == "state":
        state = m
        break
if not state:
    sys.exit(1)
hit = next((t for t in (state.get("tabs") or []) if needle in (t.get("url") or "")), None)
if not hit:
    sys.exit(1)
f.write(json.dumps({"cmd": "activate-tab", "tabId": hit["id"], "windowId": hit["windowId"]}) + "\n")
f.flush()
PY
}

# Close <name>'s plan-view browser tab (if open) via the palette daemon —
# called on context close so a finalized plan's tab doesn't outlive it.
cockpit_close_plan_tab() {
    local name=$1 tick key=""
    tick=$(printf '%s' "$name" | grep -oE '^[A-Za-z]+-[0-9]+' | tr '[:lower:]' '[:upper:]')
    [ -n "$tick" ] && key=$tick || key=$name
    COCKPIT_PLAN_KEY=$key python3 - <<'PY'
import json, os, socket, sys
key = os.environ["COCKPIT_PLAN_KEY"]
needle = f"127.0.0.1:8746/plan/{key}"
rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
try:
    s = socket.socket(socket.AF_UNIX); s.settimeout(1.5)
    s.connect(os.path.join(rt, "palette-ui.sock"))
except OSError:
    sys.exit(0)
f = s.makefile("rw")
state = None
for _ in range(5):
    line = f.readline()
    if not line: break
    try: m = json.loads(line)
    except ValueError: continue
    if m.get("type") == "state": state = m; break
for t in (state or {}).get("tabs") or []:
    if needle in (t.get("url") or ""):
        f.write(json.dumps({"cmd": "close-tab", "tabId": t["id"]}) + "\n"); f.flush()
PY
}

# Open <name>'s plan: a FINALIZED plan (diagram artifact exists) opens the
# live view in the browser and focuses it — existing tab reused, else a new
# one. Anything earlier opens the markdown in the context's nvim tab for
# review (ESC first so the :e lands in normal mode).
cockpit_open_plan() {
    local name=$1 tick key="" path="" sock url bid
    local plans="$HOME/personal/notes/storage/plans"
    tick=$(printf '%s' "$name" | grep -oE '^[A-Za-z]+-[0-9]+' | tr '[:lower:]' '[:upper:]')
    if [ -n "$tick" ] && [ -f "$plans/$tick.md" ]; then
        key=$tick
    elif [ -f "$plans/$name.md" ]; then
        key=$name
    fi
    [ -n "$key" ] || return 0
    path="$plans/$key.md"

    if [ -f "$plans/$key.diagram.html" ]; then
        # Ensure the plan-view server is up (idempotent), then tab-dedupe.
        python3 "$HOME/.claude/skills/plan-ticket/plan-view.py" "$key" >/dev/null 2>&1 || true
        if ! _plan_view_tab_activate "$key"; then
            url="http://127.0.0.1:8746/plan/$key"
            "$HOME/.config/niri/scripts/browser-dispatch" --profile=work "$url" \
                >/dev/null 2>&1 || true
            bid=$(niri msg --json windows 2>/dev/null \
                | jq -r '[.[]|select(.app_id=="browser-work")][0].id // empty')
            [ -n "$bid" ] && niri msg action focus-window --id "$bid" >/dev/null 2>&1
        fi
        return 0
    fi

    sock="${XDG_RUNTIME_DIR:-/tmp}/kitty-cockpit-nvim"
    [ -S "$sock" ] || return 0
    kitty @ --to "unix:$sock" send-text --match-tab "title:^${name}\$" \
        $'\x1b'":e ${path}"$'\r'
}

# Faithful port of devenv's sanitizeBranchForSubdomain
# (go/cli/cmd/devenv/main.go): lowercase, non-alnum -> '-', trim dashes, then
# keep the username prefix + AT MOST 3 description segments (fewer if shorter),
# capped at 63 chars. Branch is always daphen/<name>; wt-proxy port is the
# fixed constant 2015.
_preview_url() {
    local s prefix rest
    s=$(printf 'daphen/%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/^-*//; s/-*$//')
    prefix=${s%%-*}
    rest=${s#*-}
    if [ "$rest" != "$s" ]; then
        rest=$(cut -d- -f1-3 <<<"$rest")
        s="$prefix-$rest"
    fi
    s=${s:0:63}; s=${s%-}
    [ -n "$s" ] || s=dev
    printf 'http://%s.localhost:2015' "$s"
}

# Open <name>'s dev preview (the running app) in the work browser and focus it.
# Deliberate raise: unlike the auto-switch leg above, this is an explicit
# "open app" gesture, so yanking focus to the browser is what we want.
cockpit_open_app() {
    local name=$1 url bid
    url=$(_preview_url "$name")
    "$HOME/.config/niri/scripts/browser-dispatch" --profile=work "$url" >/dev/null 2>&1 || true
    bid=$(niri msg --json windows 2>/dev/null \
        | jq -r '[.[]|select(.app_id=="browser-work")][0].id // empty')
    [ -n "$bid" ] && niri msg action focus-window --id "$bid" >/dev/null 2>&1
}

cockpit_post_switch() {
    local name=$1 dir=$2
    # :3000 and :8020 are fixed ports a wt slice cannot offset (dev-edge
    # auth-bridge redirect, `lov` default), so one context owns them at a time.
    # Hand them to the one just switched to.
    "$HOME/.config/niri/scripts/wt-portmap" "$dir" >/dev/null 2>&1 || true
    # DISABLED until palette-daemon grows a raise-less, profile-pinned
    # activate/goto: today's flows target the *focused profile* and raise
    # windows on the old flow's active worktree — every switch yanks focus.
    return 0
    COCKPIT_URL=$(_preview_url "$name") \
    COCKPIT_PORT=$(cat "$dir/.devenv/state/wt-base-port" 2>/dev/null || true) \
    python3 - <<'PY'
import json, os, re, socket, subprocess, sys, time

url = os.environ["COCKPIT_URL"]
port = os.environ.get("COCKPIT_PORT", "").strip()
host = re.sub(r"^https?://", "", url).split("/")[0]
runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
sock_path = os.path.join(runtime, "palette-ui.sock")


def niri(*args):
    return subprocess.run(["niri", "msg", *args], capture_output=True,
                          text=True, timeout=3)


focused = None
try:
    focused = json.loads(niri("--json", "focused-window").stdout).get("id")
except Exception:
    pass

try:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2.0)
    s.connect(sock_path)
except OSError:
    sys.exit(0)  # daemon down — the browser leg is best-effort

f = s.makefile("rw")
state = None
for _ in range(5):
    line = f.readline()
    if not line:
        break
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    if msg.get("type") == "state":
        state = msg
        break
if state is None:
    sys.exit(0)

# The preview host is what the stack actually opens; the raw base port covers
# contexts serving straight off a port instead of the reverse proxy.
needles = [host] + ([f"localhost:{port}"] if port else [])
hit = next((t for t in (state.get("tabs") or [])
            if any(n in (t.get("url") or "") for n in needles)), None)

if hit:
    cmd = {"cmd": "activate-tab", "tabId": hit["id"], "windowId": hit["windowId"]}
else:
    cmd = {"cmd": "goto", "url": url, "newTab": True}
f.write(json.dumps(cmd) + "\n")
f.flush()

# Both daemon flows raise the browser window in niri. A cockpit switch must
# never move your focus, so put it back — that's what makes this a background
# tab rather than a hijack. The raise lands whenever the browser round-trip
# finishes, so poll for it rather than racing a fixed sleep.
if focused is not None:
    for _ in range(20):
        time.sleep(0.1)
        try:
            now = json.loads(niri("--json", "focused-window").stdout).get("id")
        except Exception:
            break
        if now != focused:
            break
    niri("action", "focus-window", "--id", str(focused))
PY
}
