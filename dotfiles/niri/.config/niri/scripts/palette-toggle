#!/usr/bin/env bash
set -euo pipefail

snapshot=$(niri msg --json workspaces)
focused_output=$(jq -r '.[] | select(.is_focused) | .output' <<< "$snapshot" | head -1)

target=$(niri msg --json windows | WORKSPACES="$snapshot" OUTPUT="$focused_output" python3 -c '
import json, os, sys
windows = json.load(sys.stdin)
workspaces = {str(w["id"]): w.get("output", "") for w in json.loads(os.environ["WORKSPACES"])}
output = os.environ.get("OUTPUT", "")
browsers = [w for w in windows
            if w.get("app_id") in ("browser-personal", "browser-work")
            and workspaces.get(str(w.get("workspace_id"))) == output]
if browsers:
    def stamp(w):
        t = w.get("focus_timestamp") or {}
        return (t.get("secs") or 0, t.get("nanos") or 0)
    print(max(browsers, key=stamp)["id"])
')

if [[ -n "$target" ]]; then
    current=$(niri msg --json focused-window | jq -r '.id // empty')
    if [[ "$current" != "$target" ]]; then
        niri msg action focus-window --id "$target" >/dev/null
        for _ in {1..20}; do
            [[ $(niri msg --json focused-window | jq -r '.id // empty') == "$target" ]] && break
            sleep 0.01
        done
    fi
fi

exec qs ipc call -- palette toggleOn "$focused_output"
