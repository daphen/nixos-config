#!/usr/bin/env python3
"""vm-slice-reaper — stop devenv slices whose owning agentd session is gone.

Runs ON the dev VM (systemd user timer). A `devenv wt` slice costs 5-6.5 GB in vite +
workerd, and nothing ever stopped one: a slice outlived its ticket, its review and its
session with no owner left to notice. Three abandoned slices (wt-every-3024 idle since
Friday, lovable-every-2738, lovable.review-pr-83188 at ~30h) had eaten 44 of 62 GB on
2026-08-25, which starved userspace tailscaled and the cockpit bridge — the first symptom
was David's phone failing to reach the VM from a train, which points nowhere near "stale
dev server".

Reaps a slice only when BOTH hold:
  * its worktree has no agentd session, or that session has been dormant past GRACE
  * the slice is not the primary checkout (~/src/lovable is never touched)
Stops it the way process-compose wants (project/stop on its own port), then clears the
tmux session. Never signals a process tree.
"""
from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.request

HOME = os.path.expanduser("~")
SRC = os.path.join(HOME, "src")
SOCK = os.environ.get("AGENTD_SOCK") or f"/run/user/{os.getuid()}/agentd-work.sock"
TCP = ("127.0.0.1", int(os.environ.get("AGENTD_PORT", "17840")))
GRACE = int(os.environ.get("SLICE_GRACE_SECONDS", "7200"))  # 2h dormant before reaping
DRY = os.environ.get("DRY_RUN") == "1"


def log(msg: str) -> None:
    print(f"[vm-slice-reaper] {msg}", flush=True)


def roster() -> dict | None:
    """Live sessions from agentd, by name. Prefers the unix socket, falls back to TCP."""
    for kind, target in (("unix", SOCK), ("tcp", TCP)):
        s = None
        try:
            if kind == "unix":
                if not os.path.exists(target):
                    continue
                s = socket.socket(socket.AF_UNIX)
            else:
                s = socket.socket(socket.AF_INET)
            s.settimeout(5)
            s.connect(target)
            buf = b""
            deadline = time.time() + 5
            while b"\n" not in buf and time.time() < deadline:
                chunk = s.recv(262144)
                if not chunk:
                    break
                buf += chunk
            s.close()
            if b"\n" not in buf:
                continue
            data = json.loads(buf.split(b"\n", 1)[0])
            sessions = data.get("sessions") if isinstance(data, dict) else None
            if not isinstance(sessions, list):
                continue
            return {x.get("name"): x for x in sessions if x.get("name")}
        except Exception:
            if s is not None: s.close()
            continue
    return None


def slice_dirs() -> set[str]:
    """Worktrees that currently have devenv processes running."""
    out = subprocess.run(["ps", "-eo", "args"], capture_output=True, text=True).stdout
    found = set()
    for m in re.finditer(r"%s/(lovable[.\-][A-Za-z0-9._\-]+)" % re.escape(SRC), out):
        found.add(m.group(1))
    return found


def listeners() -> dict[int, set[int]]:
    """Return listening TCP ports and any process IDs visible to this user."""
    result = subprocess.run(["ss", "-Hlnpt"], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(f"listener inspection failed: {result.stderr.strip()}")
    owners: dict[int, set[int]] = {}
    for fields in map(str.split, result.stdout.splitlines()):
        try:
            port = int(fields[3].rsplit(":", 1)[1])
        except (IndexError, ValueError):
            continue
        owners.setdefault(port, set()).update(map(int, re.findall(r"pid=(\d+)", fields[-1])))
    return owners


def session_name_for(worktree: str) -> str:
    """lovable-every-2739 -> every-2739 ; lovable.review-pr-83188 -> review-pr-83188."""
    name = worktree
    for prefix in ("lovable-", "lovable."):
        if name.startswith(prefix):
            name = name[len(prefix):]
            break
    return name


def dormant(entry: dict | None) -> tuple[bool, str]:
    if entry is None:
        return True, "no agentd session"
    status = entry.get("status") or ""
    if status not in ("asleep", "idle", "dormant", ""):
        return False, f"session {status}"
    idle_at = entry.get("idleAt") or entry.get("idle_at") or 0
    if status == "asleep":
        return True, "session asleep"
    if idle_at:
        age = time.time() - float(idle_at)
        if age > GRACE:
            return True, f"idle {int(age / 60)}min"
        return False, f"idle only {int(age / 60)}min"
    return False, f"status {status or 'unknown'} without an idle stamp"


def owner_dormant(worktree: str, live: dict) -> tuple[bool, str]:
    target = os.path.realpath(os.path.normpath(os.path.join(SRC, worktree)))
    owners = [entry for entry in live.values()
              if entry.get("cwd") and os.path.realpath(os.path.normpath(entry["cwd"])) == target]
    if not owners:
        return dormant(None)
    states = [(entry, *dormant(entry)) for entry in owners]
    for entry, is_dormant, why in states:
        if not is_dormant:
            return False, f"owner {entry.get('name')}: {why}"
    return True, "; ".join(f"owner {entry.get('name')}: {why}"
                           for entry, _, why in states)


def stop_slice(wt: str) -> tuple[bool, str]:
    try:
        base = int(open(os.path.join(wt, ".devenv/state/wt-base-port")).read().strip())
    except (OSError, ValueError):
        return False, "missing or invalid .devenv/state/wt-base-port"
    if base < 1 or base + 6 > 65535:
        return False, f"invalid base port {base}"
    ports = (base, base + 1, base + 2, base + 5, base + 6)
    open_ports = listeners()
    occupied = [port for port in ports if port in open_ports]
    if not occupied:
        return True, "already stopped"
    controller = open_ports.get(base + 1, set())
    if len(controller) != 1:
        return False, f"controller :{base + 1} has unknown/shared ownership"
    pid = next(iter(controller))
    try:
        cwd = os.path.realpath(f"/proc/{pid}/cwd")
    except OSError:
        return False, f"controller :{base + 1} ownership changed"
    if cwd != wt:
        return False, f"controller :{base + 1} belongs to {cwd}, not {wt}"
    try:
        request = urllib.request.Request(
            f"http://127.0.0.1:{base + 1}/project/stop", data=b"", method="POST")
        urllib.request.urlopen(request, timeout=5).close()
    except OSError as error:
        return False, f"controller :{base + 1} stop failed: {error}"
    deadline = time.time() + float(os.environ.get("SLICE_STOP_TIMEOUT", "20"))
    while time.time() < deadline:
        remaining = [port for port in ports if port in listeners()]
        if not remaining:
            return True, f"stopped controller :{base + 1}"
        time.sleep(0.1)
    return False, "shutdown unconfirmed; listeners remain on " + ", ".join(map(str, remaining))


def reap_one(worktree_path: str, session: str, now: bool = False) -> int:
    """Stop one registered ticket runtime; --now bypasses only the hook delay."""
    wt = os.path.abspath(worktree_path)
    worktree = os.path.basename(wt)
    expected = session_name_for(worktree)
    if (wt != os.path.realpath(wt) or os.path.dirname(wt) != os.path.realpath(SRC)
            or not worktree.startswith("lovable-") or session.lower() != expected.lower()):
        log(f"hook: {worktree_path} is not the exact checkout for session {session}")
        return 1
    if not now:
        time.sleep(int(os.environ.get("SLICE_HOOK_DELAY", "20")))
    live = roster()
    if live is None:
        log("hook: agentd roster unavailable — refusing to reap blind")
        return 1
    ok, why = owner_dormant(worktree, live)
    if not ok:
        log(f"hook: keeping {worktree}: {why}")
        return 1
    if DRY:
        log(f"hook: would reap {worktree} ({why})")
        return 0
    stopped, result = stop_slice(wt)
    log(f"hook: {worktree}: {result}")
    if not stopped:
        return 1
    tmux = subprocess.run(["tmux", "ls"], capture_output=True, text=True).stdout
    tmux_name = f"wt-{expected}"
    if tmux_name in tmux:
        result = subprocess.run(["tmux", "kill-session", "-t", tmux_name],
                                capture_output=True, text=True)
        if result.returncode:
            log(f"  tmux {tmux_name} removal failed: {result.stderr.strip()}")
            return 1
        log(f"  tmux {tmux_name} cleared")
    return 0


def main() -> int:
    # Hook mode (agentd fires this on session stop) reaps exactly one worktree; with no
    # arguments we sweep, which is the orphan net for slices whose session vanished while
    # the daemon was down — no event can ever fire for those.
    if "--worktree" in sys.argv:
        i = sys.argv.index("--worktree")
        wt = sys.argv[i + 1] if len(sys.argv) > i + 1 else ""
        sess = ""
        if "--session" in sys.argv:
            j = sys.argv.index("--session")
            sess = sys.argv[j + 1] if len(sys.argv) > j + 1 else ""
        return reap_one(wt, sess or session_name_for(os.path.basename(wt.rstrip("/"))),
                        "--now" in sys.argv)

    live = roster()
    if live is None:
        log("agentd roster unavailable — refusing to reap blind")
        return 1
    running = slice_dirs()
    if not running:
        log("no devenv slices running")
        return 0

    tmux = subprocess.run(["tmux", "ls"], capture_output=True, text=True).stdout
    failed = False
    for worktree in sorted(running):
        if worktree in ("lovable",):
            continue
        name = session_name_for(worktree)
        ok, why = owner_dormant(worktree, live)
        if not ok:
            log(f"keep {worktree}: {why}")
            continue
        log(f"reap {worktree}: {why}")
        if DRY:
            continue
        stopped, result = stop_slice(os.path.join(SRC, worktree))
        log(f"  {result}")
        if not stopped:
            failed = True
            continue
        tmux_name = f"wt-{name}"
        if tmux_name in tmux:
            result = subprocess.run(["tmux", "kill-session", "-t", tmux_name],
                                    capture_output=True, text=True)
            if result.returncode:
                log(f"  tmux {tmux_name} removal failed: {result.stderr.strip()}")
                failed = True
            else:
                log(f"  tmux {tmux_name} cleared")
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
