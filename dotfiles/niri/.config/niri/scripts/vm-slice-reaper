#!/usr/bin/env python3
"""vm-slice-reaper — stop devenv slices whose owning agentd session is gone.

Runs ON the dev VM (systemd user timer). A `devenv wt` slice costs 5-6.5 GB in vite +
workerd, and nothing ever stopped one: a slice outlived its ticket, its review and its
session with no owner left to notice. Three abandoned slices (wt-every-3024 idle since
Friday, lovable-every-2738, lovable.review-pr-83188 at ~30h) had eaten 44 of 62 GB on
2026-08-25, which starved userspace tailscaled and the cockpit bridge — the first symptom
was David's phone failing to reach the VM from a train, which points nowhere near "stale
dev server".

Reaps a slice only when BOTH hold:
  * its worktree has no agentd session, or that session has been dormant past GRACE
  * the slice is not the primary checkout (~/src/lovable is never touched)
Stops it the way process-compose wants (project/stop on its own port), then clears the
tmux session. Never signals a process tree.
"""
from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
SRC = os.path.join(HOME, "src")
SOCK = os.environ.get("AGENTD_SOCK") or f"/run/user/{os.getuid()}/agentd-work.sock"
TCP = ("127.0.0.1", int(os.environ.get("AGENTD_PORT", "17840")))
GRACE = int(os.environ.get("SLICE_GRACE_SECONDS", "7200"))  # 2h dormant before reaping
DRY = os.environ.get("DRY_RUN") == "1"


def log(msg: str) -> None:
    print(f"[vm-slice-reaper] {msg}", flush=True)


def roster() -> dict:
    """Live sessions from agentd, by name. Prefers the unix socket, falls back to TCP."""
    for kind, target in (("unix", SOCK), ("tcp", TCP)):
        try:
            if kind == "unix":
                if not os.path.exists(target):
                    continue
                s = socket.socket(socket.AF_UNIX)
            else:
                s = socket.socket(socket.AF_INET)
            s.settimeout(5)
            s.connect(target)
            buf = b""
            deadline = time.time() + 5
            while b"\n" not in buf and time.time() < deadline:
                chunk = s.recv(262144)
                if not chunk:
                    break
                buf += chunk
            s.close()
            if b"\n" not in buf:
                continue
            data = json.loads(buf.split(b"\n", 1)[0])
            return {x.get("name"): x for x in data.get("sessions", []) if x.get("name")}
        except Exception:
            continue
    return {}


def slice_dirs() -> set[str]:
    """Worktrees that currently have devenv processes running."""
    out = subprocess.run(["ps", "-eo", "args"], capture_output=True, text=True).stdout
    found = set()
    for m in re.finditer(r"%s/(lovable[.\-][A-Za-z0-9._\-]+)" % re.escape(SRC), out):
        found.add(m.group(1))
    return found


def pc_ports(worktree: str) -> list[int]:
    """Candidate process-compose ports seen in that worktree's process args."""
    out = subprocess.run(["ps", "-eo", "args"], capture_output=True, text=True).stdout
    ports: list[int] = []
    for line in out.splitlines():
        if f"{SRC}/{worktree}" not in line:
            continue
        for m in re.finditer(r":(\d{5})\b", line):
            p = int(m.group(1))
            if p not in ports:
                ports.append(p)
    # process-compose usually sits one below the slice's web port; try neighbours too.
    for p in list(ports):
        for delta in (-1, 1):
            if p + delta not in ports:
                ports.append(p + delta)
    return ports


def session_name_for(worktree: str) -> str:
    """lovable-every-2739 -> every-2739 ; lovable.review-pr-83188 -> review-pr-83188."""
    name = worktree
    for prefix in ("lovable-", "lovable."):
        if name.startswith(prefix):
            name = name[len(prefix):]
            break
    return name


def dormant(entry: dict | None) -> tuple[bool, str]:
    if entry is None:
        return True, "no agentd session"
    status = entry.get("status") or ""
    if status not in ("asleep", "idle", "dormant", ""):
        return False, f"session {status}"
    idle_at = entry.get("idleAt") or entry.get("idle_at") or 0
    if status == "asleep":
        return True, "session asleep"
    if idle_at:
        age = time.time() - float(idle_at)
        if age > GRACE:
            return True, f"idle {int(age / 60)}min"
        return False, f"idle only {int(age / 60)}min"
    return False, f"status {status or 'unknown'} without an idle stamp"


def stop_slice(worktree: str) -> bool:
    wt = os.path.join(SRC, worktree)
    for port in pc_ports(worktree):
        r = subprocess.run(["process-compose", "down", "-p", str(port)],
                           cwd=wt, capture_output=True, text=True, timeout=25)
        if "failed to stop" not in (r.stdout + r.stderr):
            log(f"  process-compose down on :{port} accepted")
            return True
    return False


def reap_one(worktree_path: str, session: str) -> int:
    """Hook mode: agentd just stopped `session`, whose cwd was worktree_path."""
    worktree = os.path.basename(worktree_path.rstrip("/"))
    if worktree in ("lovable", "") or not worktree.startswith("lovable"):
        log(f"hook: {worktree_path} is not a ticket worktree — nothing to reap")
        return 0
    if worktree not in slice_dirs():
        log(f"hook: {worktree} has no running slice")
        return 0
    # A stop is not always final: a re-prompt wakes the session straight back up. Give it
    # a breath, then confirm the session really is gone before killing a 6GB slice.
    time.sleep(int(os.environ.get("SLICE_HOOK_DELAY", "20")))
    entry = roster().get(session)
    if entry and (entry.get("status") or "") not in ("asleep", ""):
        log(f"hook: {session} came back ({entry.get('status')}) — keeping {worktree}")
        return 0
    log(f"hook: reaping {worktree} (session {session} stopped)")
    if not stop_slice(worktree):
        log(f"  no process-compose answered for {worktree}")
    tmux = subprocess.run(["tmux", "ls"], capture_output=True, text=True).stdout
    tmux_name = f"wt-{session_name_for(worktree)}"
    if tmux_name in tmux:
        subprocess.run(["tmux", "kill-session", "-t", tmux_name], capture_output=True, text=True)
        log(f"  tmux {tmux_name} cleared")
    return 0


def main() -> int:
    # Hook mode (agentd fires this on session stop) reaps exactly one worktree; with no
    # arguments we sweep, which is the orphan net for slices whose session vanished while
    # the daemon was down — no event can ever fire for those.
    if "--worktree" in sys.argv:
        i = sys.argv.index("--worktree")
        wt = sys.argv[i + 1] if len(sys.argv) > i + 1 else ""
        sess = ""
        if "--session" in sys.argv:
            j = sys.argv.index("--session")
            sess = sys.argv[j + 1] if len(sys.argv) > j + 1 else ""
        return reap_one(wt, sess or session_name_for(os.path.basename(wt.rstrip("/"))))

    live = roster()
    if not live:
        log("agentd roster unavailable — refusing to reap blind")
        return 0
    running = slice_dirs()
    if not running:
        log("no devenv slices running")
        return 0

    tmux = subprocess.run(["tmux", "ls"], capture_output=True, text=True).stdout

    for worktree in sorted(running):
        if worktree in ("lovable",):
            continue
        name = session_name_for(worktree)
        ok, why = dormant(live.get(name))
        if not ok:
            log(f"keep {worktree}: {why}")
            continue
        log(f"reap {worktree}: {why}")
        if DRY:
            continue
        if not stop_slice(worktree):
            log(f"  no process-compose answered for {worktree}")
        tmux_name = f"wt-{name}"
        if tmux_name in tmux:
            subprocess.run(["tmux", "kill-session", "-t", tmux_name],
                           capture_output=True, text=True)
            log(f"  tmux {tmux_name} cleared")
    return 0


if __name__ == "__main__":
    sys.exit(main())
