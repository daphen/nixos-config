#!/usr/bin/env python3
"""
ws-focus-workspace-up

Drop-in replacement for focus-workspace-up-or-monitor that treats the
group of `lovable-*` named workspaces as a two-slot dock: main and the
current partner worktree (recency front) participate in the Super+J/K
walk; the rest of the pile is hidden. ws-reorder keeps the pair in a
STATIC [main, worktree] order touching the non-lovables, so every step
in the walk is physically adjacent — nothing hidden ever scrolls past.

If at the top of the filtered list, falls back to focus-monitor-up
(same as the original script).
"""
from __future__ import annotations
import json
import os
import subprocess
import sys
from pathlib import Path

RECENCY_FILE = Path(os.environ["HOME"]) / ".local/state/wt-stacks/ws/recency"
MAIN_WS = "lovable-main"


def niri_json(*args: str):
    out = subprocess.run(
        ["niri", "msg", "--json", *args], capture_output=True, text=True, timeout=2
    )
    return json.loads(out.stdout) if out.stdout.strip() else None


def visible_lovables(workspaces: list[dict]) -> set[str]:
    """main + the current partner worktree (most recent one that still
    exists) — the two lovable workspaces that participate in the walk."""
    names = {w.get("name") for w in workspaces}
    try:
        recency = [n for n in json.loads(RECENCY_FILE.read_text()) if isinstance(n, str)]
    except Exception:
        recency = []
    partner = next((n for n in recency
                    if n != MAIN_WS and n.startswith("lovable-") and n in names), "")
    return {MAIN_WS, partner} - {""}


def is_hidden_lovable(name: str | None, visible: set[str]) -> bool:
    if not name or not name.startswith("lovable-"):
        return False
    return name not in visible


def main(direction: str) -> int:
    workspaces = niri_json("workspaces") or []
    cur = next((w for w in workspaces
                if w.get("is_active") and w.get("is_focused")), None)
    if cur is None:
        return 0
    cur_output = cur.get("output")

    visible = visible_lovables(workspaces)

    # Filter to: same output, has windows, not a hidden (pile) lovable.
    candidates = [
        w for w in workspaces
        if w.get("output") == cur_output
        and w.get("active_window_id") is not None
        and not is_hidden_lovable(w.get("name"), visible)
    ]
    candidates.sort(key=lambda w: w.get("idx") or 0)

    cur_idx = cur.get("idx") or 0
    if direction == "up":
        target = next(
            (w for w in reversed(candidates) if (w.get("idx") or 0) < cur_idx),
            None,
        )
        action = "focus-monitor-up"
    else:  # down
        target = next(
            (w for w in candidates if (w.get("idx") or 0) > cur_idx),
            None,
        )
        action = "focus-monitor-down"

    if target is None:
        # No further workspace in that direction; let niri try moving to
        # the adjacent monitor. If there isn't one, niri silently no-ops.
        subprocess.run(["niri", "msg", "action", action], check=False, timeout=2)
        return 0

    name = target.get("name")
    ref = name if name else str(target["idx"])
    subprocess.run(["niri", "msg", "action", "focus-workspace", ref],
                   check=False, timeout=2)
    return 0


if __name__ == "__main__":
    direction = "up" if Path(sys.argv[0]).name.endswith("-up") else "down"
    sys.exit(main(direction))
