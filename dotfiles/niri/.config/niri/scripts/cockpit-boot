#!/usr/bin/env bash
set -euo pipefail

instance="${1:?usage: cockpit-boot work|personal}"
case "$instance" in
  work) default_scope=lovable ;;
  personal) default_scope=personal ;;
  *) echo "cockpit-boot: expected work or personal" >&2; exit 2 ;;
esac

export COCKPIT_INSTANCE="$instance"
mode_file="$HOME/.local/state/cockpit/mode-$instance"
if [ ! -r "$mode_file" ]; then
  export COCKPIT_SCOPE="$default_scope"
fi

exec "$HOME/personal/ai-cockpit/run-qs.sh"
