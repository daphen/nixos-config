#!/usr/bin/env bash
# Focus the window/app for a notification, shared by inbox-jump and the
# NotificationJumpPicker. Two forms:
#   notification-dispatch <id>              active notification (precise)
#   notification-dispatch --past <app> <summary>   dismissed (best-effort)
set -e

DIR=$(dirname "$0")

# Focus a window whose app_id matches $1 (substring, either direction).
focus_app_window() {
    local la win
    la=$(printf %s "$1" | tr '[:upper:]' '[:lower:]')
    case "$la" in helium|chromium|chrome|firefox) la="browser" ;; esac
    win=$(niri msg --json windows 2>/dev/null | jq -r --arg a "$la" \
        '[.[] | (.app_id // "" | ascii_downcase) as $w
          | select($w != "" and (($w | contains($a)) or ($a | contains($w))))][0].id // empty')
    [ -n "$win" ] && niri msg action focus-window --id "$win" >/dev/null 2>&1 || true
}

# Cockpit path: if the summary names a context with a live cockpit tab, switch
# the whole cockpit to it and focus the NVIM window (you land in that session's
# rail). Returns 1 when the summary isn't a cockpit context (callers fall through).
focus_cockpit_context() {
    local ctx
    # "Claude · <label>" — label is the context name (strip the old
    # lovable.daphen- prefix if present). The tab check validates the guess.
    ctx=$(printf '%s' "$1" | sed -n 's/^Claude · //p' | sed 's|^lovable\.daphen-||')
    [ -n "$ctx" ] && [ -S ${XDG_RUNTIME_DIR:-/tmp}/kitty-cockpit-agent ] || return 1
    kitty @ --to unix:${XDG_RUNTIME_DIR:-/tmp}/kitty-cockpit-agent ls 2>/dev/null \
        | jq -e --arg t "$ctx" 'any(.[].tabs[]; .title == $t)' >/dev/null || return 1
    "$DIR/cockpit-switch" "$ctx" >/dev/null 2>&1 || true
    "$DIR/cockpit-focus" nvim >/dev/null 2>&1 || true
}

# Focus a worktree's claude window from a "lovable.daphen-<name>" summary.
focus_worktree_from_summary() {
    local ws ws_id cwin
    ws=$(printf '%s' "$1" | grep -oE 'lovable\.daphen-[^[:space:]]+' | head -1 | sed 's|lovable\.daphen-|lovable-|')
    [ -z "$ws" ] && return 0
    niri msg action focus-workspace "$ws" >/dev/null 2>&1 || true
    ws_id=$(niri msg --json workspaces 2>/dev/null | jq -r --arg n "$ws" '.[]|select(.name==$n)|.id' | head -1)
    [ -z "$ws_id" ] && return 0
    cwin=$(niri msg --json windows 2>/dev/null \
        | jq -r --argjson w "$ws_id" '[.[]|select(.workspace_id==$w and .app_id=="claude")][0].id // empty')
    [ -n "$cwin" ] && niri msg action focus-window --id "$cwin" >/dev/null 2>&1 || true
}

# ── History form: the live notification is gone, focus is best-effort ──
if [ "$1" = "--past" ]; then
    app="$2"; summary="$3"; winid="$4"
    case "$app" in
        endcord|Discord|discord)     exec "$DIR/niri-jump-or-exec" "title:dsqrd" "$DIR/launch-discord-client" ;;
        kitty)
            if focus_cockpit_context "$summary"; then
                :
            elif [ -n "$winid" ] && [ "$winid" != "null" ]; then
                niri msg action focus-window --id "$winid" >/dev/null 2>&1 || true
            else
                focus_worktree_from_summary "$summary"
            fi
            exit 0 ;;
        Slack|slack|slk) exec "$DIR/niri-jump-or-exec" "title:slqs" "$DIR/launch-slack-client" ;;
        mlqs)        exec "$DIR/niri-jump-or-exec" "title:mlqs" "$DIR/launch-mail-client" ;;
        agent-rail)
            # In-nvim rail notification: summary is "agent · <name>" where <name>
            # is the session short id (e.g. every-2585). Resolve it to the matching
            # cockpit context (the tab title may be longer, e.g. every-2585-move-ds-…),
            # switch the cockpit to it (the rail follows the active context on its
            # own), and focus the nvim window so you land in that session's rail.
            name=$(printf '%s' "$summary" | sed -n 's/^agent · //p')
            sock=${XDG_RUNTIME_DIR:-/tmp}/kitty-cockpit-nvim
            if [ -n "$name" ] && [ -S "$sock" ]; then
                ctx=$(kitty @ --to "unix:$sock" ls 2>/dev/null \
                    | jq -r --arg n "$name" '[.[].tabs[].title | select(. == $n or startswith($n + "-"))][0] // empty')
                [ -n "$ctx" ] && "$DIR/cockpit-switch" "$ctx" >/dev/null 2>&1 || true
            fi
            "$DIR/cockpit-focus" nvim >/dev/null 2>&1 || true
            exit 0 ;;
        *)           focus_app_window "$app"; exit 0 ;;
    esac
fi

# ── Active form: route by the live notification's app_name ──
id="${1:-}"
[ -z "$id" ] && exit 0

data=$(qs ipc call notifications list 2>/dev/null \
    | jq -c --argjson id "$id" 'map(select(.id == $id)) | .[0] // empty' 2>/dev/null)
[ -z "$data" ] && exit 0

app=$(printf '%s' "$data" | jq -r '.app_name // empty')

case "$app" in
    endcord|Discord|discord)
        # invoke → dsqrd's notifier opens the channel; then focus/launch the client
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        exec "$DIR/niri-jump-or-exec" "title:dsqrd" "$DIR/launch-discord-client"
        ;;
    Slack|slack|slk)
        # Native client (slqs): its notification's default action opens the
        # channel/thread and raises its org.quickshell window. Invoke, then
        # focus by TITLE — org.quickshell is shared with dsqrd/mlqs, so a
        # title-blind focus grabbed the wrong client (was landing on dsqrd).
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        exec "$DIR/niri-jump-or-exec" "title:slqs" "$DIR/launch-slack-client"
        ;;
    kitty)
        exec "$DIR/kitty-osc-jump" "$id"
        ;;
    mlqs)
        # invoke → the daemon's default action opens the conversation; then focus
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        exec "$DIR/niri-jump-or-exec" "title:mlqs" "$DIR/launch-mail-client"
        ;;
    *)
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        sleep 0.05
        focused=$(niri msg --json focused-window 2>/dev/null | jq -r '.app_id // empty' | tr '[:upper:]' '[:lower:]')
        la=$(printf %s "$app" | tr '[:upper:]' '[:lower:]')
        case "$la" in helium|chromium|chrome|firefox) la="browser" ;; esac
        if [ -n "$focused" ]; then
            case "$focused" in *"$la"*) exit 0 ;; esac
            case "$la" in *"$focused"*) exit 0 ;; esac
        fi
        focus_app_window "$app"
        ;;
esac