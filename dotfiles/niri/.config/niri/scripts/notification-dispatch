#!/usr/bin/env bash
# Focus the window/app for a notification, shared by inbox-jump and the
# NotificationJumpPicker. Two forms:
#   notification-dispatch <id>              active notification (precise)
#   notification-dispatch --past <app> <summary>   dismissed (best-effort)
set -e

DIR=$(dirname "$0")

# Focus a window whose app_id matches $1 (substring, either direction).
focus_app_window() {
    local la win
    la=$(printf %s "$1" | tr '[:upper:]' '[:lower:]')
    case "$la" in helium|chromium|chrome|firefox) la="browser" ;; esac
    win=$(niri msg --json windows 2>/dev/null | jq -r --arg a "$la" \
        '[.[] | (.app_id // "" | ascii_downcase) as $w
          | select($w != "" and (($w | contains($a)) or ($a | contains($w))))][0].id // empty')
    [ -n "$win" ] && niri msg action focus-window --id "$win" >/dev/null 2>&1 || true
}

# Cockpit path: if the summary names a context with a live cockpit tab, switch
# the whole cockpit to it and focus the NVIM window (you land in that session's
# rail). Returns 1 when the summary isn't a cockpit context (callers fall through).
focus_cockpit_context() {
    local ctx sock
    # "<brand> · <label>" — brand is Heidr (pi agents) or Claude (standalone); label
    # is the context name (strip the old lovable.daphen- prefix if present). Validate
    # against the NVIM cockpit's tabs (the agent CLI window is retired — everything's
    # the rail now), match exact or prefix, switch the cockpit to it, focus nvim.
    ctx=$(printf '%s' "$1" | sed -n -E 's/^(Heidr|Claude) · //p' | sed 's|^lovable\.daphen-||')
    sock=${XDG_RUNTIME_DIR:-/tmp}/kitty-cockpit-nvim
    [ -n "$ctx" ] && [ -S "$sock" ] || return 1
    kitty @ --to "unix:$sock" ls 2>/dev/null \
        | jq -e --arg t "$ctx" 'any(.[].tabs[]; .title == $t or (.title | startswith($t + "-")))' >/dev/null || return 1
    "$DIR/cockpit-switch" "$ctx" >/dev/null 2>&1 || true
    "$DIR/cockpit-focus" nvim >/dev/null 2>&1 || true
}

# Focus a worktree's claude window from a "lovable.daphen-<name>" summary.
focus_worktree_from_summary() {
    local ws ws_id cwin
    ws=$(printf '%s' "$1" | grep -oE 'lovable\.daphen-[^[:space:]]+' | head -1 | sed 's|lovable\.daphen-|lovable-|')
    [ -z "$ws" ] && return 0
    niri msg action focus-workspace "$ws" >/dev/null 2>&1 || true
    ws_id=$(niri msg --json workspaces 2>/dev/null | jq -r --arg n "$ws" '.[]|select(.name==$n)|.id' | head -1)
    [ -z "$ws_id" ] && return 0
    cwin=$(niri msg --json windows 2>/dev/null \
        | jq -r --argjson w "$ws_id" '[.[]|select(.workspace_id==$w and .app_id=="claude")][0].id // empty')
    [ -n "$cwin" ] && niri msg action focus-window --id "$cwin" >/dev/null 2>&1 || true
}

# ── History form: the live notification is gone, focus is best-effort ──
if [ "$1" = "--past" ]; then
    app="$2"; summary="$3"; winid="$4"
    case "$app" in
        endcord|Discord|discord)     exec "$DIR/niri-jump-or-exec" "title:dsqrd" "$DIR/launch-discord-client" ;;
        kitty)
            # Super+i on a single toast lands HERE (--past). Route cockpit contexts to the
            # nvim rail: a live cockpit tab first, else a by-NAME rail jump (agent-jump —
            # reaches tab-less sessions, the common case since most contexts share one nvim
            # tab), else the window hint / worktree fallback.
            ctx=$(printf '%s' "$summary" | sed -n -E 's/^(Heidr|Claude) · //p' | sed 's|^lovable\.daphen-||')
            if focus_cockpit_context "$summary"; then
                :
            elif [ -n "$ctx" ]; then
                jf="$HOME/.local/state/cockpit/agent-jump"
                mkdir -p "$(dirname "$jf")"
                printf '%s\n' "$ctx" > "$jf.tmp" && mv "$jf.tmp" "$jf"
                "$DIR/cockpit-focus" nvim >/dev/null 2>&1 || true
            elif [ -n "$winid" ] && [ "$winid" != "null" ]; then
                niri msg action focus-window --id "$winid" >/dev/null 2>&1 || true
            else
                focus_worktree_from_summary "$summary"
            fi
            exit 0 ;;
        Slack|slack|slk) exec "$DIR/niri-jump-or-exec" Slack slack ;;
        mlqs)        exec "$DIR/niri-jump-or-exec" "title:mlqs" "$DIR/launch-mail-client" ;;
        agent-rail)
            # In-nvim rail notification: summary is "agent · <name>". Jump by NAME,
            # not by cockpit tab: drop the name in cockpit/agent-jump and the rail
            # selects that session in whatever tab is active (its roster is
            # cross-context), which reaches sessions that have NO cockpit tab too —
            # wt-spawned agents and sub-agents. For a session that DOES own a context,
            # the rail's own sync then switches to it. Atomic write (temp + rename).
            name=$(printf '%s' "$summary" | sed -n 's/^agent · //p')
            if [ -n "$name" ]; then
                jf="$HOME/.local/state/cockpit/agent-jump"
                mkdir -p "$(dirname "$jf")"
                printf '%s\n' "$name" > "$jf.tmp" && mv "$jf.tmp" "$jf"
            fi
            "$DIR/cockpit-focus" nvim >/dev/null 2>&1 || true
            exit 0 ;;
        *)           focus_app_window "$app"; exit 0 ;;
    esac
fi

# ── Active form: route by the live notification's app_name ──
id="${1:-}"
[ -z "$id" ] && exit 0

data=$(qs ipc call notifications list 2>/dev/null \
    | jq -c --argjson id "$id" 'map(select(.id == $id)) | .[0] // empty' 2>/dev/null)
[ -z "$data" ] && exit 0

app=$(printf '%s' "$data" | jq -r '.app_name // empty')

case "$app" in
    endcord|Discord|discord)
        # invoke → dsqrd's notifier opens the channel; then focus/launch the client
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        exec "$DIR/niri-jump-or-exec" "title:dsqrd" "$DIR/launch-discord-client"
        ;;
    Slack|slack|slk)
        # slqs is RETIRED (lovable-dev enterprise signs out third-party token clients),
        # so Slack runs in the OFFICIAL app now. Invoke the notification (Slack navigates
        # to the thread), then focus/launch the official client — same target as Super+s.
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        exec "$DIR/niri-jump-or-exec" Slack slack
        ;;
    kitty)
        # Heidr/Claude toasts are app_name=kitty with a "<brand> · <ctx>" summary. Route
        # cockpit contexts to the NVIM rail first (kitty-osc-jump's own cockpit path still
        # targeted the retired agent window). Order: live cockpit tab → by-NAME rail jump
        # (reaches tab-less sessions) → plain kitty-osc-jump for non-cockpit sessions.
        summary=$(printf '%s' "$data" | jq -r '.summary // empty')
        ctx=$(printf '%s' "$data" | jq -r '.hints["cockpit-context"] // empty')
        [ -z "$ctx" ] && ctx=$(printf '%s' "$summary" | sed -n -E 's/^(Heidr|Claude) · //p' | sed 's|^lovable\.daphen-||')
        if focus_cockpit_context "$summary"; then
            qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        elif [ -n "$ctx" ]; then
            jf="$HOME/.local/state/cockpit/agent-jump"
            mkdir -p "$(dirname "$jf")"
            printf '%s\n' "$ctx" > "$jf.tmp" && mv "$jf.tmp" "$jf"
            "$DIR/cockpit-focus" nvim >/dev/null 2>&1 || true
            qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        else
            exec "$DIR/kitty-osc-jump" "$id"
        fi
        ;;
    mlqs)
        # invoke → the daemon's default action opens the conversation; then focus
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        exec "$DIR/niri-jump-or-exec" "title:mlqs" "$DIR/launch-mail-client"
        ;;
    agent-rail)
        # In-nvim rail toast ("agent · <name>"). Jump by NAME via cockpit/agent-jump
        # (see the --past branch): the rail selects the session in the active tab —
        # cross-context, so it reaches tab-less wt-spawned agents + sub-agents, and
        # switches context on its own for sessions that do own one. The default *)
        # branch can't help (the rail is a kitty TAB, not its own app_id).
        summary=$(printf '%s' "$data" | jq -r '.summary // empty')
        name=$(printf '%s' "$summary" | sed -n 's/^agent · //p')
        if [ -n "$name" ]; then
            jf="$HOME/.local/state/cockpit/agent-jump"
            mkdir -p "$(dirname "$jf")"
            printf '%s\n' "$name" > "$jf.tmp" && mv "$jf.tmp" "$jf"
        fi
        "$DIR/cockpit-focus" nvim >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        exit 0
        ;;
    *)
        qs ipc call notifications invoke "$id" >/dev/null 2>&1 || true
        qs ipc call notifications dismiss "$id" >/dev/null 2>&1 || true
        sleep 0.05
        focused=$(niri msg --json focused-window 2>/dev/null | jq -r '.app_id // empty' | tr '[:upper:]' '[:lower:]')
        la=$(printf %s "$app" | tr '[:upper:]' '[:lower:]')
        case "$la" in helium|chromium|chrome|firefox) la="browser" ;; esac
        if [ -n "$focused" ]; then
            case "$focused" in *"$la"*) exit 0 ;; esac
            case "$la" in *"$focused"*) exit 0 ;; esac
        fi
        focus_app_window "$app"
        ;;
esac