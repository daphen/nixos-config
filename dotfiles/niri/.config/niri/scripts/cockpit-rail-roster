#!/usr/bin/env bash
# Super+T — the in-app Ctrl+T, from anywhere on the CURRENT workspace:
#   focused on a Cockpit → toggle its roster (open+park / put away)
#   focused elsewhere    → focus the cockpit ON THIS WORKSPACE, land on its roster
#   no cockpit here      → do nothing
# NEVER hops to another cockpit or workspace (the old hop drove context switches
# nobody asked for).
set -uo pipefail
REG="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id"

out=$(niri msg --json windows 2>/dev/null | python3 -c '
import json, sys
ws = json.load(sys.stdin)
foc = next((w for w in ws if w.get("is_focused")), None)
print(str(foc.get("title") or "") if foc else "")
print(foc.get("workspace_id") if foc else "")
for w in ws:
    if str(w.get("title") or "").startswith("cockpit-qs"):
        print(f"{w[\"id\"]}\t{w.get(\"workspace_id\")}\t{w.get(\"title\")}")' 2>/dev/null) || exit 0
focused=$(printf '%s\n' "$out" | sed -n 1p)
focws=$(printf '%s\n' "$out" | sed -n 2p)

id_for_title() {
  local i t
  for i in $(ls -1t "$REG" 2>/dev/null | head -12); do
    t=$(timeout 2 qs ipc -i "$i" call cockpit title 2>/dev/null) || continue
    [ "$t" = "$1" ] && { echo "$i"; return 0; }
  done
  return 1
}
ipc_for_title() {   # cached instance id per title, revalidated by the call itself
  local title="$1" fn="$2" cachef cid r
  cachef="${XDG_RUNTIME_DIR:-/tmp}/cockpit-rail-roster.$(printf '%s' "$title" | tr -c 'A-Za-z0-9' _)"
  if [ -r "$cachef" ]; then
    cid=$(cat "$cachef" 2>/dev/null || true)
    if [ -n "${cid:-}" ]; then
      r=$(timeout 3 qs ipc -i "$cid" call cockpit "$fn" 2>/dev/null || true)
      case "$r" in landed|collapsed|parked|ok) return 0;; esac
    fi
  fi
  cid=$(id_for_title "$title") || return 1
  printf '%s' "$cid" > "$cachef" 2>/dev/null || true
  timeout 3 qs ipc -i "$cid" call cockpit "$fn" >/dev/null 2>&1
}

case "$focused" in
  cockpit-qs*)
    ipc_for_title "$focused" rosterToggle
    ;;
  *)
    # Cockpit on the FOCUSED workspace only — never jump workspaces.
    line=$(printf '%s\n' "$out" | tail -n +3 | awk -F'\t' -v ws="$focws" '$2 == ws { print; exit }')
    [ -n "$line" ] || exit 0
    wid=${line%%	*}
    title=${line##*	}
    niri msg action focus-window --id "$wid" >/dev/null 2>&1
    ipc_for_title "$title" rosterHop
    ;;
esac
