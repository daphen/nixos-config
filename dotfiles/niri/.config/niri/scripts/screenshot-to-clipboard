#!/usr/bin/env bash
# Freeze the focused output first, then crop in satty (Enter/Ctrl+C = copy + exit).

SCREENSHOT_DIR="/tmp"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
SCREENSHOT_FILE="$SCREENSHOT_DIR/screenshot-$TIMESTAMP.png"
LATEST_LINK="$SCREENSHOT_DIR/latest-screenshot.png"
FROZEN="$SCREENSHOT_DIR/.screenshot-frozen-$$.png"

OUTPUT=$(niri msg --json focused-output | jq -r .name)
if ! grim ${OUTPUT:+-o "$OUTPUT"} "$FROZEN"; then
    notify-send -a "Screenshot" "Screenshot" "Failed to capture screen" --urgency=critical
    exit 1
fi

satty_cmd() {
    if command -v satty >/dev/null; then
        satty "$@"
    else
        # Until the rebuild that installs satty lands (pinned path avoids
        # a multi-second nix eval on every keypress)
        /nix/store/kklfm7l5kdr11b86zawy9f1lxg8fl6sp-satty-0.20.1/bin/satty "$@"
    fi
}

if satty_cmd --filename "$FROZEN" --fullscreen \
        --initial-tool crop \
        --output-filename "$SCREENSHOT_FILE" \
        --copy-command wl-copy --save-after-copy --early-exit \
   && [ -s "$SCREENSHOT_FILE" ]; then
    ln -sf "$SCREENSHOT_FILE" "$LATEST_LINK"
    # The app name maps to the camera glyph in the island
    notify-send -a "Screenshot" "Screenshot" "Copied to clipboard"
else
    rm -f "$FROZEN"
    exit 0  # cancelled in satty
fi
rm -f "$FROZEN"

# Keep last 100 — the clipboard picker matches these files' timestamps
# to label entries "screenshot" vs "image"
ls -t "$SCREENSHOT_DIR"/screenshot-*.png 2>/dev/null | tail -n +101 | xargs -r rm
