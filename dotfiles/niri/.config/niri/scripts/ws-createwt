#!/usr/bin/env python3
"""
ws-createwt <worktree-name> [--mode auto|new|resume|fork] [--session-id <sid>]

Default mode `auto` resumes the worktree's most recent claude session
when one exists (so reopening a stack comes back with its conversation
intact), falling back to a fresh session otherwise.

Each worktree lives on its own named niri workspace `lovable-<name>`.
Spawns 4 windows in 4 columns: devenv terminal (kitty), work-profile
browser window (via browser-dispatch), claude (kitty `--class claude`),
nvim (kitty). Niri places
each spawn naturally as a new column on the focused workspace.

The "active" stack is whichever lovable-<name> workspace is currently
focused — tracked by ws-tracker, which writes
~/.local/state/wt-stacks/ws/active.
"""
from __future__ import annotations
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = os.environ["HOME"]
LOVABLE_DIR = Path(HOME) / "work" / "lovable"


def niri_json(*args: str):
    out = subprocess.run(
        ["niri", "msg", "--json", *args], capture_output=True, text=True, timeout=3
    )
    return json.loads(out.stdout) if out.stdout.strip() else None


def niri_action(*args: str) -> int:
    return subprocess.run(
        ["niri", "msg", "action", *args], capture_output=True, timeout=3
    ).returncode


def workspace_id_by_name(name: str) -> int | None:
    for ws in (niri_json("workspaces") or []):
        if ws.get("name") == name:
            return ws["id"]
    return None


def trailing_empty_unnamed_idx(output: str) -> int | None:
    """Highest-idx empty unnamed workspace on `output` — niri keeps a
    trailing one alive at all times."""
    cands = [
        w for w in (niri_json("workspaces") or [])
        if w.get("output") == output
        and w.get("name") is None
        and w.get("active_window_id") is None
    ]
    cands.sort(key=lambda w: -w["idx"])
    return cands[0]["idx"] if cands else None


def focused_output() -> str | None:
    fw = niri_json("focused-window")
    if fw is None:
        return None
    ws_id = fw.get("workspace_id")
    for w in (niri_json("workspaces") or []):
        if w["id"] == ws_id:
            return w.get("output")
    return None


def ensure_workspace(name: str, focus: bool = True) -> int:
    """Create-and-name the workspace `name` (and focus it unless focus=False).
    Returns its id.

    Uses `set-workspace-name --workspace <idx>` to name the trailing
    empty workspace on the current output without focus races.
    """
    wid = workspace_id_by_name(name)
    if wid is not None:
        if focus:
            niri_action("focus-workspace", name)
        return wid

    out = focused_output() or "DP-2"
    idx = trailing_empty_unnamed_idx(out)
    if idx is None:
        # No trailing empty (rare) — fall back to focus-workspace-down to
        # provoke niri into creating one, then look again.
        niri_action("focus-workspace-down")
        time.sleep(0.15)
        idx = trailing_empty_unnamed_idx(out)
    if idx is None:
        return -1
    niri_action("set-workspace-name", "--workspace", str(idx), name)
    time.sleep(0.15)
    if focus:
        niri_action("focus-workspace", name)
        time.sleep(0.1)
    return workspace_id_by_name(name) or -1


def snapshot_window_ids() -> set[int]:
    return {w["id"] for w in (niri_json("windows") or [])}


def spawn_and_wait(cmd: list[str], timeout: float = 9.0) -> int | None:
    """Spawn detached, wait for a new niri window to appear, return its id."""
    before = snapshot_window_ids()
    subprocess.Popen(
        ["setsid", *cmd],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(0.15)
        after = snapshot_window_ids()
        new = after - before
        if new:
            return next(iter(new))
    return None


def place_window(win_id: int | None, workspace: str) -> None:
    """Relocate a just-spawned window to `workspace` without following focus.
    niri only spawns onto the focused workspace, so background mode lets each
    window appear there briefly, then moves it off with `--focus false` — the
    caller's focus never leaves its current window."""
    if win_id is None:
        return
    niri_action("move-window-to-workspace", "--window-id", str(win_id),
                "--focus", "false", workspace)


def seed_claude_trust(worktree_path: Path) -> None:
    """Pre-seed Claude Code's per-project state for the worktree so the first
    session skips the trust + external-includes prompts (a worktree of the
    already-trusted main checkout carries the same content). Atomic rename to
    tolerate concurrent sessions rewriting ~/.claude.json."""
    cfg = Path(HOME) / ".claude.json"
    try:
        data = json.loads(cfg.read_text())
    except (OSError, json.JSONDecodeError):
        return
    entry = data.setdefault("projects", {}).setdefault(str(worktree_path), {})
    if entry.get("hasTrustDialogAccepted"):
        return
    entry.update({
        "hasTrustDialogAccepted": True,
        "hasCompletedProjectOnboarding": True,
        "hasClaudeMdExternalIncludesApproved": True,
    })
    tmp = cfg.with_name(".claude.json.wstmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(cfg)


def seed_env_local(worktree_path: Path) -> None:
    """Seed the main checkout's go/api/.env.local (gitignored, machine-specific
    API overrides — e.g. the dead-NATS workaround) into the worktree, so global
    env fixes never need re-applying per worktree. Seed-if-absent: an existing
    customized file is never clobbered."""
    src = LOVABLE_DIR / "go" / "api" / ".env.local"
    dst = worktree_path / "go" / "api" / ".env.local"
    if not src.is_file() or dst.exists():
        return
    try:
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(src.read_bytes())
        print("==> seeded go/api/.env.local from main checkout")
    except OSError as e:
        print(f"warn: could not seed .env.local: {e}", file=sys.stderr)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("name", help="worktree short name (creates branch daphen/<name>)")
    ap.add_argument("--mode", choices=["auto", "new", "resume", "fork"], default="auto",
                    help="auto (default): resume the worktree's latest claude "
                         "session if one exists, else start fresh")
    ap.add_argument("--session-id", default=None,
                    help="claude session id for resume/fork")
    ap.add_argument("--plan", action="store_true",
                    help="plan mode: open the worktree's nvim ready to manage the "
                         "ticket's plan (auto-opens .plans/<ticket>.md when it "
                         "lands). Default is bare mode — an ordinary stack.")
    ap.add_argument("--background", action="store_true",
                    help="build the stack on its workspace without switching focus "
                         "to it: the workspace is named but not focused, and each "
                         "window is relocated with niri's --focus false.")
    args = ap.parse_args()

    name = args.name
    branch = f"daphen/{name}"
    worktree_path = Path(HOME) / f"work/lovable.daphen-{name}"
    workspace = f"lovable-{name}"
    # Mirror Lovable's devenv sanitizeBranchForSubdomain: keep prefix +
    # at most 3 description segments. `daphen/1149-publish-state-picker`
    # registers as `daphen-1149-publish-state.localhost`.
    name_segments = name.split("-")[:3]
    subdomain = "daphen-" + "-".join(name_segments)
    preview_url = f"http://{subdomain}.localhost:2015"

    # 1. Create or switch to the worktree (using `wt`)
    if not worktree_path.is_dir():
        print(f"==> creating worktree {branch} (off fresh origin/main)")
        # Branch off remote main, not the local main ref, which can sit
        # thousands of commits stale and births broken worktrees (missing
        # generated files, build failures). Fetch first so origin/main is current.
        subprocess.run(["git", "fetch", "origin", "main"], cwd=str(LOVABLE_DIR))
        rc = subprocess.run(
            ["wt", "switch", "--create", "--base", "origin/main", branch],
            cwd=str(LOVABLE_DIR),
        ).returncode
        if rc != 0:
            print("wt switch --create failed", file=sys.stderr)
            return rc

    # Register the worktree with zoxide so `z <name>` reaches it immediately,
    # without needing a manual cd there first.
    subprocess.run(["zoxide", "add", str(worktree_path)], capture_output=True)

    # 2. Create the named workspace (focus it unless building in background)
    print(f"==> {'building' if args.background else 'focusing'} workspace {workspace}")
    ensure_workspace(workspace, focus=not args.background)

    # 3. Build the claude command. `auto` uses `claude --continue`, which
    #    resumes the worktree's most recent conversation when one exists and
    #    starts fresh otherwise. Letting claude resolve its own session store
    #    keeps this immune to changes in claude's on-disk layout — the script
    #    no longer re-derives session paths itself.
    mode, sid = args.mode, args.session_id
    if mode == "auto":
        # `claude --continue` no longer falls back to a fresh session when
        # the cwd has no conversation — it errors and exits, which killed
        # the pane on brand-new worktrees. Check claude's project dir for
        # the worktree (path munged with / and . -> -) and start fresh
        # when it's empty.
        proj = Path.home() / ".claude" / "projects" / re.sub(r"[/.]", "-", str(worktree_path))
        has_session = proj.is_dir() and any(proj.glob("*.jsonl"))
        claude_cmd = ["claude", "--continue"] if has_session else ["claude"]
    elif mode == "new":
        claude_cmd = ["claude"]
    elif mode == "resume":
        if not sid:
            print("--session-id required for resume", file=sys.stderr)
            return 2
        claude_cmd = ["claude", "--resume", sid]
    else:  # fork
        if not sid:
            print("--session-id required for fork", file=sys.stderr)
            return 2
        claude_cmd = ["claude", "--resume", sid, "--fork-session"]

    # 4. Spawn the 4 stack windows. They land as columns on the focused
    #    workspace; in background mode each is relocated off it (--focus false).
    print("==> spawning devenv wt --no-next")
    wid = spawn_and_wait([
        "kitty",
        "--working-directory", str(worktree_path),
        "-e", "bash", "-c", "direnv exec . devenv wt --no-next; exec fish",
    ])
    # Unconditional: spawns land on whatever workspace is focused at spawn
    # time, and user activity can steal focus mid-stack (windows then pile
    # into the wrong workspace). Explicit relocation is a no-op when focus
    # held.
    place_window(wid, workspace)

    # Browser-agnostic: route through browser-dispatch with an explicit
    # work-profile + new-window override. Switching default browser later
    # only requires editing browser-dispatch.
    print(f"==> spawning work browser (via browser-dispatch) → {preview_url}")
    wid = spawn_and_wait([
        "/home/daphen/.config/niri/scripts/browser-dispatch",
        "--profile=work",
        "--new-window",
        preview_url,
    ])
    # Unconditional: spawns land on whatever workspace is focused at spawn
    # time, and user activity can steal focus mid-stack (windows then pile
    # into the wrong workspace). Explicit relocation is a no-op when focus
    # held.
    place_window(wid, workspace)

    seed_claude_trust(worktree_path)
    seed_env_local(worktree_path)
    print(f"==> spawning claude session ({mode})")
    wid = spawn_and_wait([
        "kitty",
        "--class", "claude",
        "--working-directory", str(worktree_path),
        "-e", *claude_cmd,
    ])
    # Unconditional: spawns land on whatever workspace is focused at spawn
    # time, and user activity can steal focus mid-stack (windows then pile
    # into the wrong workspace). Explicit relocation is a no-op when focus
    # held.
    place_window(wid, workspace)

    print("==> spawning nvim" + (" (plan mode)" if args.plan else ""))
    # Plan mode only: plan-nvim auto-opens the ticket's plan once the agent's
    # /plan-ticket writes it. The flag is set INSIDE the command, not via kitty
    # --env (this kitty build has no such flag — it exits and the pane never opens).
    # Launch nvim through `direnv exec` so it inherits the devenv toolchain PATH
    # (Go, Node) instead of older system binaries.
    nvim_cmd = "direnv exec . nvim; exec fish"
    if args.plan:
        nvim_cmd = "PLAN_NVIM_OPEN=1 " + nvim_cmd
    nvim_id = spawn_and_wait([
        "kitty",
        "--working-directory", str(worktree_path),
        "-e", "bash", "-c", nvim_cmd,
    ])
    place_window(nvim_id, workspace)

    # Land focus on the new claude (col 3) so the user is at the prompt —
    # skipped in background mode, which deliberately leaves focus put.
    if not args.background and nvim_id is not None:
        target_ws_id = workspace_id_by_name(workspace)
        for w in (niri_json("windows") or []):
            if (w.get("app_id") == "claude"
                    and w.get("workspace_id") == target_ws_id):
                niri_action("focus-window", "--id", str(w["id"]))
                break

    print(f"==> stack '{name}' ready on workspace '{workspace}'")
    return 0


if __name__ == "__main__":
    sys.exit(main())
