#!/usr/bin/env python3
"""
agent-review <pr-num | github PR url> [--devenv]

Spin up a local PR review in the cockpit nvim agent rail — in the background,
never stealing focus:

  1. fetch the PR head and check it out on a `review/pr-<num>` branch in a
     worktree (the shape the review-pr pi skill auto-detects from the branch).
  2. start an agentd session for that worktree in the lovable-scope rail,
     seeded with `/review-pr <num>` — the skill runs its full review flow and
     writes the durable artifact. It appears in the rail roster to open when
     you're ready.
  --devenv also boots `devenv wt` for the worktree as a cockpit devenv tab, for
  PRs you want to actually run rather than just read.

Background by design: nothing is focused, no workspace is claimed. The old
the old 4-window ws-createreview flow is retired (heidr owns reviews).
"""
from __future__ import annotations
import argparse
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from agent_review_harness import (
    FULL_READINESS_TIMEOUT_SECONDS,
    HarnessPorts,
    ManualHarness,
    adopt_or_create_worktree,
    deterministic_path,
    teardown_context,
)

HOME = os.environ["HOME"]
LOVABLE_DIR = Path(HOME) / "work" / "lovable"
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
PR_URL_RE = re.compile(r"https?://github\.com/([^/]+)/([^/]+)/pull/(\d+)")


def detect_repo(pr_arg: str) -> Path:
    """The repo the PR belongs to — reviews are not lovable-only.

    A PR URL names its repo (find the local checkout); a bare number means the
    CALLER's repo (agent_review runs in the calling session's cwd). Lovable
    stays the fallback so every existing flow behaves exactly as before."""
    m = PR_URL_RE.search(pr_arg)
    if m:
        name = m.group(2)
        for cand in (Path(HOME) / "work" / name, Path(HOME) / "personal" / name):
            if (cand / ".git").exists():
                return cand
        if name == "lovable":
            return LOVABLE_DIR
        raise SystemExit(f"no local checkout found for repo {name!r} (looked in ~/work and ~/personal)")
    try:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, check=True, timeout=10).stdout.strip()
        # The caller's repo only owns this PR if gh can actually resolve it there. A
        # detached caller (the Super+r picker) inherits quickshell's cwd, so a lovable
        # PR was looked up in the cockpit repo and the review died with a traceback
        # nobody could see. Fall back to lovable when the number is not ours.
        if root and not root.startswith(str(LOVABLE_DIR)):
            probe = subprocess.run(["gh", "pr", "view", str(parse_pr(pr_arg)), "--json", "number"],
                                   capture_output=True, text=True, cwd=root, timeout=20)
            if probe.returncode != 0:
                return LOVABLE_DIR
        if root and not root.startswith(str(LOVABLE_DIR)):
            return Path(root)
    except Exception:
        pass
    return LOVABLE_DIR


REPO_DIR = LOVABLE_DIR   # resolved in main() once the PR arg is known
SCOPE = os.environ.get("AGENT_SCOPE", "lovable")


def scope_for_repo(repo: Path) -> str:
    if os.environ.get("AGENT_SCOPE"):
        return os.environ["AGENT_SCOPE"]
    return "personal" if str(repo).startswith(str(Path(HOME) / "personal")) else "lovable"


def notify(msg: str) -> None:
    subprocess.run(["notify-send", "-t", "2500", "PR review", msg],
                   capture_output=True)


def parse_pr(s: str) -> int:
    if s.isdigit():
        return int(s)
    m = PR_URL_RE.search(s)
    if m:
        # group(1)/group(2) are org/repo; the NUMBER is group(3). Reading group(1) made
        # every full PR URL die with "invalid literal for int(): 'lovablelabs'".
        return int(m.group(3))
    raise SystemExit(f"could not parse PR number from: {s!r}")


def slugify(title: str, max_segments: int = 3) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9]+", "-", title.lower()).strip("-")
    parts = [p for p in cleaned.split("-") if p][:max_segments]
    return "-".join(parts) or "pr"


def gh_pr_metadata(num: int) -> tuple[str, str]:
    result = subprocess.run(
        ["gh", "pr", "view", str(num), "--json", "title,headRefOid"],
        capture_output=True, text=True, cwd=str(REPO_DIR), timeout=30,
    )
    if result.returncode != 0:
        raise fail(result.stderr.strip() or f"GitHub could not resolve PR #{num}")
    data = json.loads(result.stdout)
    sha = data.get("headRefOid", "")
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise SystemExit(f"GitHub did not return an exact head SHA for PR #{num}")
    return data.get("title", ""), sha


def git_output(args: list[str], cwd: Path) -> str:
    return subprocess.run(
        ["git", "-C", str(cwd), *args], capture_output=True, text=True,
        check=True, timeout=30,
    ).stdout.strip()


def ensure_worktree(num: int, slug: str, sha: str) -> Path:
    result = subprocess.run(
        ["git", "-C", str(REPO_DIR), "fetch", "origin",
         "+refs/heads/main:refs/remotes/origin/main", f"pull/{num}/head"],
        capture_output=True, text=True, timeout=120,
    )
    if result.returncode != 0:
        raise fail(result.stderr.strip() or f"could not fetch PR #{num}")
    target = REPO_DIR.parent / f"{REPO_DIR.name}.review-{num}-{slug}"
    try:
        return adopt_or_create_worktree(REPO_DIR, num, sha, target)
    except RuntimeError as error:
        raise fail(str(error)) from error


def agentd_connect():
    """Connect to the scope's agentd, starting the daemon if the socket is down."""
    path = os.path.join(RUNTIME, f"agentd-{SCOPE}.sock")
    for attempt in range(30):
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(6)
            s.connect(path)
            return s
        except OSError:
            if attempt == 0:
                # Mirror the rail's own cold-start: spawn the daemon, then retry.
                subprocess.Popen(
                    ["agentd", "--scope", SCOPE, "--repo", str(LOVABLE_DIR)],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, start_new_session=True,
                )
            time.sleep(0.2)
    raise fail(f"could not reach agentd ({SCOPE}) at {path}")


def start_rail_session(sid: str, cwd: Path, prompt: str) -> None:
    s = agentd_connect()
    deadline = time.monotonic() + 10
    buf = b""
    try:
        s.sendall((json.dumps({"type": "spawn", "session": sid,
                               "cwd": str(cwd), "profile": "lovable-reviewer",
                               "prompt": prompt}) + "\n").encode())
        while time.monotonic() < deadline:
            s.settimeout(max(0.1, deadline - time.monotonic()))
            try:
                chunk = s.recv(65536)
            except socket.timeout:
                break
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if event.get("type") == "error" and event.get("session") == sid:
                    raise fail(str(event.get("error") or "agentd rejected the reviewer"))
                if event.get("type") != "roster":
                    continue
                for session in event.get("sessions", []):
                    if (session.get("name") == sid or session.get("id") == sid) and session.get("cwd") == str(cwd):
                        return
        raise fail(f"{sid} did not appear in the {SCOPE} rail roster")
    finally:
        s.close()


def boot_devenv(num: int, wt: Path) -> Path:
    state = Path(os.environ.get("XDG_STATE_HOME", Path(HOME) / ".local/state")) / "agent-review"
    state.mkdir(parents=True, exist_ok=True)
    log = state / f"review-pr-{num}-devenv.log"
    unit = f"agent-review-pr-{num}-devenv.service"

    active = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit],
        capture_output=True,
    ).returncode == 0
    if active:
        return log
    subprocess.run(["systemctl", "--user", "reset-failed", unit], capture_output=True)

    slice_down = Path(HOME) / ".local/bin/slice-down"
    if not os.access(slice_down, os.X_OK):
        raise SystemExit(f"could not start headless devenv: {slice_down} is unavailable")
    qwt = shlex.quote(str(wt))
    qlog = shlex.quote(str(log))
    qslice = shlex.quote(str(slice_down))
    cmd = (
        f"exec >>{qlog} 2>&1; "
        "echo \"[review] $(date -Is) starting headless devenv\"; "
        f"trap '{qslice} {qwt}' EXIT HUP TERM; "
        "[ -f .devenv/state/pnpm-lock.sha ] || { echo '[review] seeding pnpm…'; "
        "direnv exec . pnpm install && mkdir -p .devenv/state && "
        "sha256sum pnpm-lock.yaml | cut -d' ' -f1 > .devenv/state/pnpm-lock.sha; }; "
        "direnv exec . devenv wt"
    )
    result = subprocess.run(
        ["systemd-run", "--user", f"--unit={unit}", "--collect",
         f"--property=WorkingDirectory={wt}", "--property=Type=exec",
         "bash", "-c", cmd],
        capture_output=True, text=True, timeout=15,
    )
    if result.returncode != 0:
        raise SystemExit(f"could not start headless devenv: {result.stderr.strip()}")
    return log


def default_ports(_num: int) -> HarnessPorts:
    return HarnessPorts(
        browser=3000,
        browser_debug=9341,
        web_forward=51320,
        browser_api_forward=51302,
        compatibility_api_forward=8020,
        vm_web=51300,
        vm_api=51302,
    )


def fail(msg: str) -> "SystemExit":
    """Surface a fatal error where the caller can actually see it.

    The Super+r picker launches this detached, so a SystemExit printed to a dead
    stderr looked like "the review was added and then vanished". A desktop
    notification is the only channel a detached run shares with the user.
    """
    notify(f"review failed: {msg}"[:180])
    return SystemExit(msg)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("pr", nargs="?", help="PR number or github.com PR URL")
    ap.add_argument("--devenv", action="store_true",
                    help="also boot local devenv wt for the worktree")
    ap.add_argument("--manual-test", metavar="PROJECT_ID",
                    help="create the canonical VM-backed browser-test context")
    ap.add_argument("--browser-profile-seed", type=Path,
                    help="authenticated stopped Chromium profile cloned into the context")
    ap.add_argument("--allow-sandbox-start", action="store_true",
                    help="one bounded browser-flow sandbox start if no live iframe exists")
    ap.add_argument("--runtime-contract", choices=("production", "exact-branch"),
                    help="required manual-test runtime provenance: explicit production CDN or exact branch-built script_tag")
    ap.add_argument("--teardown", metavar="CONTEXT_ID",
                    help="stop and remove one owned manual-test context")
    ap.add_argument("--prepare-only", action="store_true",
                    help=argparse.SUPPRESS)
    a = ap.parse_args()

    if a.teardown:
        if a.pr or a.devenv or a.manual_test or a.browser_profile_seed or a.allow_sandbox_start or a.runtime_contract:
            ap.error("--teardown cannot be combined with PR startup options")
        try:
            teardown_context(Path(HOME), a.teardown)
        except RuntimeError as error:
            raise SystemExit(str(error)) from error
        print(f"{a.teardown}: owned services, links, and state removed")
        return 0
    if not a.pr:
        ap.error("PR is required unless --teardown is used")
    if (a.browser_profile_seed or a.allow_sandbox_start or a.runtime_contract) and not a.manual_test:
        ap.error("browser harness options require --manual-test PROJECT_ID")
    if a.manual_test and not a.runtime_contract:
        ap.error("--manual-test requires explicit --runtime-contract production|exact-branch")

    num = parse_pr(a.pr)
    global REPO_DIR, SCOPE
    REPO_DIR = detect_repo(a.pr)
    SCOPE = scope_for_repo(REPO_DIR)
    try:
        deterministic_path(Path(HOME))
    except RuntimeError as error:
        raise SystemExit(str(error)) from error
    notify(f"preparing PR #{num}…")
    title, sha = gh_pr_metadata(num)
    slug = slugify(title)
    wt = ensure_worktree(num, slug, sha)
    start_rail_session(f"review-pr-{num}", wt, f"/review-pr {num}")
    if a.devenv:
        boot_devenv(num, wt)
    harness = None
    if a.manual_test:
        ports = default_ports(num)
        harness = ManualHarness(
            home=Path(HOME), pr=num, expected_sha=sha, project_id=a.manual_test,
            worktree=wt, ports=ports,
            vm_host=os.environ.get("COCKPIT_VM_HOST", os.environ.get("HEIDR_VM_HOST", "dev-heidr-2a39.workstation.lovable.net")),
            vm_user=os.environ.get("COCKPIT_VM_USER", os.environ.get("HEIDR_VM_USER", "david_karlsson_lovable_dev")),
            browser_profile_seed=a.browser_profile_seed,
            allow_sandbox_start=a.allow_sandbox_start,
            runtime_contract=a.runtime_contract,
        )
        context = harness.write()
        if not a.prepare_only:
            try:
                harness.prepare_vm()
                harness.start()
                subprocess.run(shlex.split(context.readiness), check=True, timeout=FULL_READINESS_TIMEOUT_SECONDS)
            except (RuntimeError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
                raise SystemExit(f"manual-test context is not ready: {error}") from error
        print(f"{context.context_id}: context written at {harness.root}")
        print(f"readiness: {context.readiness}")
        print(f"teardown: {context.teardown}")
    notify(f"PR #{num} review is in the rail roster"
           + (" · manual-test context prepared" if harness else " · devenv booting" if a.devenv else ""))
    print(f"review-pr-{num}: session started in the {SCOPE} rail (cwd {wt})"
          + (" + manual-test harness" if harness else " + devenv" if a.devenv else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
