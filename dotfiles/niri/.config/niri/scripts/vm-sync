#!/usr/bin/env bash
# vm-sync <ticket> — keep a VM worktree and a REAL local git worktree in step.
#
# The local side must be a git worktree, not a bare mirror: gitsigns, hunk jumping and
# the nvim dashboard all ask git, and a mirror has no repository — mutagen must skip
# `.git` because in a worktree it is a FILE holding a VM-absolute gitdir.
#
#   1. local worktree at ~/work/lovable.daphen-<ticket>, DETACHED AT THE VM'S HEAD
#      (same base or every upstream commit between them shows up as a diff — the first
#      attempt at this reported 1937 changed files)
#   2. one-way seed from the VM, so the agent's work lands on that base
#   3. skip-worktree for LFS-tracked binaries: the VM holds real bytes and a fresh
#      checkout holds pointers, so copying makes ~470 assets look modified forever
#   4. a two-way-resolved mutagen session with the VM as alpha — the agent writes, you
#      read and edit, and the default two-way-safe mode merely STALLS on conflict
#
# Idempotent: re-run whenever the VM's HEAD moves (after the agent commits) to re-align.
set -euo pipefail

# --align <ticket>: fix ONLY the stale HEAD, touching no files.
#
# The mirror syncs files, not git history (.git is excluded by design — a worktree's .git
# is a file holding a VM-absolute gitdir), so when the VM commits or rebases, the local
# worktree holds the new content while HEAD still points at the ticket's original base.
# git then reports every upstream commit that came down as YOUR uncommitted diff: after
# one rebase onto main that read as 5376 files, +75629/-142555 in lualine.
#
# `git reset` (mixed) moves HEAD and the index and leaves the working tree alone, which is
# precisely the repair — no checkout --force, no clean, nothing destructible. Safe to run
# on every session switch, which is what the rail does.
if [ "${1:-}" = "--align" ]; then
  raw="${2:?usage: vm-sync --align <ticket>}"
  t=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
  u="${COCKPIT_VM_USER:-${HEIDR_VM_USER:-david_karlsson_lovable_dev}}"
  vm="${COCKPIT_VM:-${HEIDR_VM:-dev-heidr-2a39}}"
  host="${COCKPIT_VM_HOST:-${HEIDR_VM_HOST:-$vm.workstation.lovable.net}}"
  local_wt="$HOME/work/lovable.daphen-$t"
  [ -d "$local_wt" ] || exit 0
  # Self-heal missing mirror deps on every switch: mirrors created before the
  # vm-wt install fix (or whose install failed) leave ts_ls resolving nothing.
  # Guarded on node_modules absence, so the switch hot path stays free.
  # (the log's mtime debounces retries — one attempt per 10 min, so a failing
  # install can't re-fire on every switch, and a stuck one isn't doubled.)
  if [ -f "$local_wt/package.json" ] && [ ! -d "$local_wt/node_modules" ] \
     && ! find "$local_wt/.pnpm-install.log" -mmin -10 2>/dev/null | grep -q .; then
    (cd "$local_wt" && direnv allow . 2>/dev/null
     nohup direnv exec "$local_wt" pnpm install --frozen-lockfile --prefer-offline >"$local_wt/.pnpm-install.log" 2>&1 &)
  fi
  # Cheap LOCAL gate before any network. Routine agent work is small, so unless the diff is
  # pathological there is nothing to repair and we never touch the box.
  #
  # Measured against the FORK POINT, not HEAD. What the editor shows you (lualine, the
  # dashboard, hunk signs) is `git diff <merge-base with origin/main>`, and that is what
  # explodes: the box rebases the ticket onto a newer main, so every upstream commit that
  # came down counts as your work. Gating on `diff HEAD` missed it entirely — HEAD can be
  # perfectly aligned (1 file) while the editor reports 4612 files, +74252 -32174, which is
  # exactly the state this was supposed to catch.
  base=$(git -C "$local_wt" merge-base HEAD origin/main 2>/dev/null)
  changed=$(git -C "$local_wt" diff --name-only ${base:+"$base"} 2>/dev/null | wc -l)
  [ "${changed:-0}" -le 150 ] && exit 0
  # A stale trunk ref is half the problem: the fork point can only move forward once the
  # local origin/main knows about the commits the box rebased onto. Refresh it first — if
  # that alone fixes the base, the HEAD realign below is a no-op.
  git -C "$local_wt" fetch -q --no-tags origin main 2>/dev/null || true
  # Multiplex: a cold ssh costs 0.85-1.9s, far too much to hang off an interaction.
  # One persistent control socket takes the same check to ~0.04s.
  cm="${XDG_RUNTIME_DIR:-/tmp}/heidr-vm-cm"
  head=$(ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
           -o ControlMaster=auto -o ControlPath="$cm" -o ControlPersist=600 \
           -o ConnectTimeout=20 \
           "$u@$host" "git -C '/home/$u/src/lovable-$t' rev-parse HEAD" 2>/dev/null | tr -d '[:space:]')
  case "$head" in ''|*[!0-9a-f]*) exit 0;; esac          # unreachable box → leave it alone
  cur=$(git -C "$local_wt" rev-parse HEAD 2>/dev/null)
  [ "$cur" = "$head" ] && exit 0                          # already aligned
  # The commit may not be local yet (agent hasn't pushed): fetch it from the VM's clone,
  # which has the branch whether or not it ever reached GitHub.
  git -C "$local_wt" cat-file -e "${head}^{commit}" 2>/dev/null     || GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ControlPath=$cm" git -C "$local_wt" fetch -q "ssh://$u@$host/home/$u/src/lovable" "$head" 2>/dev/null     || git -C "$local_wt" fetch -q origin "$head" 2>/dev/null || exit 0
  git -C "$local_wt" reset -q "$head" || exit 0
  printf '[vm-sync] %s: HEAD %s -> %s (files untouched)\n' "$t" "${cur:0:11}" "${head:0:11}"
  exit 0
fi

raw="${1:?usage: vm-sync <ticket>   e.g. vm-sync EVERY-2741}"
t=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
u="${COCKPIT_VM_USER:-${HEIDR_VM_USER:-david_karlsson_lovable_dev}}"
vm="${COCKPIT_VM:-${HEIDR_VM:-dev-heidr-2a39}}"
host="${COCKPIT_VM_HOST:-${HEIDR_VM_HOST:-$vm.workstation.lovable.net}}"
vmwt="/home/$u/src/lovable-$t"
local_wt="$HOME/work/lovable.daphen-$t"
repo="$HOME/work/lovable"
name="vmwt-$t"
say() { printf '\033[36m[vm-sync]\033[0m %s\n' "$*"; }
SSH=(ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=25 "$u@$host")
mut=$(command -v mutagen || echo "")
[ -n "$mut" ] || { echo "✗ mutagen not on PATH"; exit 1; }

IGN=(--ignore=.git --ignore=node_modules --ignore=.devenv --ignore=.direnv
     --ignore=.wrangler --ignore='*.sqlite' --ignore='*.sqlite-shm' --ignore='*.sqlite-wal'
     --ignore=.next --ignore=.turbo --ignore=target --ignore=dist --ignore=__pycache__
     --ignore=.venv --ignore='bazel-*' --ignore='*.log'
     # LFS-tracked binaries: syncing them only produces permanent phantom modifications
     --ignore='*.png' --ignore='*.jpg' --ignore='*.jpeg' --ignore='*.gif' --ignore='*.webp'
     --ignore='*.ico' --ignore='*.icns' --ignore='*.pdf' --ignore='*.mp4'
     --ignore='*.woff' --ignore='*.woff2' --ignore='*.ttf'
     # …but pasted rail screenshots MUST cross: the blanket *.png above swallowed every
     # @.heidr-pastes reference, so the agent on the box saw a path with no file. Last
     # match wins in mutagen's ignore syntax, so this re-include takes precedence.
     --ignore='!.heidr-pastes/**')

vmhead=$("${SSH[@]}" "git -C '$vmwt' rev-parse HEAD" 2>/dev/null | tr -d '[:space:]')
[ -n "$vmhead" ] || { echo "✗ no worktree at $vmwt on $vm — run vm-wt $raw first"; exit 1; }
say "VM head: ${vmhead:0:11}"

say "pause sync while the checkout moves …"
"$mut" sync pause "$name" >/dev/null 2>&1 || true

git -C "$repo" cat-file -e "${vmhead}^{commit}" 2>/dev/null || {
  say "fetching that commit …"; git -C "$repo" fetch --quiet origin "$vmhead" 2>/dev/null || true; }

if [ -d "$local_wt/.git" ] || [ -f "$local_wt/.git" ]; then
  say "align $local_wt to the VM's base …"
  git -C "$local_wt" checkout --force --detach "$vmhead" >/dev/null 2>&1
  git -C "$local_wt" clean -qfd
else
  say "create local worktree $local_wt at the VM's base …"
  git -C "$repo" worktree add --detach "$local_wt" "$vmhead" 2>&1 | tail -1
fi

say "seed the agent's work one-way (rsync, so nothing bidirectional can eat it) …"
rsync -a \
  --exclude '.git' --exclude 'node_modules' --exclude '.devenv' --exclude '.direnv' \
  --exclude '.wrangler' --exclude '*.sqlite*' --exclude '.next' --exclude '.turbo' \
  --exclude 'target' --exclude 'dist' --exclude '__pycache__' --exclude '.venv' \
  --exclude '*.png' --exclude '*.jpg' --exclude '*.jpeg' --exclude '*.gif' \
  --exclude '*.webp' --exclude '*.ico' --exclude '*.icns' --exclude '*.pdf' \
  --exclude '*.mp4' --exclude '*.woff' --exclude '*.woff2' --exclude '*.ttf' \
  -e "ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null" \
  "$u@$host:$vmwt/" "$local_wt/" 2>&1 | grep -v '^Warning:' || true

# Any tracked binary that still reads as modified is an LFS pointer/bytes mismatch.
bins=$(cd "$local_wt" && git status --porcelain | awk '$1=="M"{print $2}' \
       | grep -iE '\.(png|jpg|jpeg|gif|webp|ico|icns|pdf|mp4|woff2?|ttf)$' || true)
if [ -n "$bins" ]; then
  printf '%s\n' "$bins" | (cd "$local_wt" && xargs -d '\n' git update-index --skip-worktree)
  say "  hid $(printf '%s\n' "$bins" | wc -l) LFS binaries from git status"
fi

if "$mut" sync list "$name" >/dev/null 2>&1; then
  say "resume sync …"; "$mut" sync resume "$name" >/dev/null 2>&1 || true
else
  say "create sync (two-way-resolved, VM wins) …"
  # Linux uses full-tree polling as its recursive-watch fallback; native path events still propagate immediately.
  "$mut" sync create --name="$name" --sync-mode=two-way-resolved --watch-polling-interval=60 "${IGN[@]}" \
    "$u@$host:$vmwt" "$local_wt" >/dev/null 2>&1 && say "  created" || say "  ✗ create failed"
fi

say "local diff vs the VM's base:"
git -C "$local_wt" status --porcelain | sed 's/^/    /' | head -20
git -C "$local_wt" diff --shortstat | sed 's/^/    /'
say "done — nvim gets gutter hunks and <C-g>j/k in $local_wt"
