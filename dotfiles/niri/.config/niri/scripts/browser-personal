#!/usr/bin/env bash
# Launch or focus the personal-profile browser window. Stateless: resolves
# the window live by app-id on every press (window-id caches go stale when
# ids are recycled across browser restarts, and once cross-focused profiles).

set -u

source "$(dirname "$0")/browser-config.sh"

resolve() {
    niri msg --json windows | CLS="$BROWSER_CLASS_PERSONAL" python3 -c "
import json, os, sys
ws = [w for w in json.load(sys.stdin) if w.get('app_id') == os.environ['CLS']]
if ws:
    print(min(w['id'] for w in ws))
" 2>/dev/null
}

target=$(resolve)
if [[ -n "$target" ]]; then
    niri msg action focus-window --id "$target"
    exit 0
fi

# No personal window — launch one.
"$BROWSER_BIN" \
    "${BROWSER_FLAGS[@]}" \
    --user-data-dir="$BROWSER_USER_DATA_PERSONAL" \
    --profile-directory="$BROWSER_PROFILE" \
    --class="$BROWSER_CLASS_PERSONAL" &

# Poll for it (up to 5s), then pin to the named "chat" workspace.
for i in $(seq 1 25); do
    sleep 0.2
    new_id=$(resolve)
    if [[ -n "$new_id" ]]; then
        niri msg action move-window-to-workspace \
            --window-id "$new_id" --focus false chat 2>/dev/null || true
        break
    fi
done
