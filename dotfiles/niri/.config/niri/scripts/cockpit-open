#!/usr/bin/env bash
# cockpit-open — ensure one kitty per configured window exists on the cockpit
# workspace. Idempotent: a window whose class is already present is left alone.
#
# Engine script: everything instance-specific comes from the config. See
# cockpit-add / cockpit-switch for the rest of the engine.
set -euo pipefail

CONFIG="${COCKPIT_CONFIG:-$HOME/.config/cockpit/config}"
[ -r "$CONFIG" ] || { echo "cockpit: no config at $CONFIG" >&2; exit 1; }
# shellcheck source=/dev/null
source "$CONFIG"
: "${COCKPIT_WORKSPACE:?config must set COCKPIT_WORKSPACE}"
: "${COCKPIT_WINDOWS:?config must set COCKPIT_WINDOWS}"

win_class() { printf 'cockpit-%s' "$1"; }
win_sock()  { printf '%s/kitty-cockpit-%s' "${XDG_RUNTIME_DIR:-/tmp}" "$1"; }

# Focus the configured workspace so spawns land on it (niri only ever spawns
# onto the focused workspace). First run has no such workspace yet — adopt the
# focused one under the configured name.
ensure_workspace() {
    if niri msg action focus-workspace "$COCKPIT_WORKSPACE" >/dev/null 2>&1; then
        return 0
    fi
    niri msg action set-workspace-name "$COCKPIT_WORKSPACE" >/dev/null
}

have_window() {
    niri msg --json windows | jq -e --arg c "$1" 'any(.[]; .app_id == $c)' >/dev/null
}

ensure_workspace

# Sequential with a map-wait per window: concurrent spawns race their niri
# mapping, so the column order would be random. COCKPIT_WINDOWS order IS the
# left-to-right layout. The socket check doubles as the callers' guarantee
# (cockpit-open && cockpit-add needs live sockets).
opened=()
for w in "${COCKPIT_WINDOWS[@]}"; do
    if have_window "$(win_class "$w")"; then
        continue
    fi
    setsid -f kitty \
        --class "$(win_class "$w")" \
        --listen-on "unix:$(win_sock "$w")" \
        >/dev/null 2>&1
    for _ in $(seq 50); do
        have_window "$(win_class "$w")" && [ -S "$(win_sock "$w")" ] && break
        sleep 0.1
    done
    opened+=("$w")
done

# niri drops names from empty workspaces, so the adopt-rename in
# ensure_workspace doesn't survive until a window exists — re-apply it now.
if [ ${#opened[@]} -gt 0 ]; then
    niri msg action set-workspace-name "$COCKPIT_WORKSPACE" >/dev/null 2>&1 || true
fi

if declare -F cockpit_post_open >/dev/null; then
    cockpit_post_open || true
fi

if [ ${#opened[@]} -eq 0 ]; then
    echo "cockpit: all windows already open on '$COCKPIT_WORKSPACE'"
else
    echo "cockpit: opened ${opened[*]} on '$COCKPIT_WORKSPACE'"
fi
