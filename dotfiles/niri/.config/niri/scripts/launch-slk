#!/usr/bin/env bash
# Launch slk (Slack TUI) in a dedicated kitty window with no padding —
# the global window_padding_width (30) wastes screen edge on a full-window
# TUI. Mirrors launch-endcord; the --class lets niri-jump-or-exec focus it.
# No cell-size override: kitty reports real per-monitor cell pixels via
# TIOCGWINSZ, so slk auto-sizes inline images per output. A fixed override
# only matched the laptop and stretched images on the external monitor.
exec kitty \
    --class slk \
    -o font_size=11 \
    -o window_padding_width=0 \
    -e slk
