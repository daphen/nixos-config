#!/usr/bin/env bash
# Summon slk to the CURRENT workspace and focus it, so checking Slack
# never yanks you to whatever workspace slk happens to live on. Launches
# slk (on the current workspace) if it isn't running yet.
set -euo pipefail
DIR="$(dirname "$0")"

win=$(niri msg --json windows | jq -r '[.[] | select(.app_id=="slk")][0].id // empty')
if [ -z "$win" ]; then
    exec "$DIR/launch-slk"
fi

# Reference the focused workspace by name when it has one (unambiguous
# across outputs), else by its index on the focused output.
ref=$(niri msg --json workspaces | jq -r '[.[] | select(.is_focused)][0] | (.name // (.idx|tostring))')
niri msg action move-window-to-workspace --window-id "$win" --focus false "$ref" || true
niri msg action focus-window --id "$win"
