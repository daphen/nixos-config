#!/usr/bin/env bash
# xdg-desktop-portal-termfilechooser wrapper: yazi in a floating kitty.
# Args: multiple directory save path out (per contrib/yazi-wrapper.sh)

multiple="$1" directory="$2" save="$3" path="$4" out="$5"

# Save mode: materialize the app's suggested filename as a placeholder so
# it's visible, hovered, and renamable (r) in yazi. Enter on it = save
# under that name; rename first to change the name.
created=""
if [ "$save" = "1" ] && [ -n "$path" ] && [ ! -e "$path" ]; then
    mkdir -p "$(dirname "$path")" && touch "$path" && created=1
fi

cmd=(yazi --chooser-file="$out")
[ "$directory" = "1" ] && cmd+=(--cwd-file="$out.1")
[ -n "$path" ] && cmd+=("$path")

kitty --class=file-chooser --title "Select file" -- "${cmd[@]}"

# Directory mode: plain quit-in-dir writes nothing to $out — promote the cwd
if [ "$directory" = "1" ] && [ ! -s "$out" ] && [ -s "$out.1" ]; then
    mv "$out.1" "$out"
fi
rm -f "$out.1"

# Drop the placeholder unless it was the actual pick (the app writes into
# it after we return) — covers cancel and picked-something-else.
if [ "$created" = "1" ] && [ ! -s "$path" ]; then
    chosen=$(head -n1 "$out" 2>/dev/null)
    [ "$chosen" = "$path" ] || rm -f "$path"
fi
