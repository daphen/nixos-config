#!/usr/bin/env bash
set -euo pipefail

instance="${1:-personal}"
case "$instance" in
  work|personal) ;;
  *) echo "cockpit-show: expected work or personal" >&2; exit 2 ;;
esac

wid=$(niri msg --json windows 2>/dev/null | python3 -c '
import json, sys
suffix = " · " + sys.argv[1]
windows = [w for w in json.load(sys.stdin)
           if (w.get("title") or "").startswith("cockpit-qs · ")
           and (w.get("title") or "").endswith(suffix)]
if not windows:
    raise SystemExit
focused = next((w for w in windows if w.get("is_focused")), None)
if focused is None:
    def stamp(w):
        t = w.get("focus_timestamp") or {}
        return (t.get("secs") or 0, t.get("nanos") or 0)
    focused = max(windows, key=stamp)
print(focused["id"])
' "$instance" 2>/dev/null || true)

if [ -n "$wid" ]; then
  exec niri msg action focus-window --id "$wid"
fi

exec "$HOME/.config/niri/scripts/cockpit-boot" "$instance"
