#!/usr/bin/env bash
# Launch or focus a work-profile browser window. Stateless: resolves live by
# app-id on every press (window-id caches went stale on id reuse and once
# cross-focused profiles). Work windows are per-worktree-stack, so selection
# is workspace-aware: prefer the active lovable stack's window, then any on a
# non-lovable workspace; never focus one on an INACTIVE lovable stack (that
# would yank niri to a parked worktree) — spawn a fresh window instead.
#
# First-time use: Chromium-derived browsers create the profile directory
# automatically when --profile-directory references a new name.

set -u

source "$(dirname "$0")/browser-config.sh"

ACTIVE_FILE="$HOME/.local/state/wt-stacks/ws/active"

resolve() {
    ACTIVE="$(cat "$ACTIVE_FILE" 2>/dev/null || true)" CLS="$BROWSER_CLASS_WORK" python3 -c '
import json, os, subprocess
cls = os.environ["CLS"]
active = os.environ.get("ACTIVE") or None
windows = json.loads(subprocess.run(["niri", "msg", "--json", "windows"],
                     capture_output=True, text=True).stdout)
workspaces = json.loads(subprocess.run(["niri", "msg", "--json", "workspaces"],
                        capture_output=True, text=True).stdout)
ws_name = {s["id"]: (s.get("name") or "") for s in workspaces}
cands = [(w["id"], ws_name.get(w.get("workspace_id"), "")) for w in windows
         if w.get("app_id") == cls]
on_active   = [i for i, n in cands if active and n == active]
off_lovable = [i for i, n in cands if not (n.startswith("lovable-") and n != "lovable")]
pick = on_active or off_lovable
if pick:
    print(min(pick))
' 2>/dev/null
}

target=$(resolve)
if [[ -n "$target" ]]; then
    niri msg action focus-window --id "$target"
    exit 0
fi

# Snapshot work windows before launch so we can spot the new one.
before=$(niri msg --json windows | CLS="$BROWSER_CLASS_WORK" python3 -c "
import json, os, sys
print(' '.join(str(w['id']) for w in json.load(sys.stdin)
               if w.get('app_id') == os.environ['CLS']))
" 2>/dev/null)

"$BROWSER_BIN" \
    "${BROWSER_FLAGS[@]}" \
    --user-data-dir="$BROWSER_USER_DATA_WORK" \
    --profile-directory="$BROWSER_PROFILE" \
    --class="$BROWSER_CLASS_WORK" &

# Poll for the new window (up to 5s); focus follows the spawn naturally.
for i in $(seq 1 25); do
    sleep 0.2
    new_id=$(niri msg --json windows | BEFORE="$before" CLS="$BROWSER_CLASS_WORK" python3 -c "
import json, os, sys
before = set(os.environ['BEFORE'].split())
for w in json.load(sys.stdin):
    if w.get('app_id') == os.environ['CLS'] and str(w['id']) not in before:
        print(w['id'])
        break
" 2>/dev/null)
    [[ -n "$new_id" ]] && break
done
