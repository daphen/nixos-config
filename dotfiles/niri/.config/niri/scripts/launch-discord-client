#!/usr/bin/env bash
# Launch the native QML Discord client. Ensures the dsqrd daemon is running
# (it serves data + live gateway events), then opens the Quickshell UI pointed
# at dsqrd's socket. niri-jump-or-exec focuses an existing window instead of
# calling this when one is already open.
export PATH="/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:$PATH"
pgrep -f 'dsqrd\.py' >/dev/null 2>&1 || \
    setsid nohup "$HOME/personal/dsqrd/run-dsqrd.sh" >/tmp/dsqrd.log 2>&1 </dev/null &
exec env SLK_SOCK=dsqrd qs -p "$HOME/personal/slk-gui-proto"
