#!/usr/bin/env bash
# cockpit-restore — rebuild the cockpit after a crash or reboot: open the
# windows, re-add every context in the state registry (agents resume their
# transcripts, devenv stacks reboot, nvim restores its saved session), and
# land on the context that was active when the machine died.
set -euo pipefail

CONFIG="${COCKPIT_CONFIG:-$HOME/.config/cockpit/config}"
[ -r "$CONFIG" ] || { echo "cockpit: no config at $CONFIG" >&2; exit 1; }
# shellcheck source=/dev/null
source "$CONFIG"
COCKPIT_STATE_DIR="${COCKPIT_STATE_DIR:-$HOME/.local/state/cockpit}"

here=$(dirname "$(readlink -f "$0")")
"$here/cockpit-open"

[ -f "$COCKPIT_STATE_DIR/contexts" ] || exit 0
while IFS= read -r name; do
    [ -n "$name" ] || continue
    "$here/cockpit-add" "$name" || echo "cockpit: restore of '$name' failed" >&2
done < "$COCKPIT_STATE_DIR/contexts"

active=$(cat "$COCKPIT_STATE_DIR/active" 2>/dev/null || true)
[ -n "$active" ] && exec "$here/cockpit-switch" "$active"
exit 0
