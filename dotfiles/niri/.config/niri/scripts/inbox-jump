#!/usr/bin/env bash
# Super+i → always open the notification-center picker: active notifications
# under "current", recently-dismissed under "earlier". Pick one to jump to
# its window/app.
#
# Always the picker (no auto-jump): notifications never expire here, so a
# single lingering one would otherwise make Super+i jump unpredictably.
# `--` so quickshell's IPC parses `show` as the function name, not a flag.
qs ipc call -- notification-jump show >/dev/null 2>&1 || true