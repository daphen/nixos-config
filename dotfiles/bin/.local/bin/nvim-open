#!/usr/bin/env python3
"""nvim-open <worktree-dir> <file> [line]

Open <file> (repo-relative or absolute) at [line] in the nvim already running
in <worktree-dir> — found by matching each server socket's process cwd, since
nvim auto-listens on $XDG_RUNTIME_DIR/nvim.<pid>.0.

No nvim there → spawn a kitty+nvim in the worktree AND place it on the
worktree's niri workspace (lovable-<name>), creating/naming that workspace if
needed. niri spawns onto the focused workspace, so without the explicit move
the window would land wherever the user happens to be.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = os.environ["HOME"]
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")


def niri_json(*args):
    try:
        out = subprocess.run(["niri", "msg", "--json", *args],
                             capture_output=True, text=True, timeout=3)
        return json.loads(out.stdout) if out.stdout.strip() else None
    except Exception:
        return None


def niri_action(*args):
    try:
        subprocess.run(["niri", "msg", "action", *args], capture_output=True, timeout=3)
    except Exception:
        pass


def find_socket(wt: str):
    for sock in Path(RUNTIME).glob("nvim.*.0"):
        pid = sock.name.split(".")[1]
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            continue
        if cwd == wt or cwd.startswith(wt + "/"):
            return str(sock)
    return None


def workspace_for(wt: str):
    """~/work/lovable.daphen-<name> → lovable-<name>; lovable.review-* → lovable-review-*."""
    base = os.path.basename(wt)
    if not base.startswith("lovable."):
        return None
    name = base[len("lovable."):]
    if name.startswith("daphen-"):
        name = name[len("daphen-"):]
    return f"lovable-{name}"


def workspace_id(name: str):
    for ws in (niri_json("workspaces") or []):
        if ws.get("name") == name:
            return ws["id"]
    return None


def ensure_workspace(name: str):
    """Name the trailing empty workspace on the focused output — never focuses it."""
    if workspace_id(name) is not None:
        return True
    fw = niri_json("focused-window") or {}
    ws_id = fw.get("workspace_id")
    output = None
    for w in (niri_json("workspaces") or []):
        if w["id"] == ws_id:
            output = w.get("output")
            break
    cands = [w for w in (niri_json("workspaces") or [])
             if (output is None or w.get("output") == output)
             and w.get("name") is None and w.get("active_window_id") is None]
    if not cands:
        return False
    idx = max(c["idx"] for c in cands)
    niri_action("set-workspace-name", "--workspace", str(idx), name)
    time.sleep(0.15)
    return workspace_id(name) is not None


def window_ids():
    return {w["id"] for w in (niri_json("windows") or [])}


def main() -> int:
    if len(sys.argv) < 3:
        print("usage: nvim-open <worktree-dir> <file> [line]", file=sys.stderr)
        return 2
    wt = sys.argv[1].rstrip("/")
    file_arg = sys.argv[2]
    line = sys.argv[3] if len(sys.argv) > 3 else "1"
    abs_path = file_arg if file_arg.startswith("/") else f"{wt}/{file_arg}"

    sock = find_socket(wt)
    if sock:
        # <C-\><C-N> forces normal mode; :edit +line jumps; zz centers.
        subprocess.run(["nvim", "--server", sock, "--remote-send",
                        f"<C-\\><C-N>:edit +{line} {abs_path}<CR>zz"])
        return 0

    # Fallback: fresh kitty+nvim in the worktree, placed on its workspace.
    before = window_ids()
    subprocess.Popen(
        ["setsid", "kitty", "--working-directory", wt,
         "-e", "bash", "-c",
         f"direnv exec . nvim +{line} '{abs_path}' || nvim +{line} '{abs_path}'"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True)

    ws = workspace_for(wt)
    if not ws:
        return 0
    new_id = None
    deadline = time.time() + 8
    while time.time() < deadline:
        time.sleep(0.15)
        new = window_ids() - before
        if new:
            new_id = new.pop()
            break
    if new_id is not None and ensure_workspace(ws):
        niri_action("move-window-to-workspace", "--window-id", str(new_id),
                    "--focus", "false", ws)
    return 0


if __name__ == "__main__":
    sys.exit(main())
