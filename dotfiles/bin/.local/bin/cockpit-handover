#!/usr/bin/env python3
"""
cockpit-handover vm|local — move the ORCHESTRATOR role between proart and the
work VM, atomically with its watchdog goal.

  vm     leaving:  local `lovable` stands down; a `orchestrator` session on the
         work daemon takes over (spawned if absent), seeded with the goal + the
         local orchestrator's recent context, goal re-pinned there.
  local  returning: the reverse.

Run while the work tunnel is up (i.e. before closing the laptop / after
opening it). Exactly ONE orchestrator holds the goal afterwards — the other is
explicitly stood down so the two never drive the same workers.
"""
import json, os, socket, subprocess, sys, time

RT = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
VM_CWD = "/home/david_karlsson_lovable_dev/src/lovable"

# The RECORDED role holder — "lovable" (proart) or "work" (the VM). Only a completed
# handover writes it, so the role moves when David toggles and at no other time.
# Inferring it from "whoever holds an armed goal" meant a goal clearing silently
# reassigned the orchestrator to the other machine: on 2026-08-26 the rail showed the
# local session as the orchestrator, with the VM's workers listed underneath it.
HOLDER_FILE = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "cockpit", "orchestrator-holder")


def recorded_holder():
    try:
        with open(HOLDER_FILE) as fh:
            value = fh.read().strip()
        return value if value in ("lovable", "work") else None
    except OSError:
        return None


def record_holder(scope):
    os.makedirs(os.path.dirname(HOLDER_FILE), exist_ok=True)
    tmp = HOLDER_FILE + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(scope + "\n")
    os.replace(tmp, HOLDER_FILE)

def dial(scope):
    s = socket.socket(socket.AF_UNIX)
    s.connect(os.path.join(RT, f"agentd-{scope}.sock"))
    s.settimeout(3)
    return s

def send(s, obj):
    s.sendall((json.dumps(obj) + "\n").encode())

def roster(scope):
    s = dial(scope)
    buf, t0 = b"", time.time()
    while time.time() - t0 < 3:
        try: buf += s.recv(1 << 20)
        except socket.timeout: break
    s.close()
    for line in buf.decode(errors="replace").splitlines():
        try: m = json.loads(line)
        except ValueError: continue
        if m.get("type") == "roster":
            return {x.get("name"): x for x in m.get("sessions", [])}
    return {}

def read_tail(ref, n=8):
    try:
        out = subprocess.run(["agent", "read", ref, str(n)], capture_output=True,
                             text=True, timeout=20).stdout
        return out[-6000:] if out else ""
    except Exception:
        return ""

HANDOFF_PROMPT = (
    "HANDOVER PREP: the orchestrator role is about to move to another host. "
    "Reply with a COMPLETE handoff document — your reply IS the handoff the successor "
    "receives, so write it for an orchestrator with no transcript access. Sections: "
    "1) Goal state (verbatim goal + how far along); "
    "2) Each worker: name, exact current state, last verified evidence, what it was told; "
    "3) Decisions in force (approvals given, constraints, things explicitly forbidden); "
    "4) Pending actions with owners (worker/orchestrator/David); "
    "5) Gotchas a successor would trip on. "
    "Also save the same content to the vault handoffs/ folder if you have vault access. "
    "End the turn after the document — no tool work beyond the optional vault write."
)

def status_of(scope, name):
    return (roster(scope).get(name) or {}).get("status", "")

def request_handoff(scope, name):
    """Ask the outgoing orchestrator to author its own handoff; fall back to a
    transcript tail if it cannot deliver within the window."""
    s = dial(scope)
    send(s, {"type": "prompt", "session": name, "message": HANDOFF_PROMPT})
    s.close()
    saw_work = False
    deadline = time.time() + 300
    while time.time() < deadline:
        st = status_of(scope, name)
        if st == "streaming":
            saw_work = True
        elif saw_work and st == "idle":
            doc = read_tail(name, 1)
            if len(doc) > 400:
                return doc
            break
        time.sleep(5)
    print("note: handoff authoring timed out/thin — falling back to transcript tail", file=sys.stderr)
    return read_tail(name, 8)

# What the incoming host can and cannot PROVE. Delivery work (code, CI, git, PRs,
# tickets) is location-independent; verification is not — only proart has a browser
# authenticated for the sandbox origin and the local devenv lane the branch runtime is
# served from. A remote orchestrator that does not know this claims verdicts it cannot
# support (the conditional PASS of 2026-08-25), so the boundary ships WITH the role.
CAPABILITIES = {
    "lovable": (
        "CAPABILITIES HERE (proart, local): you have David's authenticated Helium work "
        "profile on CDP 127.0.0.1:9333 — the only session authenticated for BOTH "
        "localhost:2015 and the *.lovableproject-dev.com sandbox origin — plus the local "
        "devenv lane serving the branch runtime on :8001. So in-browser certification IS "
        "yours: DOM-only measurement, no keyboard input, clicks only on named canvas "
        "elements. "
    ),
    "work": (
        "CAPABILITIES HERE (dev VM): delivery ONLY. You have no display, no browser "
        "session authenticated for the sandbox origin, and no local devenv lane, so "
        "in-browser certification is IMPOSSIBLE from here — never claim a browser verdict. "
        "Code, CI, rebases, PRs, reviews and tickets are all yours. Leave anything needing "
        "a real browser to the local orchestrator and hand it a verified-vs-pending list. "
    ),
}


def holder():
    """Which side holds the role. The RECORD wins; inference is only a first-run seed."""
    recorded = recorded_holder()
    if recorded:
        return recorded
    sides = [("lovable", "lovable"), ("work", "orchestrator")]
    live = []
    for scope, name in sides:
        entry = roster(scope).get(name)
        if not entry:
            continue
        live.append((scope, name, bool(entry.get("goal")), entry.get("status")))
    armed = [x for x in live if x[2]]
    if len(armed) == 1:
        return armed[0][0]
    if armed:
        return None  # both armed: ambiguous, refuse rather than guess
    awake = [x for x in live if x[3] not in ("asleep", None)]
    if len(awake) == 1:
        return awake[0][0]
    return None


def handover(src_scope, src_name, dst_scope, dst_name, dst_cwd, label):
    src = roster(src_scope).get(src_name) or {}
    goal = src.get("goal") or ""
    if not goal:
        print(f"note: {src_name} holds no goal — handing over context only")
    print("asking the outgoing orchestrator to author its handoff (up to ~5 min)…")
    context = request_handoff(src_scope, src_name)

    # 1. Stand the source down BEFORE the target drives (never two drivers).
    s = dial(src_scope)
    send(s, {"type": "set_goal", "session": src_name, "goal": ""})
    send(s, {"type": "prompt", "session": src_name, "message":
             f"HANDOVER: the orchestrator role moves to {label} now. Stand down — "
             "do not dispatch, steer, or answer workers until a handover returns the role. "
             "Acknowledge in one line and end the turn."})
    s.close()

    # 2. Ensure the target session exists, seed it, move the goal.
    dst = roster(dst_scope)
    d = dial(dst_scope)
    seed = ("HANDOVER: you are taking over as THE orchestrator (the other host stood down). "
            "Re-read your plan/progress artifacts and agent_read every worker before acting. "
            + (f"The standing goal follows as your pinned watchdog goal: {goal} " if goal else "")
            + CAPABILITIES[dst_scope]
            + "The outgoing orchestrator's handoff document follows:\n" + context)
    if dst_name not in dst:
        send(d, {"type": "spawn", "session": dst_name, "cwd": dst_cwd,
                 "profile": "lovable-orchestrator", "prompt": seed})
    else:
        send(d, {"type": "prompt", "session": dst_name, "message": seed})
    time.sleep(2)
    if goal:
        send(d, {"type": "set_goal", "session": dst_name, "goal": goal})
    d.close()

    # 3. Verify the goal landed. Poll: set_goal is async on the daemon side, so a single
    # immediate read reported a false negative on a handover that had in fact worked.
    ok = True
    if goal:
        ok = False
        for _ in range(10):
            if (roster(dst_scope).get(dst_name) or {}).get("goal"):
                ok = True
                break
            time.sleep(1)
    # The role has actually moved now — record it. Everything that displays or toggles
    # the role reads this file, so nothing else can reassign the role behind David's back.
    record_holder(dst_scope)
    print(f"handover → {label}: {'goal pinned, driving' if ok and goal else 'seeded'}"
          f" ({dst_scope}:{dst_name}); {src_name} stood down")
    if goal and not ok:
        print("WARNING: goal did not verify on the target — re-run or pin manually", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "--status":
        rec = recorded_holder()
        where = {"lovable": "proart (local)", "work": "the VM"}.get(rec)
        if where:
            print(f"orchestrator role: {where}  [recorded in {HOLDER_FILE}]")
        else:
            print("orchestrator role: NOT RECORDED — the next toggle or handover will set it")
        for scope, name in (("lovable", "lovable"), ("work", "orchestrator")):
            e = roster(scope).get(name)
            if e:
                print(f"  {scope}:{name} status={e.get('status')} "
                      f"goal={'armed' if e.get('goal') else 'none'}")
        sys.exit(0)
    if mode == "--set":
        # Adopt reality without performing a handover (seeding, or after a manual fix).
        target = sys.argv[2] if len(sys.argv) > 2 else ""
        if target not in ("lovable", "work"):
            sys.exit("usage: cockpit-handover --set lovable|work")
        record_holder(target)
        print(f"recorded orchestrator role: {target} (no handover performed)")
        sys.exit(0)
    if mode in ("", "toggle"):
        # No argument = flip to the other side. Direction is derived from who holds the
        # role, so the same keypress works in both directions.
        here = holder()
        if here is None:
            sys.exit("cockpit-handover: cannot tell which side holds the role "
                     "(none armed, or both) — run explicitly: cockpit-handover vm|local")
        mode = "vm" if here == "lovable" else "local"
        print(f"toggle: role is on {'proart' if here == 'lovable' else 'the VM'} → moving to "
              f"{'the VM' if mode == 'vm' else 'proart'}")
    if mode == "vm":
        handover("lovable", "lovable", "work", "orchestrator", VM_CWD, "the VM orchestrator")
    elif mode == "local":
        handover("work", "orchestrator", "lovable", "lovable", os.path.expanduser("~/work/lovable"), "the local orchestrator")
    else:
        sys.exit("usage: cockpit-handover [vm|local|--status|--set lovable|work]   (no argument = toggle)")
