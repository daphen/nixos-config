#!/usr/bin/env python3
"""
cockpit-handover vm|local — move the ORCHESTRATOR role between proart and the
work VM, atomically with its watchdog goal.

  vm     leaving:  local `lovable` stands down; a `orchestrator` session on the
         work daemon takes over (spawned if absent), seeded with the goal + the
         local orchestrator's recent context, goal re-pinned there.
  local  returning: the reverse.

Run while the work tunnel is up (i.e. before closing the laptop / after
opening it). Exactly ONE orchestrator holds the goal afterwards — the other is
explicitly stood down so the two never drive the same workers.
"""
import json, os, socket, subprocess, sys, time

RT = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
VM_CWD = "/home/david_karlsson_lovable_dev/src/lovable"

def dial(scope):
    s = socket.socket(socket.AF_UNIX)
    s.connect(os.path.join(RT, f"agentd-{scope}.sock"))
    s.settimeout(3)
    return s

def send(s, obj):
    s.sendall((json.dumps(obj) + "\n").encode())

def roster(scope):
    s = dial(scope)
    buf, t0 = b"", time.time()
    while time.time() - t0 < 3:
        try: buf += s.recv(1 << 20)
        except socket.timeout: break
    s.close()
    for line in buf.decode(errors="replace").splitlines():
        try: m = json.loads(line)
        except ValueError: continue
        if m.get("type") == "roster":
            return {x.get("name"): x for x in m.get("sessions", [])}
    return {}

def read_tail(ref, n=8):
    try:
        out = subprocess.run(["agent", "read", ref, str(n)], capture_output=True,
                             text=True, timeout=20).stdout
        return out[-6000:] if out else ""
    except Exception:
        return ""

def handover(src_scope, src_name, dst_scope, dst_name, dst_cwd, label):
    src = roster(src_scope).get(src_name) or {}
    goal = src.get("goal") or ""
    context = read_tail(src_name if src_scope != "work" else src_name)
    if not goal:
        print(f"note: {src_name} holds no goal — handing over context only")

    # 1. Stand the source down BEFORE the target drives (never two drivers).
    s = dial(src_scope)
    send(s, {"type": "set_goal", "session": src_name, "goal": ""})
    send(s, {"type": "prompt", "session": src_name, "message":
             f"HANDOVER: the orchestrator role moves to {label} now. Stand down — "
             "do not dispatch, steer, or answer workers until a handover returns the role. "
             "Acknowledge in one line and end the turn."})
    s.close()

    # 2. Ensure the target session exists, seed it, move the goal.
    dst = roster(dst_scope)
    d = dial(dst_scope)
    seed = ("HANDOVER: you are taking over as THE orchestrator (the other host stood down). "
            "Re-read your plan/progress artifacts and agent_read every worker before acting. "
            + (f"The standing goal follows as your pinned watchdog goal: {goal} " if goal else "")
            + "Recent context from the outgoing orchestrator:\n" + context)
    if dst_name not in dst:
        send(d, {"type": "spawn", "session": dst_name, "cwd": dst_cwd,
                 "profile": "lovable-orchestrator", "prompt": seed})
    else:
        send(d, {"type": "prompt", "session": dst_name, "message": seed})
    time.sleep(2)
    if goal:
        send(d, {"type": "set_goal", "session": dst_name, "goal": goal})
    d.close()

    # 3. Verify the goal landed.
    ok = bool((roster(dst_scope).get(dst_name) or {}).get("goal")) if goal else True
    print(f"handover → {label}: {'goal pinned, driving' if ok and goal else 'seeded'}"
          f" ({dst_scope}:{dst_name}); {src_name} stood down")
    if goal and not ok:
        print("WARNING: goal did not verify on the target — re-run or pin manually", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "vm":
        handover("lovable", "lovable", "work", "orchestrator", VM_CWD, "the VM orchestrator")
    elif mode == "local":
        handover("work", "orchestrator", "lovable", "lovable", os.path.expanduser("~/work/lovable"), "the local orchestrator")
    else:
        sys.exit("usage: cockpit-handover vm|local")
