#!/usr/bin/env bash
# cockpit-spawn <name> [prompt...] — the FULL ticket kickoff, in one command, callable
# by any agent (or the rail's Enter-on-ticket). Three halves, ordered by essentialness:
#   1. worktree  — cockpit_context_create (idempotent): the branch+worktree off fresh
#      origin/main. The one worktree-coupled step; it lives in the cockpit layer, not
#      the agent layer (`agent spawn` just takes a real dir).
#   2. rail agent — `agent spawn <dir>` seeds a ROSTER AGENT in that worktree so it
#      shows up in the rail and starts working. The essential half.
#   3. tabs      — cockpit-add --no-switch opens the devenv (`devenv wt`) + nvim rail
#      tabs. BEST-EFFORT: a tab hiccup must never cost you the agent. Focus stays put.
#
# <name> is the context/worktree short-name (keeps the ticket prefix, e.g.
# every-1234-fix-thing). Pass --oneshot to make the agent ephemeral (run once, report,
# exit); omit for a persistent session.
set -euo pipefail

oneshot=""
args=()
for a in "$@"; do
  if [ "$a" = "--oneshot" ]; then oneshot="--oneshot"; else args+=("$a"); fi
done
set -- "${args[@]}"

name=${1:?usage: cockpit-spawn <name> [prompt...] [--oneshot]}
shift || true
prompt="$*"

SCRIPTS="$HOME/.config/niri/scripts"
CONFIG="${COCKPIT_CONFIG:-$HOME/.config/cockpit/config}"
# shellcheck source=/dev/null
source "$CONFIG"

# 1) worktree (idempotent — the helper no-ops if the dir already exists).
cockpit_context_create "$name"
dir=$(cockpit_context_dir "$name")
[ -d "$dir" ] || { echo "cockpit-spawn: no worktree dir for '$name' ($dir)" >&2; exit 1; }

# 2) rail agent in that worktree — the essential half.
agent spawn "$dir" ${prompt:+"$prompt"} --name "$name" $oneshot

# 3) cockpit tabs — BEST-EFFORT (worktree already exists, so this just adds tabs).
"$SCRIPTS/cockpit-add" --no-switch "$name" \
  || echo "cockpit-spawn: context/tabs step had issues — the rail agent is still up" >&2

echo "cockpit-spawn: $name — rail agent up (context tabs attempted)"
