#!/usr/bin/env python3
"""
wt-send <name> <message...>

Inject a prompt into whatever agent is driving a worktree — agent-agnostic.

First hop (preferred): if an agentd daemon supervises a pi session whose cwd
matches the worktree (the nvim agent rail's backend), send the prompt straight
to it over the daemon socket.

Fallback: inject into a worktree's running Claude TUI as if the user typed it.
Each kitty process listens on /tmp/kitty-<pid>; we iterate every socket,
`kitten @ ls` each one, pick the window whose foreground process is `claude`
with cwd inside `~/work/lovable.daphen-<name>`, and `send-text` + Enter.

No daemon, no per-session state, no special kitty config beyond
`allow_remote_control yes` (already set).

Usage:
  wt-send 1234              # read message from stdin
  wt-send 1234 "review pr"  # message as args
  wt-send --list            # list active worktree claude windows

Exit codes:
  0  delivered
  1  no matching window found (worktree's kitty isn't running, or
     claude isn't the foreground process)
  2  usage error
"""
from __future__ import annotations
import argparse
import glob
import json
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

HOME = Path(os.environ["HOME"])
WORKTREE_ROOT = HOME / "work"


def try_agentd(cwd_target: str, text: str) -> bool:
    """Agent-agnostic first hop: if an agentd daemon supervises a pi session whose
    cwd matches cwd_target, send the prompt straight to it (the nvim agent rail's
    backend) and return True. Falls through to the claude-in-kitty path otherwise.

    agentd greets each new connection with its roster, so we connect to every
    agentd-<scope>.sock, read the roster, and match a session by cwd."""
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    if not rt:
        return False
    target = str(Path(cwd_target).expanduser().resolve())
    for sock_path in sorted(glob.glob(rt + "/agentd-*.sock")):
        try:
            c = socket.socket(socket.AF_UNIX)
            c.settimeout(2.0)
            c.connect(sock_path)
        except OSError:
            continue
        try:
            buf = b""
            sid = None
            deadline = time.time() + 2.0
            while sid is None and time.time() < deadline:
                try:
                    chunk = c.recv(65536)
                except OSError:
                    break
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        obj = json.loads(line)
                    except ValueError:
                        continue
                    if obj.get("type") != "roster":
                        continue
                    for s in obj.get("sessions", []):
                        scwd = str(s.get("cwd", "") or "")
                        if scwd and (scwd == target
                                     or target.startswith(scwd)
                                     or scwd.startswith(target)):
                            sid = s.get("id") or s.get("name")
                            break
            if sid:
                c.sendall((json.dumps(
                    {"type": "prompt", "session": sid, "message": text}) + "\n").encode())
                time.sleep(0.3)  # let the daemon flush to pi's stdin before we close
                return True
        finally:
            c.close()
    return False


def list_kitty_sockets() -> list[str]:
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    socks = glob.glob("/tmp/kitty-*")
    if rt:
        socks += glob.glob(rt + "/kitty-*")
    return sorted(socks)


def kitten_ls(sock: str) -> list | None:
    """Run `kitten @ --to unix:<sock> ls`. Returns the parsed JSON or
    None on any failure (socket dead, no permission, kitty restarted)."""
    try:
        out = subprocess.run(
            ["kitten", "@", "--to", f"unix:{sock}", "ls"],
            capture_output=True, text=True, timeout=1.5,
        )
        if out.returncode != 0 or not out.stdout.strip():
            return None
        return json.loads(out.stdout)
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError):
        return None


def is_claude(fp: dict) -> bool:
    cmd = fp.get("cmdline") or []
    if not cmd:
        return False
    return Path(cmd[0]).name == "claude"


def find_claude_window(worktree_prefix: str) -> tuple[str, int] | None:
    """Return (socket_path, window_id) for the first kitty window whose
    foreground process is `claude` running under `worktree_prefix`."""
    for sock in list_kitty_sockets():
        data = kitten_ls(sock)
        if not data:
            continue
        for ow in data:
            for tab in ow.get("tabs", []):
                for w in tab.get("windows", []):
                    for fp in w.get("foreground_processes", []):
                        cwd = fp.get("cwd", "")
                        if is_claude(fp) and cwd.startswith(worktree_prefix):
                            return (sock, w["id"])
    return None


def list_active_worktrees() -> list[tuple[str, str, int]]:
    """Scan every kitty socket and report any window that looks like a
    worktree claude session. Returns [(name, socket, window_id)]."""
    out: list[tuple[str, str, int]] = []
    pat = re.compile(
        rf"^{re.escape(str(WORKTREE_ROOT))}/lovable\.daphen-([^/]+)"
    )
    for sock in list_kitty_sockets():
        data = kitten_ls(sock)
        if not data:
            continue
        for ow in data:
            for tab in ow.get("tabs", []):
                for w in tab.get("windows", []):
                    for fp in w.get("foreground_processes", []):
                        if not is_claude(fp):
                            continue
                        m = pat.match(fp.get("cwd", "") or "")
                        if m:
                            out.append((m.group(1), sock, w["id"]))
                            break
    return out


def send_text(sock: str, window_id: int, text: str) -> int:
    """send-text to the matched window, then submit by sending Enter as
    a key event. Splitting text and key avoids any bracketed-paste
    handling: Claude treats key events as a real keypress."""
    text_rc = subprocess.run(
        ["kitten", "@", "--to", f"unix:{sock}",
         "send-text", "--match", f"id:{window_id}", "--", text],
        capture_output=True, text=True, timeout=3,
    ).returncode
    if text_rc != 0:
        return text_rc
    return subprocess.run(
        ["kitten", "@", "--to", f"unix:{sock}",
         "send-key", "--match", f"id:{window_id}", "enter"],
        capture_output=True, text=True, timeout=3,
    ).returncode


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("name", nargs="?",
                    help="worktree name (e.g. 1234-fix-button)")
    ap.add_argument("message", nargs="*",
                    help="message text; if omitted, read from stdin")
    ap.add_argument("--list", action="store_true",
                    help="list active worktree claude windows and exit")
    ap.add_argument("--cwd", default=None, metavar="PATH",
                    help="target the claude window running under PATH (any repo), "
                         "instead of a worktree name — message via stdin")
    ap.add_argument("--no-submit", action="store_true",
                    help="send the text but don't press Enter")
    ap.add_argument("--wait", type=float, default=0.0, metavar="SEC",
                    help="retry until the worktree's claude window appears, "
                         "up to SEC seconds (use right after ws-createwt, while "
                         "claude is still booting)")
    ap.add_argument("--settle", type=float, default=0.0, metavar="SEC",
                    help="after the window is found, wait SEC before sending so "
                         "the TUI is ready for input (avoids dropping an early send)")
    args = ap.parse_args()

    if args.list:
        actives = list_active_worktrees()
        if not actives:
            print("(no active worktree claude windows found)")
            return 0
        for name, sock, wid in actives:
            print(f"{name:<40} {sock}  window={wid}")
        return 0

    if args.cwd:
        worktree_prefix = str(Path(args.cwd).expanduser().resolve())
    else:
        if not args.name:
            ap.error("worktree name required (or pass --cwd / --list)")
        worktree_prefix = str(WORKTREE_ROOT / f"lovable.daphen-{args.name}")
        if not Path(worktree_prefix).is_dir():
            print(f"wt-send: worktree dir does not exist: {worktree_prefix}",
                  file=sys.stderr)
            return 1

    if args.message:
        text = " ".join(args.message)
    else:
        text = sys.stdin.read().rstrip("\n")

    if not text:
        print("wt-send: empty message; nothing to send", file=sys.stderr)
        return 2

    # Agent-agnostic: prefer a pi session (agent rail) driving this cwd; the
    # claude-in-kitty path below is the fallback for worktrees without one.
    if try_agentd(worktree_prefix, text):
        print(f"wt-send: delivered to the agent session for {worktree_prefix}")
        return 0

    match = find_claude_window(worktree_prefix)
    if match is None and args.wait > 0:
        deadline = time.time() + args.wait
        while match is None and time.time() < deadline:
            time.sleep(0.5)
            match = find_claude_window(worktree_prefix)
    if match is None:
        target = args.cwd if args.cwd else f"worktree '{args.name}'"
        print(f"wt-send: no running claude window for {target}", file=sys.stderr)
        return 1

    if args.settle > 0:
        time.sleep(args.settle)

    sock, window_id = match
    if args.no_submit:
        rc = subprocess.run(
            ["kitten", "@", "--to", f"unix:{sock}",
             "send-text", "--match", f"id:{window_id}", "--", text],
            capture_output=True, text=True, timeout=3,
        ).returncode
    else:
        rc = send_text(sock, window_id, text)

    if rc == 0:
        print(f"wt-send: delivered to '{args.name}' "
              f"(kitty {sock} window {window_id})")
    else:
        print(f"wt-send: send-text failed (rc={rc})", file=sys.stderr)
    return rc


if __name__ == "__main__":
    sys.exit(main())
