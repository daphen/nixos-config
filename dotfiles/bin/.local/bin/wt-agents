#!/usr/bin/env python3
"""
wt-agents — list the active agent sessions across every agentd scope.

One line per session: scope · status · name · cwd. This is how an agent (or the
orchestrator) discovers who else is running before dispatching (wt-send) or
reading (wt-read) their context. agentd greets each connection with its roster,
so we just connect to every $XDG_RUNTIME_DIR/agentd-<scope>.sock and read it.
"""
from __future__ import annotations
import glob
import json
import os
import socket
import sys
import time


def roster(sock_path: str) -> list:
    try:
        c = socket.socket(socket.AF_UNIX)
        c.settimeout(2.0)
        c.connect(sock_path)
    except OSError:
        return []
    try:
        buf = b""
        deadline = time.time() + 2.0
        while time.time() < deadline:
            try:
                chunk = c.recv(65536)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if obj.get("type") == "roster":
                    return obj.get("sessions", [])
        return []
    finally:
        c.close()


def main() -> int:
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    found = False
    for sock_path in sorted(glob.glob(rt + "/agentd-*.sock")):
        scope = os.path.basename(sock_path)[len("agentd-"):-len(".sock")]
        for s in roster(sock_path):
            found = True
            print("{:8} {:10} {:42} {}".format(
                scope,
                str(s.get("status", "?")),
                str(s.get("name", "?")),
                str(s.get("cwd", "")),
            ))
    if not found:
        print("no active agent sessions", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
