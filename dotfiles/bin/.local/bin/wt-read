#!/usr/bin/env python3
"""
wt-read <name|cwd|worktree> [N]

Print another agent's last N (default 6) user+assistant turns — so an agent, or
the orchestrator, can read what a busy worktree agent is doing WITHOUT
interrupting it. The companion to wt-send (dispatch) and wt-agents (discover).

Resolution of the arg, in order:
  1. a real directory  → that cwd
  2. an active agentd session whose name / id / cwd matches (asks the daemons)
  3. a lovable worktree shorthand (~/work/lovable.daphen-<arg> or .<arg>)
Then reads the newest pi session JSONL for that cwd
(~/.pi/agent/sessions/--<cwd, / → ->--/*.jsonl) — the same file pi --continue
resumes.
"""
from __future__ import annotations
import glob
import json
import os
import socket
import sys
import time
from pathlib import Path

HOME = os.environ["HOME"]


def roster_sessions(sock_path: str) -> list:
    try:
        c = socket.socket(socket.AF_UNIX)
        c.settimeout(2.0)
        c.connect(sock_path)
    except OSError:
        return []
    try:
        buf = b""
        deadline = time.time() + 2.0
        while time.time() < deadline:
            try:
                chunk = c.recv(65536)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                if o.get("type") == "roster":
                    return o.get("sessions", [])
        return []
    finally:
        c.close()


def resolve_cwd(arg: str) -> str | None:
    p = Path(arg).expanduser()
    if p.is_dir():
        return str(p.resolve())
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    for sp in sorted(glob.glob(rt + "/agentd-*.sock")):
        for s in roster_sessions(sp):
            name = str(s.get("name", "") or "")
            cwd = str(s.get("cwd", "") or "")
            if s.get("id") == arg or arg in name or arg in cwd:
                return cwd or None
    for cand in sorted(glob.glob(f"{HOME}/work/lovable*{arg}*")):
        if Path(cand).is_dir():
            return cand
    return None


def session_file(cwd: str):
    enc = "--" + cwd.strip("/").replace("/", "-") + "--"
    d = Path(HOME) / ".pi" / "agent" / "sessions" / enc
    if not d.is_dir():
        return None
    files = sorted(d.glob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True)
    return files[0] if files else None


def text_of(msg: dict) -> str:
    c = msg.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(
            b.get("text", "") for b in c
            if isinstance(b, dict) and b.get("type") == "text"
        )
    return ""


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: wt-read <name|cwd|worktree> [N]", file=sys.stderr)
        return 2
    arg = sys.argv[1]
    n = int(sys.argv[2]) if len(sys.argv) > 2 else 6
    cwd = resolve_cwd(arg)
    if not cwd:
        print(f"wt-read: no agent / worktree matching {arg!r}", file=sys.stderr)
        return 1
    f = session_file(cwd)
    if not f:
        print(f"wt-read: no pi session for {cwd}", file=sys.stderr)
        return 1
    turns = []
    for line in open(f):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        m = o.get("message") or {}
        if m.get("role") in ("user", "assistant"):
            t = text_of(m).strip()
            if t:
                turns.append((m["role"], t))
    print(f"# {cwd}")
    print(f"# {f.name}  ·  last {min(n, len(turns))} of {len(turns)} turns\n")
    for role, t in turns[-n:]:
        print(("▶ you:" if role == "user" else "◀ agent:") + "\n" + t + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
