#!/usr/bin/env python3
"""Open a plan in the existing Cockpit binding; never create another terminal.

The repo argument is retained for callers, not used to guess an editor.
"""
import json
import os
import subprocess
import sys
from pathlib import Path


def run(args, timeout=3):
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "command failed")
    return result.stdout.strip()


def binding():
    wanted_socket = os.environ.get("COCKPIT_NVIM_SOCK") or os.environ.get("HEIDR_NVIM_SOCK")
    session = os.environ.get("COCKPIT_AGENT_NAME") or os.environ.get("HEIDR_AGENT_NAME")
    if not wanted_socket and not session:
        raise RuntimeError("no Cockpit binding supplied; use open_in_nvim from the agent or COCKPIT_NVIM_SOCK from Neovim")
    matches = []
    for instance in json.loads(run(["qs", "list", "-a", "--json"])):
        if not instance.get("pid") or not instance.get("id"):
            continue
        prefix = ["qs", "ipc", "-i", instance["id"], "call", "cockpit"]
        try:
            if not wanted_socket:
                state = json.loads(run(prefix + ["railState"]))
                if state.get("sel") != session:
                    continue
            sock = run(prefix + ["nvimSock"])
            if not sock.startswith("/") or (wanted_socket and sock != wanted_socket):
                continue
            matches.append((prefix, sock))
        except (RuntimeError, ValueError, subprocess.TimeoutExpired):
            continue
    if len(matches) != 1:
        raise RuntimeError(f"expected one Cockpit showing this session, found {len(matches)}; no editor changed")
    return matches[0]


def main():
    if len(sys.argv) != 3:
        print("usage: plan-open <repo> <planfile>", file=sys.stderr)
        return 2
    try:
        plan = str(Path(sys.argv[2]).expanduser().resolve())
        if not Path(plan).is_file():
            raise RuntimeError(f"plan not found: {plan}")
        prefix, sock = binding()
        lua = "vim.cmd.CockpitEdit(" + json.dumps(plan) + "); return vim.api.nvim_buf_get_name(0)"
        expression = "luaeval(" + json.dumps("(function() " + lua + " end)()") + ")"
        opened = run(["nvim", "--server", sock, "--remote-expr", expression])
        if opened != plan:
            raise RuntimeError(f"editor did not open the requested plan; it still shows {opened!r}")
        focus = run(prefix + ["focusLeft"])
        if focus not in ("passed", "consumed"):
            raise RuntimeError(f"could not focus the bound editor: {focus}")
        current = run(["nvim", "--server", sock, "--remote-expr", "luaeval('vim.api.nvim_buf_get_name(0)')"])
        if current != plan:
            raise RuntimeError("the requested plan is no longer the visible Neovim buffer")
        print(f"Opened {plan} in {sock}")
        return 0
    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
        print(f"plan-open: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
