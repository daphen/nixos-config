#!/usr/bin/env bash
# wt-plan <name>: create a worktree stack in PLAN mode and dispatch
# /plan-ticket into its fresh claude session.
#
# Self-synchronizing: wt-send --wait blocks until the new claude window is up
# and --settle lets the TUI become input-ready, so the orchestrator never needs
# a manual "the worktree spawned, go ahead" handshake.
#
# Bare worktrees don't go through this — just run `ws-createwt <name>`.
set -euo pipefail

WS_CREATEWT="$HOME/.config/niri/scripts/ws-createwt"
WT_SEND="$HOME/.local/bin/wt-send"

name="${1:-}"
if [[ -z "$name" ]]; then
	echo "usage: wt-plan <worktree-name>   (e.g. 1234-fix-button)" >&2
	exit 2
fi

# Linear ticket id from the name: first 2+ digit run -> EVERY-<n>.
if [[ "$name" =~ ([0-9]{2,}) ]]; then
	ticket="EVERY-${BASH_REMATCH[1]}"
else
	echo "wt-plan: no ticket number in '$name' (expected e.g. 1234-slug)" >&2
	exit 2
fi

echo "==> wt-plan: $name  →  $ticket"
"$WS_CREATEWT" --plan "$name"
"$WT_SEND" --wait 45 --settle 2 "$name" "/plan-ticket $ticket"
