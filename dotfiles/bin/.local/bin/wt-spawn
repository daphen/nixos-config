#!/usr/bin/env python3
"""
wt-spawn <dir|worktree-name> [prompt...] [--create] [--scope <scope>]

Start a NEW agent session — a fresh roster item in the rail — for a directory,
so the orchestrator can stand up per-ticket agents directly instead of you
spinning them up by hand. Sends agentd's `spawn` (+ an optional seed prompt)
over the socket; the session shows up in the rail roster.

Target resolution:
  - an existing directory     → spawn there
  - a lovable worktree name    → ~/work/lovable.daphen-<name>; with --create it's
                                created off fresh origin/main if missing
Scope defaults to the dir's world (~/work/lovable → lovable, ~/personal →
personal, else lovable); override with --scope or $AGENT_SCOPE.

The companion to wt-send (talk), wt-read (read), wt-agents (discover).
"""
from __future__ import annotations
import argparse
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

HOME = os.environ["HOME"]
LOVABLE = Path(HOME) / "work" / "lovable"
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"


def resolve_dir(arg: str, create: bool) -> Path:
    p = Path(arg).expanduser()
    if p.is_dir():
        return p.resolve()
    wt = Path(HOME) / f"work/lovable.daphen-{arg}"
    if wt.is_dir():
        return wt
    if create:
        # Off fresh origin/main, never the local ref — mirrors cockpit_context_create.
        subprocess.run(["git", "-C", str(LOVABLE), "fetch", "origin", "main"], check=True)
        rc = subprocess.run(
            ["wt", "switch", "--create", "--base", "origin/main", f"daphen/{arg}"],
            cwd=str(LOVABLE),
        ).returncode
        if rc != 0 or not wt.is_dir():
            raise SystemExit(f"wt-spawn: could not create worktree for {arg!r}")
        subprocess.run(["zoxide", "add", str(wt)], capture_output=True)
        return wt
    raise SystemExit(
        f"wt-spawn: {arg!r} is not a directory and no worktree exists — pass --create to make one")


def scope_for(d: Path, override: str | None) -> str:
    if override:
        return override
    env = os.environ.get("AGENT_SCOPE")
    if env:
        return env
    s = str(d)
    if s == str(LOVABLE) or s.startswith(str(LOVABLE) + ".") or s.startswith(str(LOVABLE) + "/"):
        return "lovable"
    if s.startswith(str(Path(HOME) / "personal")):
        return "personal"
    return "lovable"


def scope_repo(scope: str) -> str:
    return str(LOVABLE) if scope == "lovable" else str(Path(HOME) / "personal")


def agentd_connect(scope: str):
    path = os.path.join(RUNTIME, f"agentd-{scope}.sock")
    for attempt in range(30):
        try:
            c = socket.socket(socket.AF_UNIX)
            c.settimeout(6)
            c.connect(path)
            return c
        except OSError:
            if attempt == 0:
                subprocess.Popen(
                    ["agentd", "--scope", scope, "--repo", scope_repo(scope)],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, start_new_session=True,
                )
            time.sleep(0.2)
    raise SystemExit(f"wt-spawn: could not reach agentd ({scope}) at {path}")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("target", help="directory or lovable worktree name")
    ap.add_argument("prompt", nargs="*", help="optional seed prompt for the new agent")
    ap.add_argument("--create", action="store_true", help="create the worktree if missing")
    ap.add_argument("--scope", help="agentd scope (default: inferred from the dir)")
    ap.add_argument("--name", help="session name (default: the dir basename)")
    a = ap.parse_args()

    d = resolve_dir(a.target, a.create)
    scope = scope_for(d, a.scope)
    name = a.name or d.name  # default matches the rail's own `.` (basename) convention
    prompt = " ".join(a.prompt).strip()

    c = agentd_connect(scope)
    try:
        c.sendall((json.dumps({"type": "spawn", "session": name, "cwd": str(d)}) + "\n").encode())
        if prompt:
            c.sendall((json.dumps({"type": "prompt", "session": name, "message": prompt}) + "\n").encode())
        try:
            c.shutdown(socket.SHUT_WR)
        except OSError:
            pass
        time.sleep(0.5)  # let the daemon spawn + flush the prompt to pi's stdin
    finally:
        c.close()

    print(f"spawned '{name}' in the {scope} rail (cwd {d})" + (" + seeded prompt" if prompt else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
