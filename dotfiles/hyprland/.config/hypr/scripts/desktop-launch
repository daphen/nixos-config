#!/usr/bin/env bash
set -euo pipefail
(( $# )) || { echo 'Usage: desktop-launch <command> [args...]' >&2; exit 2; }
# The bar's launch placeholder lives only while the command runs: launch-or-focus commands exit without a new window.
if [[ -z ${DESKTOP_LAUNCH_NO_PLACEHOLDER:-} ]]; then
    qs ipc call -- launch show "$$" "$*" >/dev/null 2>&1 & shown=$!
    rc=0; DESKTOP_LAUNCH_NO_PLACEHOLDER=1 "$0" "$@" || rc=$?
    wait "$shown" || true
    qs ipc call -- launch done "$$" >/dev/null 2>&1 || true
    exit "$rc"
fi
unset DESKTOP_LAUNCH_NO_PLACEHOLDER
if [[ ${HYPR_CANVAS_PROFILE:-} != deck ]]; then
    exec "$@"
fi
# The Deck radial palette is an X11 Quickshell; its launches must not inherit xcb, or dictation can't paste into them.
export QT_QPA_PLATFORM=wayland
case ${1##*/} in
    kitty) set -- "$1" --override font_size=11 "${@:2}" ;;
    deck-cockpit|cockpit-qs) export COCKPIT_FONT_PX=14 COCKPIT_DECK=1 ;;
esac
slice=deck-work.slice
case ${1##*/} in
    steam|deck-gaming-mode) slice=app.slice ;;
esac
if [[ $(< /proc/self/cgroup) == *"/$slice/"* ]]; then
    exec "$@"
fi
if [[ $slice == app.slice ]]; then
    unit="desktop-launch-$BASHPID-$RANDOM.scope"
    exec systemd-run --user --scope --collect --quiet --unit="$unit" --slice="$slice" -- "$@"
fi
exec 8>"${XDG_RUNTIME_DIR:?}/deck-gaming-mode.lock"
flock 8
state=$(systemctl --user show "$slice" -p FreezerState --value 2>/dev/null) || state=
if [[ $slice == deck-work.slice && ( $state == frozen || $state == frozen-by-parent ) ]]; then
    flock -u 8
    sleep 0.1
    DESKTOP_LAUNCH_NO_PLACEHOLDER=1 exec "$0" "$@"
fi
unit="desktop-launch-$BASHPID-$RANDOM.scope"
(exec 8>&-; exec systemd-run --user --scope --collect --quiet --unit="$unit" --slice="$slice" -- "$@") &
runner=$!
while kill -0 "$runner" 2>/dev/null &&
    [[ $(systemctl --user show "$unit" -p ActiveState --value 2>/dev/null) != active ]]; do sleep 0.01; done
flock -u 8
wait "$runner"
