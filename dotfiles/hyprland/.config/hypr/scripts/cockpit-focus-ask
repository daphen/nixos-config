#!/usr/bin/env bash
set -euo pipefail
scope="${1:?scope}"
session="${2:?session}"
case "$scope" in
  personal) want=personal ;;
  *) want=work ;;
esac

rows=""
while IFS= read -r qid; do
  [ -n "$qid" ] || continue
  title=$(timeout 2 qs ipc -i "$qid" call cockpit title 2>/dev/null | tail -1 || true)
  mode=$(timeout 2 qs ipc -i "$qid" call cockpit scopeMode 2>/dev/null | tail -1 || true)
  [ -n "$title" ] || continue
  rows+="$qid"$'\t'"$mode"$'\t'"$title"$'\n'
done < <(qs list -a --json 2>/dev/null | python3 -c '
import json, sys
try:
    print("\n".join(x["id"] for x in json.load(sys.stdin) if x.get("pid") and x.get("id")))
except Exception:
    pass
')

  pick=$(hyprctl -j clients 2>/dev/null | CANDIDATES="$rows" WANT_MODE="$want" python3 -c '
import json, os, sys
entries = [tuple(line.split("\t", 2)) for line in os.environ.get("CANDIDATES", "").splitlines() if line.count("\t") == 2]
windows = json.load(sys.stdin)
by_title = {w.get("title") or "": w for w in windows}
live = [(qid, mode, title, by_title[title]) for qid, mode, title in entries if title in by_title]
matching = [x for x in live if x[1] == os.environ.get("WANT_MODE")]
pool = matching or live
if not pool: raise SystemExit
qid, mode, title, window = min(pool, key=lambda x: x[3].get("focusHistoryID", 999999))
print("{}\t{}\t{}".format(qid, window.get("address", ""), int(not matching)))
' 2>/dev/null || true)

if [ -z "$pick" ]; then
  exit 1
fi
IFS=$'\t' read -r qid wid switch <<< "$pick"
  "$(dirname -- "$0")/hypr-dispatch" focuswindow "address:$wid" >/dev/null 2>&1 || true
if [ "$switch" = 1 ]; then
  timeout 3 qs ipc -i "$qid" call cockpit switchScope >/dev/null
fi
exec timeout 3 qs ipc -i "$qid" call cockpit selectSession "$session"
