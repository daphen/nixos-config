#!/usr/bin/env bash
# Power button on the Deck: black session lock + screen off without suspending, so audio keeps playing.
set -u
config="$HOME/.config/quickshell/pocket-lock"
# A press during the slow pre-sleep step must not lock over the suspend in progress.
flock -n "$XDG_RUNTIME_DIR/deck-suspend.lock" true 2>/dev/null || exit 0

if qs -p "$config" ipc call -- pocket unlock >/dev/null 2>&1; then
    hyprctl dispatch 'hl.dsp.dpms({action="on"})' >/dev/null
    exit 0
fi

setsid -f qs -p "$config" >/dev/null 2>&1 </dev/null
for _ in $(seq 40); do
    qs -p "$config" ipc show >/dev/null 2>&1 && break
    sleep 0.05
done
hyprctl dispatch 'hl.dsp.dpms({action="off"})' >/dev/null
