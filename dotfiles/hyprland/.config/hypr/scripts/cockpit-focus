#!/usr/bin/env bash
# cockpit-focus <window> — focus a cockpit window by its short name (agent /
# nvim / devenv), i.e. the window whose app_id is cockpit-<window>. Focuses
# the cockpit workspace first so it works from anywhere.
set -euo pipefail

w=${1:?usage: cockpit-focus <agent|nvim|devenv>}

CONFIG="${COCKPIT_CONFIG:-$HOME/.config/cockpit/config}"
# shellcheck source=/dev/null
[ -r "$CONFIG" ] && source "$CONFIG"

    address=$(hyprctl -j clients | jq -r --arg c "cockpit-$w" \
        '[.[] | select(.class == $c)][0].address // empty')
    [ -n "$address" ] && "$(dirname -- "$0")/hypr-dispatch" focuswindow "address:$address" >/dev/null 2>&1 || true
