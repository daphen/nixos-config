#!/usr/bin/env bash
set -euo pipefail

before=$(hyprctl -j activewindow | jq -r '.address // empty')
"$(dirname -- "$0")/hypr-dispatch" layoutmsg "focus j" >/dev/null
after=$(hyprctl -j activewindow | jq -r '.address // empty')
if [[ -n "$before" && "$after" == "$before" ]]; then
    "$(dirname -- "$0")/hypr-dispatch" focusmonitor d >/dev/null
fi
