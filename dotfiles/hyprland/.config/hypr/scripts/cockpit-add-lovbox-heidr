#!/usr/bin/env bash
# cockpit-rail-lovbox <name> — one command for a remote lovbox dev Cockpit.
#
# Claims/reuses a lovbox, provisions agentd, reshapes it to lean `devenv deps`,
# opens an SSH tunnel that ALSO runs agentd, bridged to a LOCAL UNIX SOCKET
# (Quickshell.Socket is unix-only, not TCP), then launches cockpit-qs against it.
# Per-ticket work = git worktrees + `devenv wt` inside the box, driven from the rail.
#
# Verified end-to-end 2026-08-12 (roster push received over the tunnel). Hard-won
# facts baked in below:
#   * The public gateway sandcastle.lovable.net:2222 is NOT reachable from proart —
#     tunnel to the DIRECT pod host (first `ssh -p 2222 lovable@…` line of
#     `lovbox ssh --no-ssh`), which routes over the tailnet.
#   * agentd does NOT survive a plain backgrounded `lovbox exec` (the pod reaps the
#     process tree on channel close) — start it with setsid so it detaches, and keep
#     the tunnel a PURE `-L` forward. Running agentd AS the ssh command (the earlier
#     design) meant every dropped connection killed the daemon too, which happened
#     three times on 2026-08-12 and left the rail silently empty.
#   * autossh supervises the tunnel and is declared in home.packages; plain ssh is
#     the fallback (no auto-reconnect).
#
# `--resume` skips claim/provision/reshape and just re-establishes agentd + tunnel +
# mutagen + the rail. Use it after a dropped connection or a laptop suspend.
set -euo pipefail

resume=""
if [ "${1:-}" = "--resume" ]; then resume=1; shift; fi
name="${1:-cockpit}"
box="lovbox-${name}"
lb="$HOME/work/lovable/bin/lovbox"
port=8790
sock="${XDG_RUNTIME_DIR}/agentd-work.sock"
say() { printf '\033[36m[cockpit-lovbox]\033[0m %s\n' "$*"; }

if [ -n "$resume" ]; then
  say "resume mode — skipping claim/provision/reshape"
else
# ── 1. claim / resume the box ────────────────────────────────────────────────
say "claim/reuse $box (paid) …"
"$lb" create "$box" --if-exists reuse >/dev/null

# ── 2. provision agentd + pi + gcc (idempotent) ──────────────────────────────
say "provision gcc + pi + agentd in-box …"
# gcc: `devenv wt` needs a cgo compiler. Do NOT use `nix profile install` — in this
# image ~/.nix-profile points at the SYSTEM profile (/nix/var/nix/profiles/default)
# and the install does not persist there. Symlink the gcc-wrapper store path into
# ~/.local/bin, which IS on the login PATH.
tar czf - -C "$HOME/personal/agentd" --exclude=.git . | base64 -w0 | "$lb" exec "$box" -- bash -lc '
  mkdir -p ~/.local/bin
  if ! command -v gcc >/dev/null 2>&1; then
    g=""
    for p in $(nix build --no-link --print-out-paths nixpkgs#gcc 2>/dev/null); do
      [ -x "$p/bin/gcc" ] && g="$p" && break
    done
    [ -n "$g" ] && for t in gcc g++ cc c++ cpp; do
      [ -x "$g/bin/$t" ] && ln -sf "$g/bin/$t" ~/.local/bin/$t
    done
  fi
  command -v pi  >/dev/null 2>&1 || npm i -g @earendil-works/pi-coding-agent >/dev/null 2>&1
  mkdir -p ~/.local/bin ~/agentd-src; base64 -d | tar xzf - -C ~/agentd-src
  cd ~/agentd-src && CGO_ENABLED=0 go build -o ~/.local/bin/agentd .' >/dev/null
say "  agentd built ✓"

# ── 3. reshape: stop the heavy auto-`up` (frees RAM) ─────────────────────────
# The box auto-boots the FULL stack (devenv up, ~30 GB). Tear it down (frees ~24 GB)
# so per-ticket `devenv wt` slices fit. This is quick and safe over exec.
#
# NOT done here: booting a persistent lean `devenv deps`. A daemon started via
# `lovbox exec` is reaped when the exec channel closes (same reason agentd runs on
# the tunnel connection, not as a detached process) — and an ad-hoc `devenv deps`
# also stalls on "waiting for process 7" without the box entrypoint's env. The
# working model instead: the agent/pi sessions (running under the tunnelled agentd)
# start `devenv wt` per worktree as part of their own work, inside the box, where
# they persist for the life of the agentd connection. See OPEN ITEM in the report.
say "reshape: keep the shared deps, stop app + observability bloat …"
# NEVER `process-compose down` — process-compose IS the container entrypoint
# (tini → lovbox-entrypoint.sh → process-compose). Stopping it drops the pod's main
# process and killed every ssh session (verified 2026-08-12: it took agentd with it).
# Stop individual processes instead.
#
# The split below is measured from the box's own process-compose API, not guessed:
#   KEEP  temporal(458M) connector-gateway(532M) redis(18M) redis-oauth(16M)
#         developer-cert-refresh(7M)   ← exactly what `devenv wt` needs
#   STOP  grafana(857M) ai-gateway(719M) prometheus(214M) otel-collector(193M)
#         typegen(15M) web api internal-api          ≈ 2.0 GB reclaimed
# ai-gateway/typegen are redundant on purpose: every `devenv wt` slice starts its OWN
# copies on its own ports, and build tracing ships to the remote otel gateway.
"$lb" exec "$box" -- bash -lc '
  export PATH="$HOME/.local/bin:$PATH"; cd ~/lovable 2>/dev/null || exit 0
  for p in web api internal-api ai-gateway typegen grafana prometheus otel-collector; do
    timeout 20 process-compose process stop "$p" >/dev/null 2>&1 && echo "  stopped $p" || true
  done' 2>/dev/null | grep -E "stopped" || say "  (already lean)"
fi   # end non-resume provisioning

# ── 4. resolve the DIRECT pod ssh host (gateway is unreachable from proart) ───
# `lovbox ssh --no-ssh` is intermittently empty when called right after other
# lovbox commands (it recompiles via `go run` each time) — retry, pipefail-safe.
say "resolve direct pod ssh host …"
direct=""
for attempt in 1 2 3 4 5; do
  direct=$("$lb" ssh --name "$box" --no-ssh 2>/dev/null \
    | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' \
    | awk '/ssh -p 2222 lovable@/ {print $NF; exit}' || true)
  [ -n "$direct" ] && break
  say "  (resolve attempt $attempt empty, retrying …)"
  sleep 2
done
[ -n "$direct" ] || { echo "✗ could not resolve direct ssh host from 'lovbox ssh --no-ssh' after 5 tries"; exit 1; }
say "  $direct"

# The pod host resolves via the tailnet and is intermittently flaky ("Could not
# resolve hostname" killed one run). Wait for DNS before trying to tunnel.
dhost="${direct#*@}"
for attempt in 1 2 3 4 5 6 7 8; do
  getent hosts "$dhost" >/dev/null 2>&1 && break
  say "  (DNS for pod host not ready, attempt $attempt …)"
  sleep 3
done
getent hosts "$dhost" >/dev/null 2>&1 || { echo "✗ pod host does not resolve — tailnet DNS issue (check: tailscale status)"; exit 1; }

# ── 5. agentd in-box (detached) + a PURE forwarding tunnel ───────────────────
# Keep these SEPARATE. agentd used to run as the ssh remote command, so every
# dropped connection killed the daemon and the rail went quiet; `setsid` detaches it
# so it outlives any tunnel churn, and the tunnel becomes a plain `-L` forward that
# autossh can restart freely.
key=$(fish -c 'source ~/.config/fish/secrets.fish; echo -n $OPENAI_API_KEY')
# Slack's MCP oauth clientSecret lives in 1Password. The box has no `op` and no
# 1Password session, so resolve it HERE (your interactive session has one) and inject
# it as an env var; the box's mcp.json reads it with `!printenv SLACK_MCP_CLIENT_SECRET`,
# so the secret stays in agentd's process env and never lands on the box's disk.
slackSecret=$(op read 'op://Private/Slack MCP/text' 2>/dev/null || true)
[ -n "$slackSecret" ] || say "  (note: op could not resolve the Slack secret — run 'op signin' for slack mcp)"
# MCP OAuth persistence: pi-mcp-adapter keeps tokens in an OS credential store and
# FAILS CLOSED without one, so on a bare box every new pi session re-authenticates
# every server. A session dbus + unlocked gnome-keyring makes it auth once per BOX.
# The passphrase is passed inline (process env only, never written to the box); the
# keyring store on disk is encrypted with it.
# `dbus-launch` fails on this image (nix dbus has no /etc/dbus-1/session.conf) and
# `dbus-daemon --session` refuses a --config-file, so use ONLY --config-file.
krpw="${COCKPIT_KEYRING_PW:-${HEIDR_KEYRING_PW:-cockpit-lovbox}}"
say "ensure agentd (detached, with keyring) in-box …"
"$lb" exec "$box" -- bash -lc "
  export PATH=\$HOME/.local/bin:\$PATH
  # pgrep -x matches the process NAME: `pgrep -f 'agentd --scope work'` also matches
  # this very bash -lc wrapper (the pattern is in its command line), so the guard was
  # always true and agentd never actually started — the tunnel then forwarded to a dead
  # port, which is what produced the rail's ConnectionRefused spam.
  pgrep -x agentd >/dev/null 2>&1 && { echo '  already running'; exit 0; }
  if command -v dbus-daemon >/dev/null 2>&1 && command -v gnome-keyring-daemon >/dev/null 2>&1; then
    _cfg=\$(ls /nix/store/*dbus-1*/share/dbus-1/session.conf 2>/dev/null | head -1)
    [ -n \"\$_cfg\" ] && export DBUS_SESSION_BUS_ADDRESS=\$(dbus-daemon --config-file=\"\$_cfg\" --print-address --fork 2>/dev/null)
    mkdir -p ~/.local/share/keyrings
    eval \"\$(printf %s '$krpw' | gnome-keyring-daemon --unlock --components=secrets 2>/dev/null)\" || true
  fi
  setsid env OPENAI_API_KEY='$key' SLACK_MCP_CLIENT_SECRET='$slackSecret' ~/.local/bin/agentd --scope work --repo ~/lovable \
    --listen 127.0.0.1:$port >~/agentd.log 2>&1 </dev/null &
  sleep 3
  ss -tlnp 2>/dev/null | grep -q $port && echo '  listening' || tail -3 ~/agentd.log" 2>&1 \
  | grep -viE "^warning|Permanently" || true

say "tunnel: $sock → (box) agentd :$port …"
# Kill only stale ssh forwards for THIS socket (matching on the pattern alone also
# matches this script's own command line and killed the run).
# `|| true` matters: with pipefail, pgrep finding NOTHING fails the pipeline and
# set -e aborts — which is precisely the resume case (the old tunnel is already gone).
{ pgrep -f "$sock:localhost:$port" 2>/dev/null || true; } | while read -r pp; do
  c=$(cat "/proc/$pp/comm" 2>/dev/null || true)
  case "$c" in ssh|autossh) kill "$pp" 2>/dev/null || true ;; esac
done
rm -f "$sock"
tunnel_up=""
for attempt in 1 2 3 4; do
  if command -v autossh >/dev/null 2>&1; then
    AUTOSSH_GATETIME=0 autossh -M 0 -f -N \
      -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
      -L "$sock:localhost:$port" -p 2222 "$direct" 2>&1 | tail -1 || true
  else
    setsid ssh -N \
      -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -o ConnectTimeout=20 -o ExitOnForwardFailure=yes \
      -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
      -L "$sock:localhost:$port" -p 2222 "$direct" >/dev/null 2>&1 &
  fi
  for _ in $(seq 1 24); do [ -S "$sock" ] && break; sleep 0.5; done
  if [ -S "$sock" ]; then tunnel_up=1; break; fi
  say "  (tunnel attempt $attempt failed, retrying …)"
  sleep 3
done
[ -n "$tunnel_up" ] || { echo "✗ socket $sock never appeared after 4 attempts"; exit 1; }
say "socket up ✓  (rail will connect over the tunnel)"

# ── 5b. (opt-in) seed a root ~/lovable session ───────────────────────────────
# OFF by default. The target model is: orchestrator + reviewers run LOCALLY, and the
# box runs only the shared deps (from its entrypoint) plus per-ticket `devenv wt`
# sessions — so main-repo has no agent of its own. Set HEIDR_SEED_ROOT=1 to get one
# anyway (handy when driving the box without a local orchestrator).
if [ -n "${HEIDR_SEED_ROOT:-}" ]; then
say "seed root 'lovable' session (box ~/lovable) if absent …"
python3 - "$sock" <<'PY' 2>/dev/null || true
import socket,sys,json
sock=sys.argv[1]
s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.settimeout(6);s.connect(sock)
b=b""
while b"\n" not in b:
    d=s.recv(4096)
    if not d: break
    b+=d
names=[x.get("name") for x in json.loads(b.split(b"\n",1)[0]).get("sessions",[])]
if "lovable" not in names:
    s.sendall((json.dumps({"type":"spawn","session":"lovable","cwd":"/home/lovable/lovable"})+"\n").encode())
s.close()
PY
fi

# ── 5c. Mutagen sync: box ~/lovable ↔ local mirror ───────────────────────────
# nvim in the TermView stays LOCAL (your config, native speed) and edits a REAL
# local copy; mutagen keeps it in sync with the box both ways (~6s box→local).
# The rail's landNvim rewrites box paths → this mirror.
#
# SSHFS was tried first and is NOT viable here: git/LSP/telescope on a 21 GB
# monorepo over a network mount hangs nvim (every stat is a round-trip).
# Ignores matter: .devenv alone is 2.9 GB, node_modules is 61 dirs, and each
# side keeps its own .git — syncing only source is ~812 MB / 68k files.
mirror="$HOME/lovbox/cockpit/lovable"
say "mutagen sync: box ~/lovable ↔ $mirror …"
mkdir -p "$mirror"
mut=$(command -v mutagen || true)
[ -z "$mut" ] && mut="$(nix build --no-link --print-out-paths nixpkgs#mutagen 2>/dev/null)/bin/mutagen"
if [ -x "$mut" ]; then
  # mutagen's ssh is non-interactive: the pod host key must be in known_hosts.
  ssh-keyscan -p 2222 -H "${direct#*@}" 2>/dev/null >> "$HOME/.ssh/known_hosts" || true
  sync_name=cockpit-lovbox
  if "$mut" sync list "$sync_name" >/dev/null 2>&1; then
    say "  session exists — resuming"; "$mut" sync resume "$sync_name" >/dev/null 2>&1 || true
  else
    "$mut" sync create --name="$sync_name" --ignore-vcs \
      --ignore=.devenv --ignore=.direnv --ignore=node_modules --ignore=.next --ignore=.turbo \
      --ignore=target --ignore=dist --ignore=__pycache__ --ignore=.venv --ignore='bazel-*' --ignore='*.log' \
      --ignore=.wrangler --ignore='*.sqlite-shm' --ignore='*.sqlite-wal' \
      "${direct}:2222:lovable" "$mirror" >/dev/null 2>&1 \
      && say "  sync created (initial pass ~1-2 min for 812 MB)" \
      || say "  ✗ mutagen sync create failed (rail/agent still work)"
  fi
else
  say "  ✗ mutagen unavailable — skipping file sync (rail/agent still work)"
fi

# ── 6. launch local Cockpit pointed at the tunneled socket ───────────────────
# AgentdState.qml prefers COCKPIT_AGENTD_SOCK, so the rail talks to the in-box
# agentd as if local. Per-ticket previews: https://${box}--<port>.sandcastle.lovable.net
[ -n "${COCKPIT_LOVBOX_NO_LAUNCH:-${HEIDR_LOVBOX_NO_LAUNCH:-}}" ] && { say "NO_LAUNCH set — socket ready: COCKPIT_AGENTD_SOCK=$sock"; exit 0; }
cleanup() {
  [ -n "${mut:-}" ] && [ -n "${sync_name:-}" ] && "$mut" sync pause "$sync_name" >/dev/null 2>&1 || true
  { pgrep -f "$sock:localhost:$port" 2>/dev/null || true; } | while read -r pp; do
    c=$(cat "/proc/$pp/comm" 2>/dev/null || true)
    case "$c" in ssh|autossh) kill "$pp" 2>/dev/null || true ;; esac
  done
  rm -f "$sock"
}
trap cleanup EXIT INT TERM
say "launch cockpit-qs → COCKPIT_AGENTD_SOCK=$sock"
COCKPIT_AGENTD_SOCK="$sock" HEIDR_AGENTD_SOCK="$sock" cockpit-qs
