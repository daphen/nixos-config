#!/usr/bin/env bash
set -euo pipefail

exec 9>"${XDG_RUNTIME_DIR:?}/deck-gaming-mode.lock"
flock 9
umask 077
record="$XDG_RUNTIME_DIR/deck-gaming-mode.frozen"
return_target="$XDG_RUNTIME_DIR/deck-gaming-mode.return"
game='def game: .title != "Steam Input On-screen Keyboard" and ((.class // "" | ascii_downcase | test("^(steam|steam_app_[0-9]+)$")) or ((.tags // []) | index("deck-game") != null) or .workspace.name == "gaming");'
anr_dialog() {
    [[ $(hyprctl eval "hl.config({misc={enable_anr_dialog=$1}})") == ok ]]
}
thaw_work() {
    [[ -f "$record" ]] || return 0
    local unit failed=0 load
    while IFS= read -r unit; do
        case "$unit" in deck-work.slice|app-org.chromium.Chromium-*.scope) ;; *) failed=1; continue ;; esac
        load=$(systemctl --user show "$unit" -p LoadState --value) || { failed=1; continue; }
        [[ $load == not-found ]] && continue
        timeout 3s systemctl --user thaw "$unit" || failed=1
    done < "$record"
    if (( failed == 0 )); then
        if hyprctl -j getoption misc:enable_anr_dialog >/dev/null 2>&1; then
            anr_dialog true || failed=1
        fi
        if (( failed == 0 )); then rm -f -- "$record"; fi
    fi
    return "$failed"
}
freeze_unit() {
    local state
    state=$(systemctl --user show "$1" -p FreezerState --value) || return 1
    case "$state" in
        frozen|frozen-by-parent) return 0 ;;
        running) ;;
        *) return 1 ;;
    esac
    printf '%s\n' "$1" >> "$record"
    timeout 3s systemctl --user freeze "$1"
}
freeze_work() {
    local clients rows pid playing unit slice
    local -A browsers=() gaming=()
    clients=$(hyprctl -j clients) || return 1
    rows=$(jq -r "$game .[] | select(.pid > 0) | [.pid, game] | @tsv" <<< "$clients") || return 1
    while IFS=$'\t' read -r pid playing; do
        [[ -n $pid ]] || continue
        unit=$(systemctl --user whoami "$pid" 2>/dev/null) || continue
        if [[ $playing == true ]]; then
            gaming["$unit"]=1
            slice=$(systemctl --user show "$unit" -p Slice --value) || return 1
            [[ $slice != deck-work.slice ]] || return 1
        fi
        case "$unit" in app-org.chromium.Chromium-*.scope) browsers["$unit"]=1 ;; esac
    done <<< "$rows"
    touch "$record"
    anr_dialog false || return 1
    freeze_unit deck-work.slice || return 1
    for unit in "${!browsers[@]}"; do
        [[ ${gaming[$unit]:-} == 1 ]] && continue
        freeze_unit "$unit" || return 1
    done
}
profile() {
    local path
    path=$(readlink -f "/etc/inputplumber/profiles/hyprland-$1.yaml")
    if [[ $(inputplumber device 0 profile path) != "Current profile path: '$path'" ]]; then
        inputplumber device 0 profile load "$path"
    fi
}
dispatch() {
    local result
    result=$(hyprctl dispatch "$1") || { printf '%s\n' "$result" >&2; return 1; }
    [[ $result == ok ]]
}
focus_window() { dispatch "hl.dsp.focus({window=\"address:$1\"})"; }
tag_window() { dispatch "hl.dsp.window.tag({tag=\"$2\",window=\"address:$1\"})"; }
clear_mode() {
    local clients addresses address
    clients=$(hyprctl -j clients) || return 1
    addresses=$(jq -r '.[] | select((.tags // []) | index("deck-game-mode")) | .address' <<< "$clients") || return 1
    while IFS= read -r address; do
        [[ -z $address ]] || tag_window "$address" -deck-game-mode || return 1
    done <<< "$addresses"
}
park_floats() {
    local clients addresses address
    clients=$(hyprctl -j clients) || return 1
    addresses=$(jq -r --arg name "$(jq -r '.name' <<< "$workspace")" "$game . as \$all | .[] | select(.mapped and (.hidden | not) and .floating and (.pinned | not) and .workspace.name == \$name and (.class | ascii_downcase) != \"steam\" and (game | not)) | .pid as \$pid | select(any(\$all[]; .pid == \$pid and game) | not) | .address" <<< "$clients") || return 1
    [[ -f "$return_target" ]] || jq '{window:.address,workspace:.workspace.address,type:.workspace.type}' <<< "$active" > "$return_target"
    while IFS= read -r address; do
        [[ -n $address ]] || continue
        tag_window "$address" +deck-work-float || return 1
        dispatch "hl.dsp.window.move({workspace=\"special:deck-work-floats\",follow=false,window=\"address:$address\"})" || return 1
    done <<< "$addresses"
}
restore_floats() {
    local clients addresses address selector=$workspace_selector
    clients=$(hyprctl -j clients) || return 1
    addresses=$(jq -r '.[] | select((.tags // []) | index("deck-work-float")) | .address' <<< "$clients") || return 1
    if [[ -f "$return_target" ]]; then
        selector=$(jq -c 'if .type == "named" then "name:" + .workspace else .workspace end' "$return_target") || return 1
    fi
    while IFS= read -r address; do
        [[ -n $address ]] || continue
        dispatch "hl.dsp.window.move({workspace=$selector,follow=false,window=\"address:$address\"})" || return 1
        tag_window "$address" -deck-work-float || return 1
    done <<< "$addresses"
}
camera_active=0
finish_camera() {
    (( camera_active )) || return 0
    dispatch 'hl.dsp.layout("pan-end")' || return 1
    camera_active=0
}
trap 'finish_camera' EXIT
trap 'thaw_work; exit 1' HUP INT TERM
camera_out() {
    dispatch 'hl.dsp.layout("pan-begin")' || return 1
    camera_active=1
    dispatch 'hl.dsp.layout("pan-overview")' || return 1
    sleep 0.55
}
camera_to() {
    focus_window "$1" || return 1
    sleep 0.45
    finish_camera || return 1
    sleep 0.50
}
fullscreen_big_picture() {
    local active address
    active=$(hyprctl -j activewindow) || return 1
    address=$(jq -r 'select(.title == "Steam Big Picture Mode" and (.fullscreen != 0 or .fullscreenClient != 2)) | .address // empty' <<< "$active") || return 1
    [[ -z $address ]] || dispatch "hl.dsp.window.fullscreen_state({internal=0,client=2,window=\"address:$address\"})"
}
wait_big_picture() {
    local clients
    for (( attempt=0; attempt<600; attempt++ )); do
        clients=$(hyprctl -j clients) || return 1
        steam=$(jq -r '.[] | select((.class | ascii_downcase) == "steam" and .title == "Steam Big Picture Mode" and .mapped and (.hidden | not)) | .address' <<< "$clients" | head -n 1)
        [[ -z $steam ]] || return 0
        sleep 0.1
    done
    return 1
}
prepare_games() {
    local clients addresses address
    clients=$(hyprctl -j clients) || return 1
    addresses=$(jq -r "$game .[] | select(game and .mapped and (.hidden | not) and (.floating | not)) | .address" <<< "$clients") || return 1
    while IFS= read -r address; do
        [[ -n $address ]] || continue
        tag_window "$address" +deck-game || return 1
        dispatch "hl.dsp.window.fullscreen_state({internal=0,client=0,window=\"address:$address\"})" || return 1
        dispatch "hl.dsp.window.move({workspace=$workspace_selector,follow=false,window=\"address:$address\"})" || return 1
        dispatch "hl.dsp.window.fullscreen_state({internal=0,client=2,window=\"address:$address\"})" || return 1
    done <<< "$addresses"
}
desktop_target() {
    local clients address saved=""
    clients=$(hyprctl -j clients) || return 1
    if [[ -f "$return_target" ]]; then saved=$(jq -r '.window' "$return_target") || return 1; fi
    address=$(jq -r --arg saved "$saved" "$game [.[] | select(.mapped and (.hidden | not) and (.floating | not) and (game | not))] | sort_by(.focusHistoryID) | (map(select(.address == \$saved))[0] // .[0]) | .address // empty" <<< "$clients") || return 1
    [[ -n $address ]] || return 1
    printf '%s\n' "$address"
}
if [[ ${1:-} == cleanup ]]; then thaw_work; rm -f -- "$return_target"; exit; fi
workspace=$(hyprctl -j activeworkspace)
workspace_selector=$(jq -c 'if .type == "named" then "name:" + .address else .address end' <<< "$workspace")
active=$(hyprctl -j activewindow)
clients=$(hyprctl -j clients)
playing=0
if jq -e "$game game" <<< "$active" >/dev/null; then
    playing=1
elif [[ $(jq -r '.title' <<< "$active") == 'Steam Input On-screen Keyboard' ]] &&
    jq -e --arg name "$(jq -r '.name' <<< "$workspace")" 'any(.[]; .workspace.name == $name and ((.tags // []) | index("deck-game-mode")))' <<< "$clients" >/dev/null; then
    playing=1
fi
case ${1:-enter} in
    sync)
        if (( playing )); then
            pkill -USR1 -x wvkbd-mobintl || true
            if jq -e "$game game" <<< "$active" >/dev/null; then tag_window "$(jq -r '.address' <<< "$active")" +deck-game-mode; fi
            if ! profile gaming || ! freeze_work; then thaw_work; exit 1; fi
            fullscreen_big_picture
            park_floats
        else
            thaw_work
            clear_mode
            restore_floats
            rm -f -- "$return_target"
            if jq -e --arg name "$(jq -r '.name' <<< "$workspace")" 'any(.[]; .mapped and (.hidden | not) and (.pinned or .workspace.name == $name) and .title == "Steam Input On-screen Keyboard")' <<< "$clients" >/dev/null; then profile keyboard; else profile canvas; fi
        fi
        exit 0
        ;;
    tap)
        if (( playing )); then
            exec busctl call org.shadowblip.InputPlumber /org/shadowblip/InputPlumber/CompositeDevice0 org.shadowblip.Input.CompositeDevice SendButtonChord as 1 Gamepad:Button:Guide
        fi
        ;;
    return)
        if (( ! playing )); then thaw_work; exit; fi
        destination=$(desktop_target)
        thaw_work
        if ! profile canvas; then profile gaming; exit 1; fi
        if ! camera_out || ! camera_to "$destination"; then profile gaming; exit 1; fi
        clear_mode
        restore_floats
        focus_window "$destination"
        rm -f -- "$return_target"
        exit
        ;;
    enter) pkill -USR1 -x wvkbd-mobintl || true ;;
    *) echo 'Usage: deck-gaming-mode [enter|tap|return|sync|cleanup]' >&2; exit 2 ;;
esac
if (( playing )); then
    tag_window "$(jq -r '.address' <<< "$active")" +deck-game-mode
    if ! profile gaming || ! freeze_work; then thaw_work; exit 1; fi
    fullscreen_big_picture
    park_floats
    exit
fi
[[ $(jq -r '.tiledLayout' <<< "$workspace") == lua:canvas ]] || { echo 'Game Mode requires a canvas workspace.' >&2; exit 1; }
jq '{window:.address,workspace:.workspace.address,type:.workspace.type}' <<< "$active" > "$return_target"
destination=$(desktop_target)
if ! profile gaming; then profile canvas; rm -f -- "$return_target"; exit 1; fi
# Steam's lifetime must not hold the transition lock.
if dispatch "hl.dsp.exec_cmd(\"$HOME/.config/hypr/scripts/desktop-launch steam steam://open/bigpicture\")" && wait_big_picture && prepare_games && park_floats &&
    focus_window "$destination" && tag_window "$steam" +deck-game-mode && camera_out && camera_to "$steam" && freeze_work; then
    exit
fi
thaw_work || true
clear_mode || true
finish_camera || true
restore_floats || true
profile canvas
focus_window "$destination" || true
rm -f -- "$return_target"
echo 'Game Mode entry failed; attempted to resume work.' >&2
notify-send 'Game Mode' 'Could not pause work or open Steam; returning to work.' || true
exit 1
