#!/usr/bin/env bash
set -euo pipefail

scripts="${HYPR_SCRIPTS:-$HOME/.config/hypr/scripts}"
exec >>/tmp/hyprland-start-session-apps.log 2>&1

has_window() {
  local class=$1 title=$2
  hyprctl -j clients | jq -e --arg class "$class" --arg title "$title" '
    any(.[]; .class == $class and ($title == "" or ((.title // "") | test($title))))
  ' >/dev/null
}

start_and_wait() {
  local label=$1 class=$2 title=$3
  shift 3
  printf '[startup] starting %s\n' "$label"
  "$@" &
  for _ in $(seq 1 450); do
    if has_window "$class" "$title"; then
      printf '[startup] ready: %s\n' "$label"
      return 0
    fi
    sleep 0.2
  done
  printf '[startup] timed out waiting for %s\n' "$label" >&2
  return 1
}

start_and_wait "work browser" browser-work "" "$scripts/browser-work-new"
start_and_wait "work cockpit" org.quickshell '^cockpit-qs · .* · work$' "$scripts/cockpit-boot" work
start_and_wait "personal browser" browser-personal "" "$scripts/chromium-launch"
start_and_wait "private cockpit" org.quickshell '^cockpit-qs · .* · personal$' "$scripts/cockpit-boot" personal
start_and_wait "Discord" org.quickshell '^dsqrd$' "$scripts/jump-or-exec" title:dsqrd "$scripts/launch-discord-client"
start_and_wait "Slack" Slack "" "$scripts/jump-or-exec" Slack slack
start_and_wait "mail" org.quickshell '^mlqs$' "$scripts/jump-or-exec" --here title:mlqs "$scripts/launch-mail-client"
