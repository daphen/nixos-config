#!/usr/bin/env bash
set -euo pipefail

scripts="${HYPR_SCRIPTS:-$HOME/.config/hypr/scripts}"
exec >>/tmp/hyprland-start-session-apps.log 2>&1

exec 9>"${XDG_RUNTIME_DIR:?}/hyprland-start-session-apps.lock"
if ! flock -n 9; then
  printf '[startup] skipped concurrent run\n'
  exit 0
fi

marker="$XDG_RUNTIME_DIR/hyprland-start-session-apps.${HYPRLAND_INSTANCE_SIGNATURE:?}.started"
if ! (set -o noclobber; : >"$marker") 2>/dev/null; then
  printf '[startup] skipped repeated run\n'
  exit 0
fi

has_window() {
  local class=$1 title=$2
  hyprctl -j clients | jq -e --arg class "$class" --arg title "$title" '
    any(.[]; .class == $class and ($title == "" or ((.title // "") | test($title))))
  ' >/dev/null
}

start_and_wait() {
  local label=$1 class=$2 title=$3
  shift 3
  printf '[startup] starting %s\n' "$label"
  "$@" &
  for _ in $(seq 1 450); do
    if has_window "$class" "$title"; then
      printf '[startup] ready: %s\n' "$label"
      return 0
    fi
    sleep 0.2
  done
  printf '[startup] timed out waiting for %s\n' "$label" >&2
  return 1
}

start_and_wait "work cockpit" org.quickshell '^cockpit-qs · .* · work$' "$scripts/cockpit-boot" work
start_and_wait "personal cockpit" org.quickshell '^cockpit-qs · .* · personal$' "$scripts/cockpit-boot" personal
