#!/usr/bin/env bash
# focus-kitty-cycle — cycle focus through every kitty window (plain kitty +
# the cockpit's cockpit-agent/-nvim/-devenv). If a kitty is already focused,
# advance to the next in stable id order (wrap); else jump to the lowest-id
# one. Deterministic walk, not most-recent bounce.
set -euo pipefail

  active=$(hyprctl -j activewindow | jq -r '.address // empty')
  target=$(hyprctl -j clients | ACTIVE="$active" python3 -c '
import json, os, sys
ws = json.load(sys.stdin)
def is_kitty(w):
    c = w.get("class") or ""
    return c == "kitty" or c.startswith("cockpit-")
kitties = sorted((w for w in ws if is_kitty(w)), key=lambda w: w.get("address", ""))
if not kitties: raise SystemExit
ids = [w.get("address") for w in kitties]
active = os.environ.get("ACTIVE")
print(ids[(ids.index(active) + 1) % len(ids)] if active in ids else ids[0])
')
  [ -n "$target" ] && exec "$(dirname -- "$0")/hypr-dispatch" focuswindow "address:$target"
  exit 0
