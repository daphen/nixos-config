#!/usr/bin/env bash
# Manage the permanent quick-todo list. Mutation lives here (not in QML); the
# QS TodoListPicker reads the file directly and calls this to add/toggle.
# Toggle is by 1-based line number (the picker tracks it).
#
# Stored in ~/.local/state (NOT the synced notes vault): a `notes-cli -pull`
# overwrites local vault files with the backend copy, which silently reverted
# this list. Keeping it outside the vault means a pull can never touch it.
set -euo pipefail

F="$HOME/.local/state/quickshell/todos.md"

ensure() {
  [ -f "$F" ] && return
  printf '%s\n' '---' 'type: todos' 'tags: [todos]' '---' '' '# Quick todos' '' >"$F"
}

cmd="${1:-}"
case "$cmd" in
  add)
    ensure
    shift
    text="$*"
    [ -n "$text" ] || exit 0
    printf -- '- [ ] %s\n' "$text" >>"$F"
    ;;
  toggle)
    n="${2:-0}"
    [ "$n" -gt 0 ] 2>/dev/null || exit 0
    # Checking an item stamps a completion time (used by `prune`); unchecking
    # strips it.
    awk -v n="$n" -v now="$(date +%s)" 'NR==n {
        if ($0 ~ /- \[ \]/) {
            sub(/- \[ \]/, "- [x]")
            if ($0 !~ /<!-- done:[0-9]+ -->/) $0 = $0 " <!-- done:" now " -->"
        } else if ($0 ~ /- \[x\]/) {
            sub(/- \[x\]/, "- [ ]")
            sub(/[[:space:]]*<!-- done:[0-9]+ -->[[:space:]]*$/, "")
        }
      } { print }' "$F" >"$F.tmp" && mv "$F.tmp" "$F"
    ;;
  remove)
    n="${2:-0}"
    [ "$n" -gt 0 ] 2>/dev/null || exit 0
    sed "${n}d" "$F" >"$F.tmp" && mv "$F.tmp" "$F"
    ;;
  prune)
    # Drop checked items completed > 24h ago. Checked items with no stamp
    # (e.g. checked by hand in nvim) get stamped now, so they age from here.
    [ -f "$F" ] || exit 0
    awk -v cutoff="$(($(date +%s) - 86400))" -v now="$(date +%s)" '
        /^[[:space:]]*- \[[xX]\]/ {
            if (match($0, /<!-- done:[0-9]+ -->/)) {
                ts = substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", ts)
                if (ts + 0 < cutoff) next
            } else {
                $0 = $0 " <!-- done:" now " -->"
            }
        }
        { print }
      ' "$F" >"$F.tmp" && mv "$F.tmp" "$F"
    ;;
  *)
    echo "usage: todos add <text> | toggle <line> | remove <line> | prune" >&2
    exit 1
    ;;
esac
