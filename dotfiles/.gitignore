# Fish shell
fish/.config/fish/fish_variables
fish/.config/fish/fish_variables*
fish/.config/fish/fish_history
fish/.config/fish/secrets.fish
fish/.config/fish/conf.d/fish_debug.log

# Python bytecode caches (auto-generated, never committed)
__pycache__/
*.pyc

# Tmux plugins (managed by TPM)
tmux/.config/tmux/plugins/

# Themes - generated output directory
themes/.config/themes/generated/
themes/.config/themes/*.log
themes/.config/themes/.current-theme
themes/.config/themes/theme-viewer/
themes/.config/themes/node_modules/

# Theme-manager generated output files (recreated by: theme-manager.sh switch dark)
kitty/.config/kitty/theme.conf
waybar/.config/waybar/style.css
waybar/.config/waybar/themes/*/style.css
mako/.config/mako/config
qutebrowser/.config/qutebrowser/theme.py
qutebrowser/.config/qutebrowser/userstyles.css
wezterm/.config/wezterm/colors/
eww/.config/eww/eww.scss
eww/.config/eww/assets/
clipse/.config/clipse/custom_theme.json
fish/.config/fish/conf.d/z_custom_theme_colors.fish
nvim/.config/nvim/colors/custom-theme-dark.lua
nvim/.config/nvim/colors/custom-theme-light.lua
opencode/.config/opencode/themes/customtheme.json
rofi/.config/rofi/theme.rasi
spotify-player/.config/spotify-player/theme.toml
swaylock/.config/swaylock/config
# starship.toml is generated output: home-manager activation regenerates it
# and dev-env builds its own from templates, so tracking it only produced
# churn on every theme toggle. Ignored like the other generated theme files.
starship/.config/starship/starship.toml

# Temporary files
*.swp
*.tmp
*.bak
*~
.DS_Store

# Private/sensitive files
*.key
*.pem
secrets/
opencode/.config/opencode/opencode.json

# Claude Code lives at ~/.claude (relocated into the repo) but is local
# runtime/config — transcripts, credentials, settings, plugins, caches.
# This is a PUBLIC repo, so ignore everything under it; only the custom
# prompt themes are tracked (dev-env ships them to sandboxes).
claude/.claude/*
!claude/.claude/themes/
# Personal skills travel to sandboxes via #dev-env (see pkgs/daphen-env).
# Workflow instructions only — no credentials. PUBLIC, so keep it that way.
!claude/.claude/skills/

# Per-project Claude Code state written into other tools' config dirs
qutebrowser/.config/qutebrowser/.claude/

# JS/TS deps inside ai-tracker channel
nvim/.config/nvim/lua/ai-tracker/channel/node_modules/
